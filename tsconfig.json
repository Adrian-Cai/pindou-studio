{
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": ["ES2020"],
    "types": ["miniprogram-api-typings"],
    "skipLibCheck": true
  },
  "include": ["miniprogram/**/*.ts"]
}
