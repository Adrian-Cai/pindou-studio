.tab-bar {
  position: fixed;
  z-index: 100;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  box-sizing: content-box;
  height: 128rpx;
  padding-bottom: env(safe-area-inset-bottom);
  border-top: 1rpx solid #e9eaf0;
  background: #ffffff;
}

.tab-bar__item {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #9699a8;
  font-size: 24rpx;
  font-weight: 400;
  line-height: 36rpx;
}

.tab-bar__item--active {
  color: #6c4cf6;
  font-weight: 500;
}

.tab-bar__symbol {
  width: 44rpx;
  height: 44rpx;
  margin-bottom: 8rpx;
}