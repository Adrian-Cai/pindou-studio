.tab-bar {
  position: fixed;
  z-index: 100;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  box-sizing: content-box;
  height: 104rpx;
  padding-bottom: env(safe-area-inset-bottom);
  border-top: 1rpx solid #eeeeee;
  background: #ffffff;
}

.tab-bar__item {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #8a908c;
  font-size: 20rpx;
  font-weight: 400;
  line-height: 28rpx;
}

.tab-bar__item--active {
  color: #12b466;
  font-weight: 500;
}

.tab-bar__symbol {
  width: 40rpx;
  height: 40rpx;
  margin-bottom: 2rpx;
}