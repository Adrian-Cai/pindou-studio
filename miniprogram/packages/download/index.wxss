@import "../../styles/profile-pages.wxss";

.download-summary { display: flex; padding: 32rpx 20rpx; }
.download-summary__item { display: flex; min-width: 0; flex: 1; align-items: center; justify-content: center; gap: 16rpx; color: var(--color-text-secondary); font-size: 22rpx; }
.download-summary__item text { display: block; margin-top: 4rpx; color: var(--color-text); font-size: 34rpx; font-weight: 600; }
.download-summary__item .download-summary__text { font-size: 28rpx; }
.download-summary__icon { width: 44rpx; height: 44rpx; flex-shrink: 0; }
.download-summary__line { width: 1rpx; height: 76rpx; align-self: center; background: var(--color-border); }
.download-tabs { margin-top: 24rpx; }

.download-list { display: grid; gap: 20rpx; }
.download-card { display: flex; min-width: 0; align-items: center; padding: 24rpx; }
.download-card__cover { width: 168rpx; height: 168rpx; flex-shrink: 0; border-radius: var(--radius-media); background: var(--color-surface-muted); }
.download-card__content { min-width: 0; flex: 1; margin-left: 28rpx; }
.download-card__title { overflow: hidden; font-size: 30rpx; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
.download-type { display: inline-flex; margin-top: 12rpx; padding: 6rpx 14rpx; border-radius: 10rpx; background: var(--color-primary-soft); color: var(--color-primary); font-size: 22rpx; }
.download-type--chart { background: var(--color-info-soft); color: var(--color-info); }
.download-type--materials { background: var(--color-warning-soft); color: var(--color-warning); }
.download-type--palette { background: var(--color-purple-soft); color: var(--color-purple); }
.download-card__meta, .download-card__date { margin-top: 12rpx; color: var(--color-text-secondary); font-size: 23rpx; }
.download-card__date { color: var(--color-text-tertiary); }
.download-card__side { display: flex; align-self: stretch; flex-direction: column; align-items: flex-end; justify-content: space-between; margin-left: 20rpx; }
.download-card__again { display: flex; min-width: 168rpx; height: 88rpx; align-items: center; justify-content: center; gap: 8rpx; padding: 0 20rpx; border: 0; border-radius: var(--radius-card-small); background: transparent; box-shadow: var(--shadow-ghost); color: var(--color-primary); font-size: 24rpx; transition: var(--transition-press); }
.download-card__again image { width: 28rpx; height: 28rpx; }
.download-card__again:active { background: var(--strong-overlay); transform: scale(0.97); }
.empty-state__icon { display: block; width: 72rpx; height: 72rpx; margin: 0 auto 20rpx; }
.download-retention { display: flex; align-items: center; justify-content: center; gap: 8rpx; padding: 20rpx 0 8rpx; color: var(--color-text-tertiary); font-size: 22rpx; text-align: center; }
.download-retention image { width: 28rpx; height: 28rpx; }

@media (max-width: 380px) {
  .download-summary__icon { display: none; }
  .download-card__cover { width: 140rpx; height: 140rpx; }
  .download-card__content { margin-left: 20rpx; }
  .download-card__side { margin-left: 12rpx; }
  .download-card__again { min-width: 104rpx; padding: 0 12rpx; font-size: 20rpx; }
  .download-card__again image { width: 26rpx; height: 26rpx; }
}
