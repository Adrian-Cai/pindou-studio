@import "../../../styles/profile-pages.wxss";

.recharge-page { max-width: 720rpx; margin: 0 auto; padding-top: 20rpx; }

.recharge-summary { padding: 28rpx; border-radius: var(--radius-card-large); background: var(--color-surface-muted); box-shadow: none; }
.recharge-summary__columns { display: flex; align-items: center; }
.recharge-summary__primary { min-width: 0; flex: 1; }
.recharge-summary__secondary { box-sizing: border-box; min-width: 210rpx; padding-left: 28rpx; border-left: 1rpx solid var(--color-border); }
.recharge-summary__label { display: block; color: var(--color-text-tertiary); font-size: 24rpx; line-height: 34rpx; }
.recharge-summary__total { display: flex; align-items: baseline; gap: 8rpx; margin-top: 4rpx; }
.recharge-summary__total-number { color: var(--color-primary); font-family: var(--font-heading); font-size: 72rpx; font-weight: 650; letter-spacing: -2rpx; line-height: 80rpx; }
.recharge-summary__total-unit { color: var(--color-primary); font-size: 30rpx; font-weight: 600; }
.recharge-summary__meta-label { color: var(--color-text-tertiary); font-size: 23rpx; line-height: 32rpx; }
.recharge-summary__meta-value { display: flex; align-items: baseline; gap: 6rpx; color: var(--color-text-secondary); font-size: 25rpx; line-height: 34rpx; }
.recharge-summary__meta-number { color: var(--color-primary); font-family: var(--font-heading); font-size: 34rpx; font-weight: 600; line-height: 38rpx; }
.recharge-summary__meta-slash { color: var(--color-text-tertiary); }

.recharge-options { display: grid; gap: 16rpx; margin-top: 28rpx; }
.recharge-options__message { padding: 32rpx 0; color: var(--color-text-secondary); font-size: 26rpx; line-height: 36rpx; text-align: center; }
.recharge-option { display: flex; min-height: 120rpx; align-items: center; padding: 20rpx 24rpx; border-radius: var(--radius-card-large); background: var(--color-surface); box-shadow: var(--shadow-card); transition: var(--transition-press); }
.recharge-option--active { background: var(--color-primary-surface); box-shadow: 0 0 0 2rpx var(--color-primary), var(--shadow-card); }
.recharge-option:active { background: var(--strong-overlay); transform: scale(0.98); }
.recharge-option__icon-wrap { display: flex; width: 80rpx; height: 80rpx; flex-shrink: 0; align-items: center; justify-content: center; border-radius: 40rpx; background: var(--color-primary-soft); }
.recharge-option__icon { width: 46rpx; height: 46rpx; }
.recharge-option__content { min-width: 0; flex: 1; margin-left: 20rpx; }
.recharge-option__title-row { display: flex; min-width: 0; align-items: center; gap: 8rpx; }
.recharge-option__label { overflow: hidden; color: var(--color-text); font-size: 28rpx; font-weight: 600; line-height: 38rpx; text-overflow: ellipsis; white-space: nowrap; }
.recharge-option__tag { flex-shrink: 0; padding: 2rpx 10rpx; border-radius: var(--radius-full); background: var(--color-primary-soft); color: var(--color-primary); font-size: 20rpx; line-height: 28rpx; }
.recharge-option__desc { display: block; margin-top: 4rpx; overflow: hidden; color: var(--color-text-tertiary); font-size: 23rpx; line-height: 32rpx; text-overflow: ellipsis; white-space: nowrap; }
.recharge-option__price { display: flex; min-width: 86rpx; flex-shrink: 0; align-items: baseline; justify-content: flex-end; gap: 4rpx; color: var(--color-text); font-family: var(--font-heading); font-size: 34rpx; font-weight: 650; line-height: 40rpx; }
.recharge-option__currency { font-size: 24rpx; font-weight: 600; }
.recharge-option--active .recharge-option__price { color: var(--color-primary); }
.recharge-option__check { display: flex; width: 40rpx; height: 40rpx; flex-shrink: 0; align-items: center; justify-content: center; margin-left: 16rpx; border: 2rpx solid var(--color-disabled); border-radius: 50%; background: var(--color-surface); }
.recharge-option__check image { width: 24rpx; height: 24rpx; }
.recharge-option--active .recharge-option__check { border: 0; background: var(--color-primary); }

.payment-method { display: flex; height: 96rpx; align-items: center; justify-content: space-between; margin-top: 28rpx; padding: 0 24rpx; border-radius: var(--radius-card-large); background: var(--color-surface); box-shadow: var(--shadow-card); font-size: 27rpx; }
.payment-method__label { color: var(--color-text); font-weight: 600; }
.payment-method__value { display: flex; align-items: center; gap: 12rpx; color: var(--color-text-secondary); }
.payment-method__value image { width: 34rpx; height: 34rpx; }
.payment-method__value .payment-method__arrow { width: 28rpx; height: 28rpx; margin-left: 2rpx; }

.recharge-button { width: 100%; margin: 28rpx 0 0; }
.recharge-button__price { margin-left: 10rpx; font-family: var(--font-heading); font-size: 32rpx; font-weight: 650; }
.recharge-notes { margin-top: 12rpx; color: var(--color-text-tertiary); font-size: 22rpx; line-height: 32rpx; text-align: center; }
.recharge-notes__agreement { min-height: 48rpx; line-height: 48rpx; transition: var(--transition-press); }
.recharge-notes__agreement--pressed { opacity: 0.72; transform: scale(0.98); }
.recharge-notes__link { color: var(--color-text-secondary); text-decoration: underline; text-underline-offset: 4rpx; }
.recharge-notes__agreement--pressed .recharge-notes__link { color: var(--color-primary); }

.recharge-hint { display: flex; align-items: center; gap: 16rpx; margin-top: 24rpx; padding: 20rpx; border-radius: var(--radius-card-large); background: var(--color-surface); box-shadow: var(--shadow-card); }
.recharge-hint__copy { display: flex; min-width: 0; flex: 1; align-items: flex-start; gap: 12rpx; color: var(--color-text-secondary); font-size: 22rpx; line-height: 32rpx; }
.recharge-hint__icon { width: 30rpx; height: 30rpx; flex-shrink: 0; margin-top: 2rpx; opacity: 0.72; }
.recharge-hint__contact { display: flex; height: 64rpx; min-width: 156rpx; flex-shrink: 0; align-items: center; justify-content: center; gap: 8rpx; padding: 0 18rpx; border: 1rpx solid var(--color-primary); border-radius: var(--radius-full); background: transparent; color: var(--color-primary); font-size: 23rpx; font-weight: 600; line-height: 64rpx; transition: var(--transition-press); }
.recharge-hint__contact::after { border: 0; }
.recharge-hint__contact image { width: 30rpx; height: 30rpx; }
.recharge-hint__contact--pressed { background: var(--color-primary-soft); transform: scale(0.97); }

@media (max-width: 340px) {
  .recharge-summary__secondary { min-width: 190rpx; padding-left: 20rpx; }
  .recharge-option { padding-right: 16rpx; padding-left: 16rpx; }
  .recharge-option__icon-wrap { width: 72rpx; height: 72rpx; }
  .recharge-option__content { margin-left: 14rpx; }
  .recharge-option__label { font-size: 26rpx; }
  .recharge-option__price { min-width: 76rpx; font-size: 30rpx; }
  .recharge-option__check { margin-left: 10rpx; }
  .recharge-hint { align-items: flex-start; flex-direction: column; }
  .recharge-hint__contact { align-self: flex-end; }
}
