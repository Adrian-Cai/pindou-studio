<page-layout title="我的订单" back showMainNav selectedTab="2">
  <view class="subpage orders-page">
    <view wx:if="{{loadState === 'loading'}}" class="orders-message">
      <view class="orders-message__title">正在加载订单</view>
      <view class="orders-message__description">请稍候</view>
    </view>

    <view wx:elif="{{loadState === 'unauthorized'}}" class="orders-message">
      <view class="orders-message__title">请先登录</view>
      <view class="orders-message__description">登录后才能查看支付记录和订单状态</view>
      <button class="button-primary orders-message__button" bindtap="openProfile">去登录</button>
    </view>

    <view wx:elif="{{loadState === 'error'}}" class="orders-message">
      <view class="orders-message__title">订单加载失败</view>
      <view class="orders-message__description">{{errorMessage}}</view>
      <button class="button-secondary orders-message__button" bindtap="retry">重新加载</button>
    </view>

    <block wx:else>
      <view class="orders-tabs">
        <view class="orders-tabs__item {{activeTab === 'all' ? 'orders-tabs__item--active' : ''}}" data-tab="all" bindtap="switchTab">全部</view>
        <view class="orders-tabs__item {{activeTab === 'pending' ? 'orders-tabs__item--active' : ''}}" data-tab="pending" bindtap="switchTab">待支付</view>
        <view class="orders-tabs__item {{activeTab === 'paid' ? 'orders-tabs__item--active' : ''}}" data-tab="paid" bindtap="switchTab">已支付</view>
        <view class="orders-tabs__item {{activeTab === 'closed' ? 'orders-tabs__item--active' : ''}}" data-tab="closed" bindtap="switchTab">已关闭</view>
      </view>

      <view wx:if="{{activeTab === 'pending' && pendingCount > 0}}" class="orders-quota">
        <image class="orders-quota__icon" src="/assets/icons/payment/clock-brand.svg" mode="aspectFit" aria-hidden="true" />
        <view class="orders-quota__text">
          <view class="orders-quota__title">
            <text>待支付订单 </text><text class="orders-quota__count">{{pendingCount}}</text><text class="orders-quota__limit"> / 最多 5 个</text>
          </view>
          <view class="orders-quota__desc">订单需在 5 分钟内完成支付，超时后自动关闭</view>
        </view>
      </view>

      <view wx:if="{{orders.length}}" class="orders-list">
        <view class="order-card ui-card" wx:for="{{orders}}" wx:key="id">
          <view class="order-card__header">
            <view class="order-card__label">{{item.packageLabel}}</view>
            <view class="order-card__tags">
              <view class="status-pill order-status {{item.statusClass}}">{{item.statusLabel}}</view>
              <view wx:if="{{item.countdownText}}" class="order-card__countdown">
                <image class="order-card__countdown-icon" src="/assets/icons/payment/clock-warning.svg" mode="aspectFit" aria-hidden="true" />
                <text>剩余 {{item.countdownText}}</text>
              </view>
            </view>
          </view>

          <view class="order-card__amount">{{item.amountText}}</view>

          <view class="order-card__details">
            <view class="order-card__detail">
              <text class="order-card__detail-label">下单时间</text>
              <text class="order-card__detail-value">{{item.createdAtText}}</text>
            </view>
            <view wx:if="{{item.paidAtText}}" class="order-card__detail">
              <text class="order-card__detail-label">支付时间</text>
              <text class="order-card__detail-value">{{item.paidAtText}}</text>
            </view>
            <view class="order-card__detail">
              <text class="order-card__detail-label">订单号</text>
              <text class="order-card__detail-value">{{item.orderSuffix}}</text>
            </view>
          </view>

          <view wx:if="{{item.isConfirming}}" class="order-card__confirming" bindtap="refreshOrders">
            支付状态确认中，请稍后刷新
          </view>

          <view wx:if="{{item.canPay}}" class="order-card__actions">
            <button class="order-card__action order-card__action--secondary" data-id="{{item.id}}" bindtap="cancelOrder">取消订单</button>
            <button class="order-card__action order-card__action--primary" data-id="{{item.id}}" bindtap="continuePayment">继续支付</button>
          </view>
          <view wx:elif="{{item.canRepurchase}}" class="order-card__actions order-card__actions--single">
            <button class="order-card__action order-card__action--secondary" data-id="{{item.id}}" bindtap="repurchase">重新购买</button>
          </view>
        </view>
      </view>

      <view wx:else class="empty-state orders-empty">
        <image class="orders-empty__icon" src="/assets/icons/bead-stack.svg" mode="aspectFit" aria-hidden="true" />
        <view class="empty-state__title">{{emptyTitle}}</view>
        <view class="empty-state__desc">{{emptyDesc}}</view>
      </view>
    </block>
  </view>
</page-layout>
