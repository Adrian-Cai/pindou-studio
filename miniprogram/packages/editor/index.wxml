<view class="editor {{aiLocked && !aiFailed ? 'editor--loading' : ''}}">
  <top-bar title="编辑拼豆图" back back-inset-rpx="{{32}}" />

  <view
    wx:if="{{aiLocked && !aiFailed}}"
    class="ai-loading-layout"
    role="status"
    aria-label="{{aiStateTitle || 'AI 正在生成拼豆图'}}，{{aiStateDescription || '预计还需几分钟，请稍候'}}"
  >
    <generating-preview-card
      title="{{aiStateTitle || 'AI 正在生成拼豆图'}}"
      subtitle="{{aiWaitingLong ? '处理时间比平时长一些，请稍候' : (aiStateDescription || '预计还需几分钟，请稍候')}}"
      progress="{{aiProgress || 60}}"
      tipText="正在为你优化图片细节，生成完成后即可开始编辑"
    />
  </view>

  <view wx:elif="{{draft}}" class="editor__body">
    <view class="editor__content">

      <!-- ── 工作区：接收所有手势 ── -->
      <view
        class="workspace"
        bindtouchstart="onWorkspaceTouchStart"
        bindtouchend="onWorkspaceTouchEnd"
        bindtouchcancel="onWorkspaceTouchCancel"
        catchtouchmove="onWorkspaceTouchMove"
      >
        <view class="canvas-stage {{canvasReady ? 'canvas-stage--ready' : ''}}">
          <canvas
            wx:if="{{!aiLocked}}"
            id="patternCanvas"
            class="pattern-canvas"
            type="2d"
          ></canvas>
        </view>

        <view
          wx:if="{{!canvasReady && !aiLocked && !aiFailed}}"
          class="canvas-loading-state"
          role="status"
          aria-label="正在准备图纸，请稍候"
          catchtouchstart="stopWorkspaceTouch"
          catchtouchmove="stopWorkspaceTouch"
          catchtouchend="stopWorkspaceTouch"
        >
          <view class="canvas-loading-state__spinner" aria-hidden="true"></view>
          <text class="canvas-loading-state__title">正在准备图纸</text>
          <text class="canvas-loading-state__description">马上就好，可以开始编辑</text>
        </view>

        <view
          wx:if="{{aiFailed}}"
          class="ai-editor-state ai-editor-state--failed"
          role="alert"
          catchtouchstart="stopWorkspaceTouch"
          catchtouchmove="stopWorkspaceTouch"
          catchtouchend="stopWorkspaceTouch"
        >
          <view class="ai-editor-state__error-icon">!</view>
          <text class="ai-editor-state__title">{{aiStateTitle}}</text>
          <text class="ai-editor-state__description">{{aiStateDescription}}</text>
          <button
            wx:if="{{aiShowPurchase}}"
            class="button-primary ai-editor-state__button"
            bindtap="purchaseAiGeneration"
          >购买 AI 生成次数</button>
          <button
            wx:elif="{{aiAction === 'USE_STANDARD_MODE'}}"
            class="button-primary ai-editor-state__button"
            bindtap="useStandardMode"
          >使用标准模式</button>
          <button
            wx:elif="{{aiAction === 'SELECT_IMAGE'}}"
            class="button-primary ai-editor-state__button"
            bindtap="selectNewImage"
          >重新选择图片</button>
          <button
            wx:elif="{{aiRetryable}}"
            class="button-primary ai-editor-state__button"
            bindtap="retryAiGeneration"
          >{{aiRetryMode === 'generation' ? '重新生成' : aiRetryMode === 'query' ? '重新查询' : '重试'}}</button>
        </view>
      </view>

      <!-- ── 缩放控制 ── -->
      <view class="zoom-control">
        <button
          class="zoom-control__button"
          bindtap="zoomOut"
          disabled="{{scale <= 1 || aiLocked || !canvasReady}}"
          aria-label="缩小"
        ><image src="/assets/icons/iconsax/minus.svg" mode="aspectFit" /></button>
        <text class="zoom-control__value">{{scalePercent}}%</text>
        <button
          class="zoom-control__button"
          bindtap="zoomIn"
          disabled="{{scale >= 3 || aiLocked || !canvasReady}}"
          aria-label="放大"
        ><image src="/assets/icons/iconsax/add.svg" mode="aspectFit" /></button>
      </view>

      <!-- ── 信息卡 ── -->
      <view class="info-card">
        <view class="info-card__row">
          <text>尺寸：{{draft.settings.width}}×{{draft.settings.height}}</text>
          <text>颜色：{{draft.settings.colorLimit}}色</text>
          <text>共 {{beadCount}} 颗</text>
        </view>
      </view>

      <!-- ── 工具栏 ── -->
      <view class="tools">
        <view
          wx:for="{{tools}}"
          wx:key="id"
          class="tool {{item.disabled || !canvasReady ? 'tool--disabled' : ''}} {{activeTool === item.id ? 'tool--active' : ''}}"
          data-tool="{{item.id}}"
          data-disabled="{{item.disabled || !canvasReady}}"
          bindtap="selectTool"
        >
          <image
            class="tool__icon"
            src="{{activeTool === item.id ? item.activeIcon : item.icon}}"
            mode="aspectFit"
          />
          <text class="tool__label">{{item.label}}</text>
        </view>
      </view>

      <!-- ── 调色板 ── -->
      <view class="palette">
        <view wx:for="{{paletteColors}}" wx:key="*this" class="palette__slot">
          <button
            class="palette__color {{selectedColor === item ? 'palette__color--selected' : ''}} {{aiLocked || !canvasReady ? 'palette__color--disabled' : ''}}"
            style="background-color: {{item}};"
            data-color="{{item}}"
            bindtap="selectPaletteColor"
            disabled="{{aiLocked || !canvasReady}}"
            aria-label="选择颜色 {{item}}"
          >
            <image wx:if="{{selectedColor === item}}" class="palette__check" src="/assets/icons/iconsax/check.svg" mode="aspectFit" />
          </button>
        </view>
      </view>

      <!-- ── 底部操作 ── -->
      <view class="editor-actions">
        <button class="button-secondary editor-actions__button" bindtap="regenerate">重新生成</button>
        <button class="button-primary editor-actions__button" bindtap="saveAndView" loading="{{saving}}" disabled="{{saving || aiLocked || !canvasReady}}">{{saving ? '保存中' : '保存作品'}}</button>
      </view>

    </view>
  </view>

  <canvas
    wx:if="{{draft}}"
    id="exportPatternCanvas"
    class="export-pattern-canvas"
    type="2d"
    style="width: {{draft.settings.width >= draft.settings.height ? 640 : 640 * draft.settings.width / draft.settings.height}}px; height: {{draft.settings.height >= draft.settings.width ? 640 : 640 * draft.settings.height / draft.settings.width}}px;"
  ></canvas>

  <!-- 取色成功 Toast -->
  <view class="editor-toast {{toast.visible ? 'editor-toast--visible' : ''}}">{{toast.message}}</view>
</view>
