<view class="editor">
  <top-bar title="编辑拼豆图" back back-inset-rpx="{{32}}" />

  <view wx:if="{{draft}}" class="editor__body">
    <view class="editor__content">

      <!-- ── 工作区：接收所有手势 ── -->
      <view
        class="workspace"
        bindtouchstart="onWorkspaceTouchStart"
        bindtouchend="onWorkspaceTouchEnd"
        bindtouchcancel="onWorkspaceTouchCancel"
        catchtouchmove="onWorkspaceTouchMove"
      >
        <view class="canvas-stage {{canvasReady ? 'canvas-stage--ready' : ''}}">
          <canvas
            id="patternCanvas"
            class="pattern-canvas"
            type="2d"
          ></canvas>
        </view>

        <view
          wx:if="{{!canvasReady}}"
          class="canvas-loading-state"
          role="status"
          aria-label="正在准备图纸，请稍候"
          catchtouchstart="stopWorkspaceTouch"
          catchtouchmove="stopWorkspaceTouch"
          catchtouchend="stopWorkspaceTouch"
        >
          <view class="canvas-loading-state__spinner" aria-hidden="true"></view>
          <text class="canvas-loading-state__title">正在准备图纸</text>
          <text class="canvas-loading-state__description">马上就好，可以开始编辑</text>
        </view>

      </view>

      <!-- ── 缩放控制 ── -->
      <view class="zoom-control">
        <button
          class="zoom-control__button"
          bindtap="zoomOut"
          disabled="{{scale <= 1 || !canvasReady}}"
          aria-label="缩小"
        ><image src="/assets/icons/iconsax/minus.svg" mode="aspectFit" /></button>
        <text class="zoom-control__value">{{scalePercent}}%</text>
        <button
          class="zoom-control__button"
          bindtap="zoomIn"
          disabled="{{scale >= 3 || !canvasReady}}"
          aria-label="放大"
        ><image src="/assets/icons/iconsax/add.svg" mode="aspectFit" /></button>
      </view>

      <!-- ── 信息卡 ── -->
      <view class="info-card">
        <view class="info-card__row">
          <text>尺寸：{{draft.settings.width}}×{{draft.settings.height}}</text>
          <text>颜色：{{draft.settings.colorLimit}}色</text>
          <text>共 {{beadCount}} 颗</text>
        </view>
      </view>

      <!-- ── 工具栏 ── -->
      <view class="tools">
        <view
          wx:for="{{tools}}"
          wx:key="id"
          class="tool {{item.disabled || !canvasReady ? 'tool--disabled' : ''}} {{activeTool === item.id ? 'tool--active' : ''}}"
          data-tool="{{item.id}}"
          data-disabled="{{item.disabled || !canvasReady}}"
          bindtap="selectTool"
        >
          <image
            class="tool__icon"
            src="{{activeTool === item.id ? item.activeIcon : item.icon}}"
            mode="aspectFit"
          />
          <text class="tool__label">{{item.label}}</text>
        </view>
      </view>

      <!-- ── 调色板 ── -->
      <view class="palette">
        <view wx:for="{{paletteColors}}" wx:key="*this" class="palette__slot">
          <button
            class="palette__color {{selectedColor === item ? 'palette__color--selected' : ''}} {{!canvasReady ? 'palette__color--disabled' : ''}}"
            style="background-color: {{item}};"
            data-color="{{item}}"
            bindtap="selectPaletteColor"
            disabled="{{!canvasReady}}"
            aria-label="选择颜色 {{item}}"
          >
            <image wx:if="{{selectedColor === item}}" class="palette__check" src="/assets/icons/iconsax/check.svg" mode="aspectFit" />
          </button>
        </view>
      </view>

      <!-- ── 底部操作 ── -->
      <view class="editor-actions">
        <button class="button-secondary editor-actions__button" bindtap="regenerate">重新生成</button>
        <button class="button-primary editor-actions__button" bindtap="saveAndView" loading="{{saving}}" disabled="{{saving || !canvasReady}}">{{saving ? '保存中' : '保存作品'}}</button>
      </view>

    </view>
  </view>

  <canvas
    wx:if="{{draft}}"
    id="exportPatternCanvas"
    class="export-pattern-canvas"
    type="2d"
    style="width: {{draft.settings.width >= draft.settings.height ? 640 : 640 * draft.settings.width / draft.settings.height}}px; height: {{draft.settings.height >= draft.settings.width ? 640 : 640 * draft.settings.height / draft.settings.width}}px;"
  ></canvas>

  <!-- 取色成功 Toast -->
  <view class="editor-toast {{toast.visible ? 'editor-toast--visible' : ''}}">{{toast.message}}</view>
</view>
