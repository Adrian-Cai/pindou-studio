<page-layout title="从想法开始" back show-main-nav selected-tab="{{selectedTab}}">
  <view class="text-generation-page">
    <view class="text-generation-page__intro">
      <view class="text-generation-page__eyebrow">灵感工坊 · 文生图</view>
      <view class="text-generation-page__title">把想法变成拼豆作品</view>
      <view class="text-generation-page__desc">AI 会先生成一张参考图，再由拼豆引擎转换成可编辑图纸。</view>
    </view>

    <view wx:if="{{task}}" class="text-generation-card">
      <view class="text-generation-card__prompt-label">你的描述</view>
      <view class="text-generation-card__prompt">{{task.prompt}}</view>

      <view wx:if="{{loading && !referenceImagePath}}" class="text-generation-card__state">
        <view class="text-generation-card__spinner"></view>
        <view class="text-generation-card__state-title">{{task.status === 'queued' ? '正在排队' : '正在生成参考图'}}</view>
        <view class="text-generation-card__state-desc">可以离开页面，之后从“作品”继续</view>
      </view>

      <view wx:elif="{{task.status === 'failed'}}" class="text-generation-card__state text-generation-card__state--failed">
        <view class="text-generation-card__state-title">参考图生成失败</view>
        <view class="text-generation-card__state-desc">{{errorMessage || '请稍后重试，失败不会扣除 AI 额度。'}}</view>
        <button class="button-primary text-generation-card__button" loading="{{loading}}" bindtap="retry">重新生成</button>
      </view>

      <view wx:elif="{{referenceImagePath}}" class="text-generation-card__result">
        <image class="text-generation-card__image" src="{{referenceImagePath}}" mode="aspectFit" aria-label="生成的参考图" />
        <view class="text-generation-card__result-note">参考图已生成，确认后会使用标准拼豆转换</view>
        <button class="button-primary text-generation-card__button" loading="{{converting}}" disabled="{{converting}}" bindtap="createPattern">生成拼豆图</button>
      </view>

      <view wx:if="{{errorMessage && task.status !== 'failed'}}" class="text-generation-card__error">
        {{errorMessage}}
        <text class="text-generation-card__retry" bindtap="refreshTask">重新读取</text>
      </view>
    </view>

    <view wx:else class="text-generation-card text-generation-card--empty">
      <view class="text-generation-card__state-title">没有找到这条任务</view>
      <view class="text-generation-card__state-desc">返回首页输入描述，开始新的创作。</view>
      <button class="button-primary text-generation-card__button" bindtap="goBack">返回</button>
    </view>
  </view>
</page-layout>
