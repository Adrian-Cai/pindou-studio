<page-layout title="从想法开始" back show-main-nav selected-tab="{{selectedTab}}">
  <view class="text-generation-page">
    <view wx:if="{{!isSavedWorkDetail}}" class="text-generation-page__intro">
      <view class="text-generation-page__eyebrow">灵感工坊 · 文生图</view>
      <view class="text-generation-page__title">把想法变成拼豆作品</view>
      <view class="text-generation-page__desc">AI 会先生成一张参考图，再由拼豆引擎转换成可编辑图纸。</view>
    </view>

    <view wx:if="{{task || hasSavedWork}}" class="text-generation-card">
      <view class="text-generation-card__prompt-header">
        <view class="text-generation-card__prompt-label">提示词</view>
        <button wx:if="{{displayPrompt}}" class="text-generation-card__copy" bindtap="copyPrompt">复制提示词</button>
      </view>
      <view class="text-generation-card__prompt">{{displayPrompt}}</view>
      <image wx:if="{{referenceImagePath}}" class="text-generation-card__image" src="{{referenceImagePath}}" data-src="{{referenceImagePath}}" mode="aspectFit" binderror="handleReferenceImageError" aria-label="生成的参考图" />

      <view wx:if="{{loading && !referenceImagePath}}" class="text-generation-card__state text-generation-card__state--loading">
        <view class="text-generation-card__state-title">{{task ? (task.status === 'queued' ? '正在排队' : '正在生成参考图') : '正在读取文生图作品'}}</view>
        <view class="text-generation-card__state-desc">{{task ? '可以离开页面，之后从“作品”继续' : '原图已保存在作品中'}}</view>
      </view>

      <view wx:elif="{{task && task.status === 'failed'}}" class="text-generation-card__state text-generation-card__state--failed">
        <view class="text-generation-card__state-title">参考图生成失败</view>
        <view class="text-generation-card__state-desc">{{errorMessage || '请稍后重试，失败不会扣除 AI 额度。'}}</view>
        <button class="button-primary text-generation-card__button" loading="{{loading}}" bindtap="retry">重新生成</button>
      </view>

      <view wx:elif="{{referenceImagePath}}" class="text-generation-card__result">
        <view wx:if="{{savingWork}}" class="text-generation-card__result-note">正在保存到作品…</view>
        <view wx:elif="{{savedWorkId}}" class="text-generation-card__result-note">原图已保存到作品，可保存到手机相册</view>
        <view wx:if="{{saveErrorMessage}}" class="text-generation-card__save-error">
          {{saveErrorMessage}}
          <text class="text-generation-card__retry" bindtap="retrySaveWork">重试保存</text>
        </view>
        <button wx:if="{{savedWorkId}}" class="button-primary text-generation-card__button" loading="{{savingImage}}" disabled="{{savingImage || savingWork}}" bindtap="saveToAlbum">保存到本地</button>
      </view>

      <view wx:if="{{errorMessage && (!task || task.status !== 'failed')}}" class="text-generation-card__error">
        {{errorMessage}}
        <text class="text-generation-card__retry" bindtap="refreshCurrent">重新读取</text>
      </view>
    </view>

    <view wx:else class="text-generation-card text-generation-card--empty">
      <view class="text-generation-card__state-title">{{loading ? '正在读取' : '没有找到这条文生图记录'}}</view>
      <view class="text-generation-card__state-desc">返回作品集或首页继续创作。</view>
      <button class="button-primary text-generation-card__button" bindtap="goBack">返回</button>
    </view>
  </view>
</page-layout>
