<page-layout title="AI 生成" back show-main-nav selected-tab="{{selectedTab}}">
  <view class="ai-generation-page">
    <view
      class="ai-compliance-notice"
      role="note"
      aria-label="当前生成结果由人工智能生成"
    >当前生成结果由人工智能生成</view>

    <!--
      单页面状态流转：排队 / 生成中 / 失败 / 完成都长在这一个页面里，
      页面框架（顶部提示 + 中间主内容区 + 底部禁用态编辑面板）不变，
      只按任务状态原地替换中间主内容卡片，不跳转任何独立失败页/成功页。
    -->

    <!-- ① 排队中：等待本地并发槽位 -->
    <view wx:if="{{isQueued}}" class="ai-generation-state">
      <view class="ai-generation-card">
        <view class="ai-generation-card__eyebrow">已加入生成队列</view>
        <view class="ai-generation-card__title">排队中</view>
        <view class="ai-generation-card__hint">{{queuePosition > 1 ? '前方还有 ' + (queuePosition - 1) + ' 个任务，轮到它会自动开始' : '马上开始生成，可以返回首页继续操作'}}</view>
        <view class="ai-generation-card__actions">
          <button class="button-secondary ai-generation-card__action" bindtap="cancelTask">取消生成</button>
          <button class="button-secondary ai-generation-card__action" bindtap="backHome">返回首页</button>
        </view>
      </view>
      <editor-control-panel
        ready="{{false}}"
        width="{{panelWidth}}"
        height="{{panelHeight}}"
        color-limit="{{panelColorLimit}}"
        bead-count="{{panelBeadCount}}"
      />
    </view>

    <!-- ② 生成中：紫色加载卡片（进度 + 取消/返回），下方编辑面板全禁用 -->
    <view wx:elif="{{isGenerating}}" class="ai-generation-state">
      <generating-preview-card
        title="{{stateTitle}}"
        subtitle="{{stateDescription}}"
        progress="{{progress}}"
        tip-text="{{tipText}}"
        show-actions="{{true}}"
        bindcancel="cancelTask"
        bindbackhome="backHome"
      />
      <editor-control-panel
        ready="{{false}}"
        width="{{panelWidth}}"
        height="{{panelHeight}}"
        color-limit="{{panelColorLimit}}"
        bead-count="{{panelBeadCount}}"
      />
    </view>

    <!-- ③ 失败：同一张紫色卡片原地切换为失败态，无进度条/无提示胶囊；
         缩放、尺寸颜色颗数、编辑工具、色板保持显示但全部禁用 -->
    <view wx:elif="{{isFailed}}" class="ai-generation-state">
      <generating-preview-card
        failed="{{true}}"
        title="{{stateTitle}}"
        subtitle="{{failureMessage || stateDescription}}"
        primary-text="{{failurePrimaryText}}"
        bindretry="handleFailurePrimary"
        bindbackhome="backHome"
      />
      <editor-control-panel
        ready="{{false}}"
        width="{{panelWidth}}"
        height="{{panelHeight}}"
        color-limit="{{panelColorLimit}}"
        bead-count="{{panelBeadCount}}"
      />
    </view>

    <!-- ④ 已完成：仅「从作品页回看」会停在这里；从首页发起的任务成功后已自动进入编辑器 -->
    <view wx:elif="{{isSucceeded}}" class="ai-generation-state">
      <view class="ai-generation-card">
        <view class="ai-generation-card__eyebrow">AI 精致生成</view>
        <view class="ai-generation-card__title">生成完成</view>
        <view class="ai-generation-card__hint">图纸已保存到作品，可以开始编辑</view>
        <view class="ai-generation-card__actions">
          <button class="button-primary ai-generation-card__action" bindtap="viewWork">查看作品</button>
          <button class="button-secondary ai-generation-card__action" bindtap="backHome">返回首页</button>
        </view>
      </view>
    </view>
  </view>
</page-layout>
