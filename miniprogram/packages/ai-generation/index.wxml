<page-layout title="AI 生成" back show-main-nav selected-tab="0">
  <view class="ai-generation-page">
    <view
      class="ai-compliance-notice"
      role="note"
      aria-label="当前生成结果由人工智能生成"
    >当前生成结果由人工智能生成</view>

    <view wx:if="{{sourceImagePath && !isGenerating}}" class="ai-generation-source">
      <image
        wx:if="{{!sourceImageError}}"
        class="ai-generation-source__image"
        src="{{sourceImagePath}}"
        mode="aspectFill"
        binderror="handleImageError"
        aria-label="待生成图片"
      />
      <view wx:else class="ai-generation-source__fallback">原图暂时无法预览</view>
    </view>

    <view wx:if="{{isGenerating}}" class="ai-generation-generating">
      <generating-preview-card
        title="{{stateTitle}}"
        subtitle="{{stateDescription}}"
        progress="{{progress}}"
        tip-text="{{tipText}}"
      />
    </view>
    <view wx:else class="ai-generation-card">
      <view class="ai-generation-card__eyebrow">AI 精致生成</view>
      <view class="ai-generation-card__title">{{stateTitle}}</view>
      <view class="ai-generation-card__hint">{{stateDescription}}</view>
      <view wx:if="{{statusMessage}}" class="ai-generation-card__status">{{statusMessage}}</view>
    </view>

    <!-- 生成中：提前展示编辑器底部面板的禁用态，图案就绪后跳转编辑器再启用 -->
    <editor-control-panel
      wx:if="{{isGenerating}}"
      ready="{{false}}"
      width="{{panelWidth}}"
      height="{{panelHeight}}"
      color-limit="{{panelColorLimit}}"
      bead-count="{{panelBeadCount}}"
    />

    <view wx:if="{{waitingLong && !isGenerating}}" class="ai-generation-waiting" role="status">
      处理时间比平时长一些，你可以暂时离开，之后回来继续查看。
    </view>

    <button
      wx:if="{{pageState === 'failed' && showPurchase}}"
      class="button-primary ai-generation-retry"
      bindtap="purchaseAiGeneration"
    >购买 AI 生成次数</button>

    <button
      wx:if="{{pageState === 'failed' && action === 'USE_STANDARD_MODE'}}"
      class="button-primary ai-generation-retry"
      bindtap="useStandardMode"
    >使用标准模式</button>

    <button
      wx:if="{{pageState === 'failed' && action === 'SELECT_IMAGE'}}"
      class="button-primary ai-generation-retry"
      bindtap="selectNewImage"
    >重新选择图片</button>

    <button
      wx:if="{{pageState === 'failed' && action === 'RETRY' && retryable}}"
      class="button-primary ai-generation-retry"
      bindtap="retry"
    >{{retryMode === 'generation' ? '重新生成' : retryMode === 'query' ? '重新查询' : '重试'}}</button>

    <button
      wx:if="{{pageState === 'failed' && action !== 'USE_STANDARD_MODE' && action !== 'SELECT_IMAGE' && !showPurchase && !retryable}}"
      class="button-primary ai-generation-retry"
      bindtap="backHome"
    >返回首页</button>

    <button
      wx:if="{{pageState === 'failed' && (showPurchase || retryable || action === 'USE_STANDARD_MODE' || action === 'SELECT_IMAGE')}}"
      class="button-secondary ai-generation-back"
      bindtap="backHome"
    >返回首页</button>

    <button
      wx:if="{{pageState === 'loading'}}"
      class="button-secondary ai-generation-back"
      bindtap="backHome"
    >返回首页</button>

    <view wx:if="{{!isGenerating}}" class="ai-generation-note">
      AI 输入图片已在上传时完成内容安全审核；生成结果经服务端格式校验后交给标准模式转换为拼豆图。
    </view>
  </view>
</page-layout>
