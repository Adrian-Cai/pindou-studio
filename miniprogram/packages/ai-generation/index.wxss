.ai-generation-page {
  box-sizing: border-box;
  padding: 0 32rpx 32rpx;
  --color-ai-text: #7c5cfc;
}

.ai-generation-card {
  padding: 40rpx 32rpx;
  border-radius: 20rpx;
  background: var(--color-surface, #ffffff);
  box-shadow: var(--shadow-card, 0 4rpx 16rpx rgba(31, 38, 35, 0.08));
  text-align: center;
}

.ai-generation-card__eyebrow {
  color: var(--color-ai-text, #5d43b7);
  font-size: 24rpx;
  line-height: 36rpx;
}

.ai-generation-card__title {
  margin-top: 12rpx;
  color: var(--color-text, #1b211e);
  font-size: 36rpx;
  font-weight: 600;
  line-height: 52rpx;
}

.ai-generation-card__hint {
  margin-top: 12rpx;
  color: var(--color-text-secondary, #5f6963);
  font-size: 26rpx;
  line-height: 40rpx;
}

/* 卡片内双按钮行：取消/重试 ｜ 返回首页 横向排列 */
.ai-generation-card__actions {
  display: flex;
  gap: 24rpx;
  margin-top: 32rpx;
}

.ai-generation-card__action {
  flex: 1;
  margin: 0;
}

/* 成功态仍属于本页：结果预览在状态卡片位置原地出现，编辑面板紧随其后启用。 */
.ai-generation-disclosure {
  display: flex;
  min-height: 64rpx;
  margin-bottom: 16rpx;
  padding: 0 20rpx;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  background: #fff3cc;
  color: #73580d;
  font-size: 24rpx;
  line-height: 32rpx;
}

.ai-generation-result-card {
  padding: 20rpx 20rpx 24rpx;
  border-radius: 20rpx;
  background: var(--color-surface, #ffffff);
  box-shadow: var(--shadow-card, 0 4rpx 16rpx rgba(31, 38, 35, 0.08));
}

.ai-generation-result-card__preview {
  position: relative;
  display: flex;
  box-sizing: border-box;
  margin-top: 16rpx;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border-radius: 16rpx;
  aspect-ratio: 1;
  background: #f7f7f7;
}

.ai-generation-result-card__coordinate-grid {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
}

.ai-generation-result-card__coordinate-corner {
  position: absolute;
  top: 0;
  left: 0;
  box-sizing: border-box;
  width: 44rpx;
  height: 44rpx;
  background: #ffffff;
}

.ai-generation-result-card__coordinate-corner--top-right {
  right: 0;
  left: auto;
}

.ai-generation-result-card__coordinate-corner--bottom-left,
.ai-generation-result-card__coordinate-corner--bottom-right {
  top: auto;
  bottom: 0;
}

.ai-generation-result-card__coordinate-corner--bottom-right {
  right: 0;
  left: auto;
}

.ai-generation-result-card__ruler {
  position: relative;
  overflow: hidden;
  background: #ffffff;
}

.ai-generation-result-card__ruler-ticks {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  transform-origin: center;
}

.ai-generation-result-card__ruler--top {
  position: absolute;
  top: 0;
  right: 44rpx;
  left: 44rpx;
  box-sizing: border-box;
  height: 44rpx;
  border-bottom: 1rpx solid #c5cbd2;
}

.ai-generation-result-card__ruler--left {
  position: absolute;
  top: 44rpx;
  bottom: 44rpx;
  left: 0;
  box-sizing: border-box;
  width: 44rpx;
  border-right: 1rpx solid #c5cbd2;
}

.ai-generation-result-card__ruler--bottom {
  position: absolute;
  right: 44rpx;
  bottom: 0;
  left: 44rpx;
  box-sizing: border-box;
  height: 44rpx;
  border-top: 1rpx solid #c5cbd2;
}

.ai-generation-result-card__ruler--right {
  position: absolute;
  top: 44rpx;
  right: 0;
  bottom: 44rpx;
  box-sizing: border-box;
  width: 44rpx;
  border-left: 1rpx solid #c5cbd2;
}

.ai-generation-result-card__tick {
  position: absolute;
  background: #aab2bc;
}

.ai-generation-result-card__ruler--top .ai-generation-result-card__tick {
  bottom: 0;
  width: 1rpx;
  height: 9rpx;
}

.ai-generation-result-card__ruler--left .ai-generation-result-card__tick {
  right: 0;
  width: 9rpx;
  height: 1rpx;
}

.ai-generation-result-card__ruler--bottom .ai-generation-result-card__tick {
  top: 0;
  width: 1rpx;
  height: 9rpx;
}

.ai-generation-result-card__ruler--right .ai-generation-result-card__tick {
  left: 0;
  width: 9rpx;
  height: 1rpx;
}

.ai-generation-result-card__tick--major {
  background: #788492;
}

.ai-generation-result-card__ruler--top .ai-generation-result-card__tick--major {
  height: 16rpx;
}

.ai-generation-result-card__ruler--left .ai-generation-result-card__tick--major {
  width: 16rpx;
}

.ai-generation-result-card__ruler--bottom .ai-generation-result-card__tick--major {
  height: 16rpx;
}

.ai-generation-result-card__ruler--right .ai-generation-result-card__tick--major {
  width: 16rpx;
}

.ai-generation-result-card__ruler-label {
  position: absolute;
  color: #64707d;
  font-size: 18rpx;
  line-height: 22rpx;
  white-space: nowrap;
  transform-origin: center;
}

.ai-generation-result-card__ruler-label--horizontal {
  box-sizing: border-box;
  width: 92rpx;
  margin-left: -46rpx;
  left: 0;
  text-align: center;
  bottom: 17rpx;
}

.ai-generation-result-card__ruler--bottom .ai-generation-result-card__ruler-label--horizontal {
  top: 17rpx;
  bottom: auto;
}

.ai-generation-result-card__ruler-label--vertical {
  top: 50%;
  right: 0;
  box-sizing: border-box;
  width: 44rpx;
  height: 24rpx;
  margin-top: -12rpx;
  line-height: 24rpx;
  text-align: right;
}

.ai-generation-result-card__ruler--right .ai-generation-result-card__ruler-label--vertical {
  right: auto;
  left: 0;
  text-align: left;
}

.ai-generation-result-card__board {
  position: absolute;
  top: 44rpx;
  right: 44rpx;
  bottom: 44rpx;
  left: 44rpx;
  overflow: hidden;
  background: #f7f7f7;
}

.ai-generation-result-card__image {
  position: absolute;
  top: 0;
  left: 0;
  display: block;
  width: 100%;
  height: 100%;
  transform-origin: center;
}

.ai-generation-result-card__pan-area {
  position: absolute;
  z-index: 1;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: transparent;
}

.ai-generation-result-card__fallback {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx;
  text-align: center;
  color: var(--color-text-secondary, #5f6963);
  font-size: 26rpx;
  line-height: 40rpx;
}

@media (prefers-color-scheme: dark) {
  .ai-generation-page {
    --color-ai-text: #c2b5ff;
  }

  .ai-generation-result-card__preview {
    background: #20242a;
  }

  .ai-generation-result-card__coordinate-corner,
  .ai-generation-result-card__ruler {
    background: #292d33;
  }

  .ai-generation-result-card__coordinate-corner {
    border-color: #4a515a;
  }

  .ai-generation-result-card__ruler--top,
  .ai-generation-result-card__ruler--left,
  .ai-generation-result-card__ruler--bottom,
  .ai-generation-result-card__ruler--right {
    border-color: #4a515a;
  }

  .ai-generation-result-card__tick {
    background: #626d7a;
  }

  .ai-generation-result-card__tick--major {
    background: #9ba6b2;
  }

  .ai-generation-result-card__ruler-label {
    color: #c2cad3;
  }

  .ai-generation-result-card__board {
    background: #20242a;
  }
}
