.ai-generation-page {
  box-sizing: border-box;
  padding: 32rpx;
  --color-ai-text: #7c5cfc;
}

/* 各状态共用的中间主内容区：状态切换只替换这里，页面框架不动 */
.ai-generation-state {
  margin-top: 24rpx;
}

.ai-generation-card {
  padding: 40rpx 32rpx;
  border-radius: 20rpx;
  background: var(--color-surface, #ffffff);
  box-shadow: var(--shadow-card, 0 4rpx 16rpx rgba(31, 38, 35, 0.08));
  text-align: center;
}

.ai-generation-card__eyebrow {
  color: var(--color-ai-text, #5d43b7);
  font-size: 24rpx;
  line-height: 36rpx;
}

.ai-generation-card__title {
  margin-top: 12rpx;
  color: var(--color-text, #1b211e);
  font-size: 36rpx;
  font-weight: 600;
  line-height: 52rpx;
}

.ai-generation-card__hint {
  margin-top: 12rpx;
  color: var(--color-text-secondary, #5f6963);
  font-size: 26rpx;
  line-height: 40rpx;
}

/* 卡片内双按钮行：取消/重试 ｜ 返回首页 横向排列 */
.ai-generation-card__actions {
  display: flex;
  gap: 24rpx;
  margin-top: 32rpx;
}

.ai-generation-card__action {
  flex: 1;
  margin: 0;
}

/* 成功态仍属于本页：结果预览在状态卡片位置原地出现，编辑面板紧随其后启用。 */
.ai-generation-result-card {
  padding: 20rpx 20rpx 24rpx;
  border-radius: 20rpx;
  background: var(--color-surface, #ffffff);
  box-shadow: var(--shadow-card, 0 4rpx 16rpx rgba(31, 38, 35, 0.08));
}

.ai-generation-result-card__preview {
  display: flex;
  box-sizing: border-box;
  height: 430rpx;
  margin-top: 16rpx;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border-radius: 16rpx;
  background: #f7f7f7;
}

.ai-generation-result-card__canvas {
  display: block;
  width: 100%;
  height: 100%;
}

.ai-generation-result-card__fallback {
  color: var(--color-text-secondary, #5f6963);
  font-size: 26rpx;
  line-height: 40rpx;
}

@media (prefers-color-scheme: dark) {
  .ai-generation-page {
    --color-ai-text: #c2b5ff;
  }

  .ai-generation-result-card__preview {
    background: #20242a;
  }
}
