.result-panel {
  margin-top: 24rpx;
  padding: 28rpx;
  border: 0;
  border-radius: var(--radius-card-large);
  background: var(--color-surface);
  box-shadow: var(--shadow-card);
}

.panel-heading {
  margin-bottom: 24rpx;
}

.panel-heading__title {
  color: var(--color-text);
  font-size: 32rpx;
  font-weight: 600;
  line-height: 48rpx;
}

.panel-heading__hint {
  margin-top: 8rpx;
  color: var(--color-text-secondary);
  font-size: 24rpx;
  font-weight: 400;
  line-height: 36rpx;
}

.palette-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  column-gap: 24rpx;
  row-gap: 40rpx;
}

.palette-preview {
  display: grid;
  grid-template-columns: repeat(6, minmax(0, 1fr));
  align-items: start;
  column-gap: 12rpx;
}

.palette-preview__item {
  min-width: 0;
  text-align: center;
}

.palette-preview__color {
  box-sizing: border-box;
  width: 100%;
  border: 1rpx solid rgba(17, 17, 17, 0.08);
  border-radius: 12rpx;
  aspect-ratio: 1;
}

.palette-preview__code,
.palette-preview__more-label {
  margin-top: 12rpx;
  color: var(--color-text);
  font-size: 21rpx;
  font-weight: 600;
  line-height: 30rpx;
  white-space: nowrap;
}

.palette-preview__count {
  margin-top: 2rpx;
  color: var(--color-text-tertiary);
  font-size: 16rpx;
  font-variant-numeric: tabular-nums;
  letter-spacing: -0.6rpx;
  line-height: 26rpx;
  white-space: nowrap;
}

.palette-preview__percentage-stacked {
  display: none;
}

.palette-preview__more {
  grid-column: 6;
  border-radius: 12rpx;
}

.palette-preview__more--pressed {
  opacity: 0.62;
}

.palette-preview__color--more {
  display: flex;
  align-items: center;
  justify-content: center;
  border-color: transparent;
  background: var(--color-surface-muted);
}

.palette-preview__more-icon {
  display: block;
  width: 40rpx;
  height: 40rpx;
}

.palette-preview__more-label {
  color: var(--color-text-secondary);
}

.palette-toggle {
  display: flex;
  min-height: 72rpx;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  border-radius: 12rpx;
  color: var(--color-primary);
  font-size: 24rpx;
  font-weight: 500;
  line-height: 36rpx;
}

.palette-toggle--collapse {
  margin: 20rpx -8rpx -12rpx;
}

.palette-toggle--pressed {
  background: var(--color-primary-soft);
}

.palette-toggle__arrow-up {
  width: 32rpx;
  height: 32rpx;
}

.palette-card {
  min-width: 0;
  text-align: center;
}

.palette-card__color {
  box-sizing: border-box;
  width: 100%;
  border: 1rpx solid rgba(17, 17, 17, 0.08);
  border-radius: 16rpx;
  aspect-ratio: 1;
}

.palette-card__code {
  overflow: hidden;
  margin-top: 16rpx;
  color: var(--color-text);
  font-size: 24rpx;
  font-weight: 600;
  line-height: 36rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.palette-card__count {
  overflow: hidden;
  margin-top: 2rpx;
  color: var(--color-text-tertiary);
  font-size: 21rpx;
  font-variant-numeric: tabular-nums;
  line-height: 32rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.panel-empty {
  padding: 64rpx 24rpx;
  color: var(--color-text-tertiary);
  font-size: 24rpx;
  text-align: center;
}

.download-format {
  margin-top: var(--space-2);
  margin-bottom: 20rpx;
  color: var(--color-text-secondary);
  font-size: 22rpx;
  line-height: 32rpx;
}

.download-action,
.download-action result-download-button {
  display: flex;
  box-sizing: border-box;
  width: 100%;
  min-width: 0;
}

@media (max-width: 340px) {
  .result-panel {
    padding-right: 24rpx;
    padding-left: 24rpx;
  }

  .palette-preview {
    column-gap: 8rpx;
  }

  .palette-preview__code,
  .palette-preview__more-label {
    font-size: 19rpx;
  }

  .palette-preview__count {
    font-size: 16rpx;
  }

  .palette-preview__percentage-inline {
    display: none;
  }

  .palette-preview__percentage-stacked {
    display: block;
    color: var(--color-text-tertiary);
    font-size: 16rpx;
    font-variant-numeric: tabular-nums;
    line-height: 24rpx;
    white-space: nowrap;
  }
}
