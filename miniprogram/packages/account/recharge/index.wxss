@import "../../../styles/profile-pages.wxss";

.recharge-page { max-width: 720rpx; margin: 0 auto; }
.recharge-hero { padding: 28rpx 0 36rpx; text-align: center; }
.recharge-hero image { width: 180rpx; height: 128rpx; }
.recharge-hero__title { margin-top: 10rpx; font-size: 38rpx; font-weight: 600; }
.recharge-hero__quota { display: flex; flex-direction: column; gap: 4rpx; margin-top: 8rpx; color: var(--color-text-secondary); font-size: 25rpx; line-height: 34rpx; }
.recharge-hero__quota text { color: var(--color-primary); font-size: 36rpx; font-weight: 600; }

.recharge-options { display: grid; gap: 18rpx; }
.recharge-options__message { padding: 32rpx 0; color: var(--color-text-secondary); font-size: 26rpx; line-height: 36rpx; text-align: center; }
.recharge-option { display: flex; height: 104rpx; align-items: center; padding: 0 28rpx; border: 0; border-radius: var(--radius-card-small); background: var(--color-surface); box-shadow: var(--shadow-card); transition: var(--transition-press); }
.recharge-option--active { background: var(--color-primary-surface); box-shadow: 0 0 0 2rpx var(--color-primary), var(--shadow-card); }
.recharge-option:active { background: var(--strong-overlay); transform: scale(0.97); }
.recharge-option image { width: 82rpx; height: 62rpx; }
.recharge-option__label { flex: 1; margin-left: 18rpx; font-size: 28rpx; }
.recharge-option__price { font-size: 31rpx; font-weight: 600; }
.recharge-option--active .recharge-option__price { color: var(--color-primary); }
.recharge-option__check { display: flex; width: 36rpx; height: 36rpx; align-items: center; justify-content: center; margin-left: 18rpx; border-radius: 50%; background: var(--color-primary); }
.recharge-option__check image { width: 24rpx; height: 24rpx; }

.payment-method { display: flex; height: 88rpx; align-items: center; justify-content: space-between; margin-top: 24rpx; padding: 0 28rpx; border-radius: var(--radius-card-small); box-shadow: var(--shadow-card); font-size: 27rpx; }
.payment-method view { display: flex; align-items: center; gap: 10rpx; }
.payment-method view image { width: 32rpx; height: 32rpx; }
.payment-method view .payment-method__arrow { margin-left: 4rpx; }
.recharge-button { width: 100%; margin-top: 24rpx; }
.recharge-notes { margin-top: 22rpx; color: var(--color-text-tertiary); font-size: 21rpx; line-height: 34rpx; text-align: center; }
.recharge-notes__agreement { min-height: 64rpx; line-height: 64rpx; transition: var(--transition-press); }
.recharge-notes__agreement--pressed { opacity: 0.72; transform: scale(0.97); }
.recharge-notes__link { color: var(--color-text-secondary); text-decoration: underline; text-underline-offset: 4rpx; }
.recharge-notes__agreement--pressed .recharge-notes__link { color: var(--color-primary); }
