@import "../../../styles/profile-pages.wxss";

.favorite-tabs { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16rpx; }
.favorite-tabs__item { position: relative; display: flex; min-width: 0; height: 88rpx; align-items: center; justify-content: center; padding: 0 12rpx; border: 0; border-radius: var(--radius-full); background: transparent; box-shadow: var(--shadow-ghost); font-size: 25rpx; white-space: nowrap; transition: var(--transition-press); }
.favorite-tabs__item--active { background: var(--color-primary-soft); box-shadow: 0 0 0 2rpx var(--color-primary), var(--shadow-ghost); color: var(--color-primary); font-weight: 600; }
.favorite-tabs__item:active { background: var(--strong-overlay); transform: scale(0.97); }
.favorite-tabs__item--active::after { position: absolute; right: 34%; bottom: -2rpx; left: 34%; height: 6rpx; border-radius: 6rpx; background: var(--color-primary); content: ""; }

.favorite-summary { display: flex; padding: 36rpx 52rpx; }
.favorite-summary__item { display: flex; flex: 1; align-items: center; justify-content: center; gap: 24rpx; color: var(--color-text-secondary); font-size: 24rpx; }
.favorite-summary__item text { margin-right: 8rpx; color: var(--color-primary); font-size: 44rpx; font-weight: 600; }
.favorite-summary__badge { display: flex; width: 88rpx; height: 88rpx; align-items: center; justify-content: center; border-radius: 50%; background: var(--color-primary-soft); color: var(--color-primary); font-size: 42rpx; }
.favorite-summary__badge image { width: 48rpx; height: 48rpx; }
.favorite-summary__badge--yellow { background: var(--color-warning-soft); color: var(--color-warning); }
.favorite-summary__line { width: 1rpx; height: 80rpx; background: var(--color-border); }

.favorite-grid { display: flex; width: 100%; flex-direction: column; gap: 24rpx; margin-top: 24rpx; }
.favorite-card { width: 100%; min-width: 0; padding: 24rpx; }
.favorite-card__main { display: flex; min-width: 0; align-items: stretch; gap: 20rpx; }
.favorite-card__cover { width: 192rpx; height: 192rpx; flex: 0 0 192rpx; align-self: flex-start; border-radius: var(--radius-media); background: var(--color-surface-muted); }
.favorite-card__info { display: flex; min-width: 0; flex: 1; flex-direction: column; }
.favorite-card__title { min-width: 0; overflow: hidden; font-size: 28rpx; font-weight: 600; line-height: 40rpx; text-overflow: ellipsis; white-space: nowrap; }
.favorite-card__meta { margin-top: 12rpx; color: var(--color-text-secondary); font-size: 22rpx; line-height: 28rpx; white-space: nowrap; }
.favorite-card__date { margin-top: 4rpx; color: var(--color-text-tertiary); font-size: 21rpx; line-height: 28rpx; white-space: nowrap; }
.favorite-card__actions { display: flex; box-sizing: border-box; width: 100%; min-width: 0; flex-flow: row nowrap; align-items: center; margin-top: auto; padding-top: 16rpx; }
.favorite-card__action { display: flex; box-sizing: border-box; min-width: 0; height: 48rpx; flex: 1 1 0; align-items: center; justify-content: center; gap: 8rpx; color: var(--color-text-secondary); font-size: 24rpx; line-height: 1; white-space: nowrap; transition: var(--transition-press); }
.favorite-card__action-icon { width: 28rpx; height: 28rpx; flex-shrink: 0; }
.favorite-card__action:active { background: var(--strong-overlay); transform: scale(0.97); }
.favorite-card__action--primary { color: var(--color-primary); }
.favorite-card__action--danger { color: var(--color-danger); }
.favorite-card__action--danger:active { background: var(--color-danger-soft); }

.favorites-page .empty-state__icon image { width: 56rpx; height: 56rpx; }

@media (max-width: 380px) {
  .favorite-tabs { gap: 8rpx; }
  .favorite-tabs__item { padding: 0 6rpx; font-size: 21rpx; }
  .favorite-summary { padding: 28rpx 20rpx; }
  .favorite-summary__badge { width: 68rpx; height: 68rpx; }
  .favorite-summary__badge image { width: 40rpx; height: 40rpx; }
  .favorite-card { padding: 20rpx; }
  .favorite-card__main { gap: 16rpx; }
  .favorite-card__cover { width: 176rpx; height: 176rpx; flex-basis: 176rpx; }
  .favorite-card__title { font-size: 26rpx; }
  .favorite-card__meta { font-size: 21rpx; }
  .favorite-card__action { gap: 4rpx; font-size: 22rpx; }
  .favorite-card__action-icon { width: 24rpx; height: 24rpx; }
}
