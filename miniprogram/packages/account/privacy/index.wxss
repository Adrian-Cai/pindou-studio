@import "../../../styles/profile-pages.wxss";

.privacy-intro { display: flex; align-items: flex-start; gap: 8rpx; padding: 14rpx 8rpx 28rpx; color: var(--color-text-secondary); font-size: 24rpx; line-height: 38rpx; }
.privacy-intro image { width: 32rpx; height: 32rpx; flex-shrink: 0; margin-top: 3rpx; }
.privacy-card { padding: 20rpx 32rpx 0; }
.privacy-card__title { display: flex; height: 64rpx; align-items: center; gap: 16rpx; font-size: 29rpx; font-weight: 600; }
.privacy-card__title image { width: 36rpx; height: 36rpx; flex-shrink: 0; }
.privacy-setting { display: flex; min-height: 122rpx; align-items: center; border-bottom: 1rpx solid var(--color-border); }
.privacy-setting:last-child { border-bottom: 0; }
.privacy-setting--notice { min-height: 146rpx; padding-bottom: 16rpx; }
.privacy-setting__icon { width: 40rpx; height: 40rpx; flex-shrink: 0; }
.privacy-setting__content { min-width: 0; flex: 1; margin: 0 18rpx; }
.privacy-setting__content view { font-size: 28rpx; }
.privacy-setting__content text { display: block; margin-top: 8rpx; color: var(--color-text-tertiary); font-size: 21rpx; line-height: 32rpx; }
.privacy-setting switch { flex-shrink: 0; transform: scale(0.86); transform-origin: right center; }

.privacy-documents { margin-top: 28rpx; }
.privacy-document { display: flex; height: 92rpx; align-items: center; border-bottom: 1rpx solid var(--color-border); transition: var(--transition-press); }
.privacy-document:active { background: var(--strong-overlay); opacity: 0.72; transform: scale(0.99); }
.privacy-document:last-child { border-bottom: 0; }
.privacy-document > image:first-child { width: 40rpx; height: 40rpx; flex-shrink: 0; margin-right: 16rpx; }
.privacy-document view { flex: 1; font-size: 27rpx; }
.privacy-document > image:last-child { width: 32rpx; height: 32rpx; flex-shrink: 0; }

.cancel-account { display: flex; align-items: center; margin-top: 28rpx; padding: 26rpx 32rpx; transition: var(--transition-press); }
.cancel-account:active { background: var(--strong-overlay); opacity: 0.72; transform: scale(0.99); }
.cancel-account--loading { opacity: 0.6; }
.cancel-account__icon { width: 44rpx; height: 44rpx; flex-shrink: 0; margin-right: 28rpx; }
.cancel-account > view:nth-child(2) { flex: 1; }
.cancel-account > view:nth-child(2) view { color: var(--color-danger); font-size: 28rpx; font-weight: 600; }
.cancel-account > view:nth-child(2) text { display: block; margin-top: 8rpx; color: var(--color-text-tertiary); font-size: 21rpx; }
.cancel-account__arrow { width: 32rpx; height: 32rpx; flex-shrink: 0; }
.privacy-safe { display: flex; align-items: center; justify-content: center; gap: 8rpx; padding: 36rpx 0 8rpx; color: var(--color-text-tertiary); font-size: 22rpx; text-align: center; }
.privacy-safe image { width: 28rpx; height: 28rpx; opacity: 0.72; }
