.content-page {
  padding-top: 20rpx;
}

.content-card {
  margin-bottom: 22rpx;
}

.content-title {
  font-size: 32rpx;
  font-weight: 650;
}

.content-desc {
  margin-top: 12rpx;
  color: #85817b;
  font-size: 24rpx;
  line-height: 1.75;
}

.empty-panel {
  display: flex;
  min-height: 720rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.empty-panel__icon {
  display: flex;
  width: 128rpx;
  height: 128rpx;
  align-items: center;
  justify-content: center;
  border-radius: 42rpx;
  background: #eee9e3;
  color: #aaa39b;
  font-size: 56rpx;
}

.empty-panel__title {
  margin-top: 28rpx;
  font-size: 31rpx;
  font-weight: 650;
}

.empty-panel__desc {
  width: 480rpx;
  margin-top: 12rpx;
  color: #918b84;
  font-size: 24rpx;
  line-height: 1.7;
}
