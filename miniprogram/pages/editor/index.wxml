<view class="editor">
  <top-bar title="编辑拼豆图" back back-inset-rpx="{{32}}" />

  <view wx:if="{{draft}}" class="editor__body">
    <view class="editor__content">

      <!-- ── 工作区：接收所有手势 ── -->
      <view
        class="workspace"
        bindtouchstart="onWorkspaceTouchStart"
        bindtouchmove="onWorkspaceTouchMove"
        bindtouchend="onWorkspaceTouchEnd"
        catchtouchmove="onWorkspaceTouchMove"
      >
        <view
          class="canvas-stage"
          style="transform: translate(calc(-50% + {{panX}}px), calc(-50% + {{panY}}px)) scale({{zoom}}); transform-origin: center center; will-change: transform;"
        >
          <canvas
            id="patternCanvas"
            class="pattern-canvas"
            type="2d"
          ></canvas>
        </view>
      </view>

      <!-- ── 缩放控制 ── -->
      <view class="zoom-control">
        <button
          class="zoom-control__button"
          bindtap="zoomOut"
          disabled="{{zoom <= 0.5}}"
          aria-label="缩小"
        >−</button>
        <text class="zoom-control__value">{{zoomPercent}}%</text>
        <button
          class="zoom-control__button"
          bindtap="zoomIn"
          disabled="{{zoom >= 1.8}}"
          aria-label="放大"
        >＋</button>
        <button class="zoom-control__reset" bindtap="resetView" aria-label="适应画布">适应</button>
      </view>

      <!-- ── 信息卡 ── -->
      <view class="info-card">
        <view class="info-card__row">
          <text>尺寸：{{draft.settings.width}}×{{draft.settings.height}}</text>
          <text>颜色：{{draft.settings.colorLimit}}色</text>
        </view>
        <text class="info-card__count">共 {{beadCount}} 颗</text>
      </view>

      <!-- ── 工具栏 ── -->
      <view class="tools">
        <view
          wx:for="{{tools}}"
          wx:key="id"
          class="tool {{item.disabled ? 'tool--disabled' : ''}} {{activeTool === item.id ? 'tool--active' : ''}}"
          data-tool="{{item.id}}"
          data-disabled="{{item.disabled}}"
          bindtap="selectTool"
        >
          <image
            class="tool__icon"
            src="{{activeTool === item.id ? item.activeIcon : item.icon}}"
            mode="aspectFit"
          />
          <text class="tool__label">{{item.label}}</text>
        </view>
      </view>

      <!-- ── 调色板 ── -->
      <view class="palette">
        <view wx:for="{{paletteColors}}" wx:key="*this" class="palette__slot">
          <button
            class="palette__color {{selectedColor === item ? 'palette__color--selected' : ''}}"
            style="background-color: {{item}};"
            data-color="{{item}}"
            bindtap="selectPaletteColor"
            aria-label="选择颜色 {{item}}"
          >
            <text wx:if="{{selectedColor === item}}" class="palette__check">✓</text>
          </button>
        </view>
      </view>

      <!-- ── 底部操作 ── -->
      <view class="editor-actions">
        <button class="button-secondary editor-actions__button" bindtap="regenerate">重新生成</button>
        <button class="button-primary editor-actions__button" bindtap="saveAndView" loading="{{saving}}" disabled="{{saving}}">{{saving ? '保存中' : '保存作品'}}</button>
      </view>

    </view>
  </view>

  <!-- 放大镜 overlay -->
  <canvas
    wx:if="{{magnifier.visible}}"
    id="magnifierCanvas"
    class="magnifier-canvas"
    type="2d"
    style="top: {{magnifier.top}}px; left: {{magnifier.left}}px;"
  ></canvas>

  <!-- 取色成功 Toast -->
  <view class="editor-toast {{toast.visible ? 'editor-toast--visible' : ''}}">{{toast.message}}</view>
</view>
