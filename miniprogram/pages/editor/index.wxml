<view class="editor">
  <top-bar title="编辑拼豆图" back back-inset-rpx="{{32}}" />

  <view wx:if="{{draft}}" class="editor__body">
    <view class="editor__content">
      <view class="preview-card">
        <view class="preview-transform">
          <canvas id="patternCanvas" class="pattern-canvas" type="2d" bindtouchend="editPattern"></canvas>
        </view>
      </view>

      <view class="zoom-control">
        <button class="zoom-control__button" bindtap="zoomOut" aria-label="缩小">−</button>
        <text class="zoom-control__value">{{zoomPercent}}%</text>
        <button class="zoom-control__button" bindtap="zoomIn" aria-label="放大">＋</button>
      </view>

      <view class="info-card">
        <view class="info-card__row">
          <text>尺寸：{{draft.settings.width}}×{{draft.settings.height}}</text>
          <text>颜色：{{draft.settings.colorLimit}}色</text>
        </view>
        <text class="info-card__count">共 {{beadCount}} 颗</text>
      </view>

      <view class="tools">
        <view
          wx:for="{{tools}}"
          wx:key="id"
          class="tool {{item.disabled ? 'tool--disabled' : ''}} {{activeTool === item.id ? 'tool--active' : ''}}"
          data-tool="{{item.id}}"
          data-disabled="{{item.disabled}}"
          bindtap="selectTool"
        >
          <image class="tool__icon" src="{{item.icon}}" mode="aspectFit" />
          <text class="tool__label">{{item.label}}</text>
        </view>
      </view>

      <view class="palette">
        <view wx:for="{{paletteColors}}" wx:key="*this" class="palette__slot">
          <button
            class="palette__color {{selectedColor === item ? 'palette__color--selected' : ''}}"
            style="background-color: {{item}};"
            data-color="{{item}}"
            bindtap="selectPaletteColor"
            aria-label="选择颜色 {{item}}"
          >
            <text wx:if="{{selectedColor === item}}" class="palette__check">✓</text>
          </button>
        </view>
      </view>

      <view class="editor-actions">
        <button class="button-secondary editor-actions__button" bindtap="regenerate">重新生成</button>
        <button class="button-primary editor-actions__button" bindtap="saveAndView" loading="{{saving}}" disabled="{{saving}}">{{saving ? '保存中' : '保存作品'}}</button>
      </view>
    </view>
  </view>
</view>
