page {
  --color-primary: #12b466;
  --color-primary-pressed: #0f9f5b;
  --color-primary-soft: #ecfaf3;
  --color-bg: #ffffff;
  --color-surface: #ffffff;
  --color-surface-muted: #fafafa;
  --color-text: #111111;
  --color-text-secondary: #666666;
  --color-text-tertiary: #999999;
  --color-border: #eeeeee;
  /* 工具选中态 */
  --tool-active-bg: #F1ECFF;
  --tool-active-accent: #6F5BFF;
  --tool-active-border: #7C5CFF;
  overflow: hidden;
  background: var(--color-bg);
}

.editor {
  display: flex;
  height: 100vh;
  flex-direction: column;
  background: var(--color-bg);
  color: var(--color-text);
}

.editor__body {
  min-height: 0;
  flex: 1;
  overflow: hidden;
}

.editor__content {
  display: flex;
  box-sizing: border-box;
  height: 100%;
  min-height: 0;
  flex-direction: column;
  padding: 16rpx 16rpx calc(40rpx + env(safe-area-inset-bottom));
}


/* ─── 工作区（画布容器）────────────────────────────────────────── */

.workspace {
  flex: 1 1 0;
  min-height: 0;
  position: relative;
  overflow: hidden;
  border: 1rpx solid var(--color-border);
  border-radius: 16rpx;
  background: #EDEBF8;
  /* 浅紫灰背景，与白色页面区分 */
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.canvas-stage {
  /* 居中于 workspace，transform 后由 panX/panY/zoom 控制 */
  position: absolute;
  top: 50%;
  left: 50%;
  width: 280px;
  height: 280px;
  /* 注意：-50% 偏移已合并到 style.transform 的 calc(-50% + panX) 中 */
}

.pattern-canvas {
  display: block;
  width: 100%;
  height: 100%;
  background: #f7f7f7;
  border-radius: 8rpx;
}


/* ─── 缩放控制 ───────────────────────────────────────────────── */

.zoom-control {
  display: flex;
  flex-shrink: 0;
  height: 60rpx;
  align-items: center;
  justify-content: center;
  gap: 48rpx;
  margin-top: 24rpx;
}

.zoom-control__button {
  display: flex;
  box-sizing: border-box;
  width: 60rpx;
  min-width: 60rpx;
  max-width: 60rpx;
  height: 60rpx;
  flex: 0 0 60rpx;
  align-items: center;
  justify-content: center;
  padding: 0;
  border: 1rpx solid var(--color-border);
  border-radius: 999rpx;
  background: var(--color-surface);
  color: var(--color-text);
  font-size: 36rpx;
  font-weight: 300;
  line-height: 1;
}

.zoom-control__button[disabled] {
  opacity: 0.32;
}

.zoom-control__button:active {
  background: #f5f5f5;
}

.zoom-control__value {
  min-width: 88rpx;
  color: var(--color-text);
  font-size: 28rpx;
  font-weight: 400;
  line-height: 44rpx;
  text-align: center;
}

.zoom-control__reset {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  height: 52rpx;
  padding: 0 20rpx;
  border: 1rpx solid var(--color-border);
  border-radius: 999rpx;
  background: var(--color-surface);
  color: var(--color-text-secondary);
  font-size: 24rpx;
  font-weight: 400;
  line-height: 1;
}

.zoom-control__reset:active {
  background: #f5f5f5;
}


/* ─── 信息卡 ─────────────────────────────────────────────────── */

.info-card {
  display: flex;
  flex-shrink: 0;
  box-sizing: border-box;
  min-height: 136rpx;
  flex-direction: column;
  justify-content: center;
  margin-top: 24rpx;
  padding: 20rpx 28rpx;
  border: 1rpx solid #f3f3f3;
  border-radius: 20rpx;
  background: var(--color-surface-muted);
  color: var(--color-text);
  font-size: 28rpx;
  line-height: 44rpx;
}

.info-card__row {
  display: flex;
  gap: 48rpx;
}

.info-card__count {
  margin-top: 4rpx;
}


/* ─── 工具栏 ─────────────────────────────────────────────────── */

.tools {
  display: flex;
  flex-shrink: 0;
  height: 96rpx;
  margin: 32rpx 16rpx 0;
  gap: 8rpx;
}

.tool {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: var(--color-text);
  border-radius: 14rpx;
  border: 1.5rpx solid transparent;
  transition: background 0.15s ease, border-color 0.15s ease;
}

.tool--disabled {
  opacity: 0.34;
}

.tool__icon {
  width: 40rpx;
  height: 40rpx;
}

.tool__label {
  margin-top: 4rpx;
  font-size: 24rpx;
  font-weight: 500;
  line-height: 36rpx;
  color: var(--color-text-secondary);
}

/* ── 选中态 ── */
.tool--active {
  background: var(--tool-active-bg);
  border-color: var(--tool-active-border);
}

.tool--active .tool__label {
  color: var(--tool-active-accent);
  font-weight: 600;
}


/* ─── 调色板 ─────────────────────────────────────────────────── */

.palette {
  display: flex;
  flex-shrink: 0;
  flex-wrap: wrap;
  row-gap: 16rpx;
  margin: 24rpx 16rpx 0;
}

.palette__slot {
  display: flex;
  width: 12.5%;
  height: 44rpx;
  align-items: center;
  justify-content: center;
}

.palette__color {
  position: relative;
  display: flex;
  box-sizing: border-box;
  width: 44rpx;
  min-width: 44rpx;
  max-width: 44rpx;
  height: 44rpx;
  flex: 0 0 44rpx;
  align-items: center;
  justify-content: center;
  padding: 0;
  border: 1rpx solid rgba(17, 17, 17, 0.08);
  border-radius: 999rpx;
  overflow: hidden;
  line-height: 44rpx;
}

.palette__color--selected {
  border: 2rpx solid var(--color-primary);
  box-shadow: 0 0 0 2rpx #ffffff inset;
}

.palette__check {
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1;
  text-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.28);
}


/* ─── 底部操作 ───────────────────────────────────────────────── */

.editor-actions {
  display: flex;
  flex-shrink: 0;
  gap: 24rpx;
  margin: 32rpx 16rpx 0;
}

.editor-actions__button {
  box-sizing: border-box;
  height: 80rpx;
  min-width: 0;
  flex: 1;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 40rpx;
}

.editor-actions .button-secondary {
  border: 1rpx solid var(--color-primary);
  background: var(--color-surface);
  color: var(--color-primary);
  box-shadow: none;
}

.editor-actions .button-primary {
  border: 1rpx solid var(--color-primary);
  background: var(--color-primary);
  color: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(18, 180, 102, 0.16);
}

.editor-actions .button-secondary:active {
  background: var(--color-primary-soft);
}

.editor-actions .button-primary:active {
  background: var(--color-primary-pressed);
  transform: scale(0.98);
}


/* ─── 放大镜 ─────────────────────────────────────────────────── */

.magnifier-canvas {
  position: fixed;
  z-index: 999;
  width: 140px;
  height: 140px;
  border-radius: 50%;
  overflow: hidden;
  border: 2rpx solid rgba(111, 91, 255, 0.5);
  box-shadow:
    0 8rpx 32rpx rgba(0, 0, 0, 0.22),
    0 2rpx 8rpx rgba(111, 91, 255, 0.18);
  pointer-events: none;
}


/* ─── 取色 Toast ──────────────────────────────────────────────── */

.editor-toast {
  position: fixed;
  bottom: calc(180rpx + env(safe-area-inset-bottom));
  left: 50%;
  transform: translateX(-50%) translateY(16rpx);
  z-index: 1000;
  padding: 12rpx 32rpx;
  border-radius: 999rpx;
  background: rgba(30, 30, 30, 0.82);
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 500;
  line-height: 40rpx;
  white-space: nowrap;
  opacity: 0;
  pointer-events: none;
  transition:
    opacity 0.22s ease,
    transform 0.22s ease;
}

.editor-toast--visible {
  opacity: 1;
  transform: translateX(-50%) translateY(0);
}
