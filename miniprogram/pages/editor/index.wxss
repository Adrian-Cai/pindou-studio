page {
  overflow: hidden;
}

.editor {
  display: flex;
  height: 100vh;
  flex-direction: column;
}

.editor__meta {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 32rpx;
}

.editor__size {
  font-weight: 650;
}

.editor__note {
  color: #918b84;
  font-size: 23rpx;
}

.zoom {
  display: flex;
  height: 56rpx;
  align-items: center;
  overflow: hidden;
  border: 1rpx solid #e6e1db;
  border-radius: 28rpx;
  background: #fff;
}

.zoom__button {
  width: 58rpx;
  padding: 0;
  background: transparent;
  font-size: 28rpx;
  line-height: 56rpx;
}

.zoom__value {
  min-width: 76rpx;
  color: #6d6761;
  font-size: 21rpx;
  text-align: center;
}

.canvas-wrap {
  min-height: 0;
  flex: 1;
  background-color: #eeeae5;
  background-image: linear-gradient(45deg, #e5e0da 25%, transparent 25%),
    linear-gradient(-45deg, #e5e0da 25%, transparent 25%),
    linear-gradient(45deg, transparent 75%, #e5e0da 75%),
    linear-gradient(-45deg, transparent 75%, #e5e0da 75%);
  background-position: 0 0, 0 10rpx, 10rpx -10rpx, -10rpx 0;
  background-size: 20rpx 20rpx;
}

.canvas-stage {
  display: flex;
  width: 920rpx;
  height: 920rpx;
  align-items: center;
  justify-content: center;
}

.pattern {
  display: flex;
  width: 720rpx;
  height: 720rpx;
  flex-wrap: wrap;
  overflow: hidden;
  border: 8rpx solid #fff;
  background: #fff;
  box-shadow: 0 20rpx 56rpx rgba(39, 36, 32, 0.18);
  transform-origin: center;
}

.pattern__cell {
  box-sizing: border-box;
  display: flex;
  width: 8.333333%;
  height: 8.333333%;
  align-items: center;
  justify-content: center;
  border-right: 1rpx solid rgba(255, 255, 255, 0.25);
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.25);
  color: rgba(39, 36, 32, 0.58);
  font-size: 15rpx;
}

.editor__footer {
  flex-shrink: 0;
  padding: 18rpx 24rpx calc(22rpx + env(safe-area-inset-bottom));
  background: #fff;
}

.tools {
  display: flex;
}

.tool {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  color: #918b84;
  font-size: 21rpx;
}

.tool--active {
  color: #ff7043;
  font-weight: 600;
}

.tool__symbol {
  display: flex;
  width: 52rpx;
  height: 44rpx;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}

.editor__done {
  height: 84rpx;
  margin-top: 18rpx;
}
