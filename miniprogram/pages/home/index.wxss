page {
  --color-primary: #12b466;
  --color-primary-pressed: #0f9f5b;
  --color-primary-soft: #ecfaf3;
  --color-primary-gradient-end: #14b668;
  --color-primary-surface: #f4fcf8;
  --color-primary-border: rgba(18, 180, 102, 0.62);
  --color-text: #15151a;
  --color-text-secondary: #626573;
  --color-text-tertiary: #9699a8;
  --color-border: #e9eaf0;
  --color-surface-muted: #f5f6f8;
  --color-disabled: #d8dae2;
  --color-bg: #f8f9fb;
  --color-surface: #ffffff;
  background: var(--color-surface);
}

.page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 0 40rpx calc(160rpx + env(safe-area-inset-bottom));
  color: var(--color-text);
}

.hero {
  max-width: 100%;
  margin-top: 32rpx;
  color: var(--color-text);
  font-size: 42rpx;
  line-height: 60rpx;
  text-align: center;
  white-space: normal;
}

.hero__text {
  font-weight: 600;
}

.hero__accent {
  color: var(--color-primary);
  font-weight: 700;
}

.upload {
  position: relative;
  overflow: hidden;
  box-sizing: border-box;
  margin-top: 32rpx;
  padding: 0;
  border: 2rpx solid var(--color-primary-border);
  border-radius: 16rpx;
  background: var(--color-primary-surface);
  box-shadow: none;
}

.upload--selected {
  background: var(--color-surface);
}

.upload__empty {
  display: flex;
  box-sizing: border-box;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx 24rpx;
  text-align: center;
}

.upload__icon {
  width: 80rpx;
  height: 80rpx;
}

.upload__title {
  margin-top: 8rpx;
  color: var(--color-text);
  font-size: 32rpx;
  font-weight: 600;
  line-height: 48rpx;
}

.upload__hint {
  margin-top: 0;
  color: var(--color-text-secondary);
  font-size: 24rpx;
  line-height: 36rpx;
}

.upload__description {
  max-width: 100%;
  margin-top: 8rpx;
  color: var(--color-text-tertiary);
  font-size: 24rpx;
  line-height: 36rpx;
}

.upload__preview {
  display: block;
  width: 100%;
  height: 280rpx;
  background: var(--color-primary-surface);
}

.upload__remove {
  position: absolute;
  z-index: 2;
  top: 12rpx;
  right: 12rpx;
  display: flex;
  box-sizing: border-box;
  width: 56rpx;
  min-width: 0;
  height: 56rpx;
  align-items: center;
  justify-content: center;
  padding: 0;
  border-radius: 50%;
  background: rgba(24, 27, 24, 0.72);
  color: #fff;
  font-size: 28rpx;
  font-weight: 400;
  line-height: 1;
}

.samples {
  margin-top: 40rpx;
}

.section-label {
  color: var(--color-text);
  font-size: 28rpx;
  font-weight: 500;
  line-height: 44rpx;
}

.samples__grid {
  display: flex;
  gap: 24rpx;
  margin-top: 16rpx;
}

.sample-card {
  position: relative;
  overflow: hidden;
  width: calc((100% - 72rpx) / 4);
  height: 164rpx;
  border-radius: 24rpx;
  background: var(--color-surface-muted);
}

.sample-card__sprite {
  position: absolute;
  width: 864rpx;
  height: 1946rpx;
}

.sample-card__sprite--1 {
  top: -922rpx;
  left: -66rpx;
}

.sample-card__sprite--2 {
  top: -922rpx;
  left: -248rpx;
}

.sample-card__sprite--3 {
  top: -922rpx;
  left: -430rpx;
}

.sample-card__sprite--4 {
  top: -922rpx;
  left: -613rpx;
}

.setting-options {
  margin-top: 48rpx;
}

.option-group--colors {
  margin-top: 48rpx;
}

.option-row {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

.option-button {
  display: flex;
  height: 88rpx;
  min-width: 0;
  flex: 1;
  align-items: center;
  justify-content: center;
  padding: 0;
  border: 1rpx solid var(--color-border);
  border-radius: 16rpx;
  background: var(--color-surface);
  color: var(--color-text);
  font-size: 28rpx;
  font-weight: 500;
  line-height: 44rpx;
}

.option-button--active {
  border-color: var(--color-primary);
  background: var(--color-primary-soft);
  color: var(--color-primary);
}

.option-button:active {
  background: var(--color-primary-soft);
}

.home__submit {
  box-sizing: border-box;
  width: auto;
  height: 88rpx;
  margin: 32rpx 0 0;
  padding: 0;
  border-radius: 16rpx;
  background: linear-gradient(90deg, var(--color-primary), var(--color-primary-gradient-end));
  color: #fff;
  box-shadow: 0 12rpx 32rpx rgba(18, 180, 102, 0.18);
  font-size: 30rpx;
  font-weight: 500;
  line-height: 44rpx;
}

.home__submit:active {
  background: var(--color-primary-pressed);
  transform: scale(0.98);
}

.home__submit[disabled] {
  background: var(--color-disabled);
  box-shadow: none;
  color: #ffffff;
}