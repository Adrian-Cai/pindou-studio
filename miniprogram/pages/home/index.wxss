page {
  --color-bg: #fffdfa;
  background: #fffdfa;
}

.home-page {
  box-sizing: border-box;
  display: flex;
  flex: 1 0 auto;
  flex-direction: column;
  justify-content: space-between;
  padding: 0 40rpx;
  color: #171b19;
}

.home-hero {
  display: block;
  width: calc(100% + 80rpx);
  margin: 0 -40rpx;
}

.home-entry-grid {
  display: flex;
  gap: 18rpx;
  margin: 0 -20rpx 20rpx;
}

.home-entry-card {
  position: relative;
  box-sizing: border-box;
  display: flex;
  min-width: 0;
  min-height: 284rpx;
  flex: 1;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  padding: 24rpx 26rpx;
  overflow: hidden;
  border: 8rpx solid #fff;
  border-radius: 30rpx;
  box-shadow: 0 8rpx 24rpx rgba(30, 60, 44, 0.06);
  transition: transform 150ms ease, opacity 150ms ease;
}

.home-entry-card--image {
  background: linear-gradient(145deg, #effbf4, #f8fffb);
}

.home-entry-card--text {
  background: linear-gradient(145deg, #fffaf0, #fffdf7);
}

.home-entry-card__icon {
  display: flex;
  width: 136rpx;
  height: 136rpx;
  align-items: center;
  justify-content: center;
  margin: 0 auto 16rpx;
}

.home-entry-card__icon image {
  width: 128rpx;
  height: 128rpx;
}

.home-entry-card__title {
  color: #1b211e;
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 31rpx;
  font-weight: 700;
  line-height: 1.4;
  white-space: nowrap;
}

.home-entry-card__desc {
  margin-top: 6rpx;
  color: #747b76;
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 23rpx;
  font-weight: 500;
  line-height: 1.35;
  white-space: nowrap;
}

.home-entry-card__arrow {
  position: absolute;
  top: 48%;
  right: 20rpx;
  display: flex;
  width: 46rpx;
  height: 46rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(18, 180, 102, 0.1);
}

.home-entry-card__arrow::after {
  width: 12rpx;
  height: 12rpx;
  border-right: 5rpx solid #12b466;
  border-bottom: 5rpx solid #12b466;
  content: '';
  transform: rotate(-45deg);
}

.home-entry-card--text .home-entry-card__arrow {
  background: rgba(164, 150, 123, 0.11);
}

.home-entry-card--text .home-entry-card__arrow::after {
  border-color: #898273;
}

.home-entry-card:active {
  opacity: 0.88;
  transform: scale(0.99);
}

.home-process-card {
  position: relative;
  display: flex;
  align-items: center;
  margin: 0 -20rpx;
  padding: 16rpx 18rpx;
  border-radius: 28rpx;
  background: #fff;
  box-shadow: 0 8rpx 24rpx rgba(30, 60, 44, 0.04);
}

.home-process-step {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  color: #252c28;
  font-size: 23rpx;
  font-weight: 600;
}

.home-process-step__icon {
  display: flex;
  width: 156rpx;
  height: 136rpx;
  align-items: center;
  justify-content: center;
}

.home-process-step__icon image {
  width: 100%;
  height: 100%;
  display: block;
}

.home-process-arrow {
  position: absolute;
  top: 50%;
  width: 38rpx;
  height: 38rpx;
  filter: grayscale(1) opacity(0.42);
  transform: translate(-50%, -50%);
}

.home-process-arrow:nth-child(2) {
  left: 34.2%;
}

.home-process-arrow:nth-child(4) {
  left: 65.8%;
}

.home-entry-submit {
  display: flex;
  width: calc(100% + 40rpx) !important;
  height: 98rpx;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  margin: 22rpx -20rpx 0 !important;
  border-radius: 32rpx;
  font-size: 34rpx;
  font-weight: 700;
}

.home-entry-submit__arrow {
  position: relative;
  width: 34rpx;
  height: 34rpx;
  flex-shrink: 0;
}

.home-entry-submit__arrow::after {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 16rpx;
  height: 16rpx;
  border-right: 6rpx solid #fff;
  border-bottom: 6rpx solid #fff;
  content: '';
  transform: translate(-50%, -50%) rotate(-45deg);
}

@media (max-width: 380px) {
  .home-page {
    padding: 0 32rpx;
  }

  .home-hero {
    width: calc(100% + 64rpx);
    margin-right: -32rpx;
    margin-left: -32rpx;
  }

  .home-entry-grid,
  .home-process-card {
    margin-right: -16rpx;
    margin-left: -16rpx;
  }

  .home-entry-submit {
    width: calc(100% + 32rpx) !important;
    margin-right: -16rpx !important;
    margin-left: -16rpx !important;
  }

  .home-entry-card {
    padding-right: 18rpx;
    padding-left: 20rpx;
  }

  .home-entry-card__title {
    font-size: 27rpx;
  }

  .home-entry-card__arrow {
    right: 10rpx;
    width: 38rpx;
    height: 38rpx;
  }

}
