<page-layout title="小露拼豆" home show-main-nav selected-tab="{{0}}">
  <view class="home-page">
    <image class="home-hero" src="/assets/samples/home-hero-banner.jpg" mode="widthFix" aria-label="小露拼豆：让脑海里的灵感，变成拼豆作品" />

    <view class="home-entry-grid">
      <view class="home-entry-card home-entry-card--image" data-source="image" bindtap="openCreation" role="button" aria-label="从图片开始，上传喜欢的图片">
        <view class="home-entry-card__icon"><image src="/assets/icons/home-reference.svg" mode="aspectFit" aria-hidden="true" /></view>
        <view class="home-entry-card__title">从图片开始</view>
        <view class="home-entry-card__desc">上传喜欢的图片</view>
        <view class="home-entry-card__arrow" aria-hidden="true"></view>
      </view>
      <view class="home-entry-card home-entry-card--text" data-source="text" bindtap="openCreation" role="button" aria-label="从想法开始，写下想做的画面">
        <view class="home-entry-card__icon"><image src="/assets/icons/home-idea.svg" mode="aspectFit" aria-hidden="true" /></view>
        <view class="home-entry-card__title">从想法开始</view>
        <view class="home-entry-card__desc">写下想做的画面</view>
        <view class="home-entry-card__arrow" aria-hidden="true"></view>
      </view>
    </view>

    <view class="home-process-card">
      <view class="home-process-step"><view class="home-process-step__icon"><image src="/assets/samples/home-process-inspiration.png" mode="aspectFit" aria-hidden="true" /></view><text>灵感</text></view>
      <image class="home-process-arrow" src="/assets/icons/iconsax/arrow-right.svg" mode="aspectFit" aria-hidden="true" />
      <view class="home-process-step"><view class="home-process-step__icon"><image src="/assets/samples/home-process-reference.png" mode="aspectFit" aria-hidden="true" /></view><text>参考图</text></view>
      <image class="home-process-arrow" src="/assets/icons/iconsax/arrow-right.svg" mode="aspectFit" aria-hidden="true" />
      <view class="home-process-step"><view class="home-process-step__icon"><image src="/assets/samples/home-process-pattern.png" mode="aspectFit" aria-hidden="true" /></view><text>拼豆图</text></view>
    </view>

    <button class="button-primary home-entry-submit" data-source="image" bindtap="openCreation">开始创作 <view class="home-entry-submit__arrow" aria-hidden="true"></view></button>
  </view>
</page-layout>
