<page-layout title="小露拼豆" home show-main-nav selected-tab="{{0}}">
<view class="home-page">

  <!-- ① Hero 主视觉 -->
  <view class="hero">
    <view class="hero-title">上传图片，生成你的拼豆图</view>
    <view class="steps" role="list" aria-label="生成流程">
      <block wx:for="{{generationSteps}}" wx:key="id">
        <view
          class="step {{currentStep === item.id ? 'step--active' : ''}} {{currentStep > item.id ? 'step--complete' : ''}}"
          role="listitem"
        >
          <view class="step-number"><image wx:if="{{currentStep > item.id}}" src="/assets/icons/iconsax/check.svg" mode="aspectFit"/><text wx:else>{{item.id}}</text></view>
          <text>{{item.label}}</text>
        </view>
        <view wx:if="{{index < generationSteps.length - 1}}" class="step-line" aria-hidden="true"></view>
      </block>
    </view>
  </view>

  <!-- ② 统一上传状态卡 -->
  <upload-status-card
    sourceImagePath="{{sourceImagePath}}"
    choosing="{{choosing}}"
    uploadStatus="{{uploadStatus}}"
    uploadProgress="{{uploadProgress}}"
    bind:chooseimage="chooseImage"
    bind:previewerror="handlePreviewError"
  />

  <!-- ③ 生成方式 -->
  <view class="section-block">
    <view class="section-label">生成方式</view>
    <view class="mode-cards" role="radiogroup" aria-label="生成方式">
      <view
        wx:for="{{generationModes}}"
        wx:key="id"
        class="mode-card {{generationMode === item.id ? 'mode-card--active mode-card--active-' + item.id : ''}}"
        data-mode="{{item.id}}"
        bindtap="selectMode"
        role="radio"
        aria-checked="{{generationMode === item.id}}"
        aria-label="{{item.title}}，{{item.description}}"
      >
        <!-- 右上角 badge -->
        <view
          wx:if="{{item.badge}}"
          class="mode-card__badge mode-card__badge--{{item.id}}"
        >{{item.badge}}</view>

        <!-- 右上角选中对勾 -->
        <view
          wx:if="{{generationMode === item.id}}"
          class="mode-card__check mode-card__check--{{item.id}}"
        ><image src="/assets/icons/iconsax/check.svg" mode="aspectFit" /></view>

        <!-- 图标 -->
        <image class="mode-card__icon" src="{{item.icon}}" mode="aspectFit" />

        <!-- 文字 -->
        <view class="mode-card__content">
          <view class="mode-card__title mode-card__title--{{generationMode === item.id ? item.id : ''}}">{{item.title}}</view>
          <view class="mode-card__desc mode-card__desc--{{generationMode === item.id ? item.id : ''}}">{{item.description}}</view>
        </view>
      </view>
    </view>

    <view
      wx:if="{{generationMode === 'ai'}}"
      class="ai-compliance-notice"
      role="note"
      aria-label="当前生成结果由人工智能生成"
    >
      当前生成结果由人工智能生成
    </view>

  </view>

  <!-- ④ 示例图片 -->
  <view class="section-block">
    <view class="section-label">示例图片</view>
    <view class="samples__grid">
      <view
        wx:for="{{sampleImages}}"
        wx:key="src"
        class="sample-card"
      >
        <view class="sample-card__media">
          <image
            class="sample-card__image"
            src="{{item.src}}"
            mode="aspectFill"
            aria-label="{{item.alt}}"
          />
        </view>
        <view class="sample-card__label sample-card__label--{{item.mode}}">{{item.label}}</view>
      </view>
    </view>
  </view>

  <!-- ⑤ 尺寸选择 & 颜色数量 -->
  <view class="setting-options">
    <view class="option-group">
      <view class="section-label">尺寸选择</view>
      <view class="option-row option-row--sizes">
        <button
          wx:for="{{sizeOptions}}"
          wx:key="*this"
          class="option-button {{settings.width === item ? 'option-button--active' : ''}}"
          data-value="{{item}}"
          bindtap="selectSize"
        >{{item}}×{{item}}</button>
      </view>
    </view>

    <view class="option-group option-group--colors">
      <view class="section-label">颜色数量</view>
      <view class="option-row">
        <button
          wx:for="{{colorOptions}}"
          wx:key="*this"
          class="option-button {{settings.colorLimit === item ? 'option-button--active' : ''}}"
          data-value="{{item}}"
          bindtap="selectColor"
        >{{item}}色</button>
      </view>
    </view>
  </view>

  <!-- ⑥ 开始生成 -->
  <button
    class="button-primary home__submit"
    style="width: 100%;"
    bindtap="startCreating"
    disabled="{{generating || uploadStatus === 'uploading' || uploadStatus === 'checking' || uploadStatus === 'rejected' || uploadStatus === 'error'}}"
    aria-label="开始生成"
  >
    开始生成
  </button>

</view>
</page-layout>
