<page-layout title="一起拼豆吧" home show-main-nav compact-bottom-padding selected-tab="{{0}}">
<view class="page">
  <view class="hero">
    <text class="hero__text">把喜欢的图片，变成</text><text class="hero__accent">拼豆作品</text>
  </view>

  <view class="upload {{sourceImagePath ? 'upload--selected' : ''}}">
    <view
      wx:if="{{sourceImagePath}}"
      class="upload__preview-wrap"
      style="width:{{previewWidth}}rpx;height:{{previewHeight}}rpx;"
      bindtap="chooseImage"
    >
      <image class="upload__preview" src="{{sourceImagePath}}" mode="aspectFit" bindload="handlePreviewLoad" binderror="handlePreviewError" />
      <view
        class="upload__remove"
        catchtap="clearImage"
        role="button"
        aria-label="移除图片"
      >×</view>
    </view>
    <button
      wx:else
      class="upload__empty"
      bindtap="chooseImage"
      disabled="{{choosing}}"
      aria-label="选择一张图片"
    >
      <image class="upload__icon" src="/assets/icons/image-upload.svg" mode="aspectFit" />
      <view class="upload__title">上传图片</view>
      <view class="upload__hint">支持 JPG / PNG / WEBP</view>
      <view class="upload__description">上传后自动生成拼豆图</view>
    </button>
  </view>

  <view class="samples">
    <view class="section-label">示例图片</view>
    <view class="samples__grid">
      <view class="sample-card">
        <image class="sample-card__sprite sample-card__sprite--1" src="/assets/reference/home-reference.png" />
      </view>
      <view class="sample-card">
        <image class="sample-card__sprite sample-card__sprite--2" src="/assets/reference/home-reference.png" />
      </view>
      <view class="sample-card">
        <image class="sample-card__sprite sample-card__sprite--3" src="/assets/reference/home-reference.png" />
      </view>
      <view class="sample-card">
        <image class="sample-card__sprite sample-card__sprite--4" src="/assets/reference/home-reference.png" />
      </view>
    </view>
  </view>
  <view class="setting-options">
    <view class="option-group">
      <view class="section-label">尺寸选择</view>
      <view class="option-row option-row--sizes">
        <button
          wx:for="{{sizeOptions}}"
          wx:key="*this"
          class="option-button {{settings.width === item ? 'option-button--active' : ''}}"
          data-value="{{item}}"
          bindtap="selectSize"
        >{{item}}×{{item}}</button>
      </view>
    </view>

    <view class="option-group option-group--colors">
      <view class="section-label">颜色数量</view>
      <view class="option-row">
        <button
          wx:for="{{colorOptions}}"
          wx:key="*this"
          class="option-button {{settings.colorLimit === item ? 'option-button--active' : ''}}"
          data-value="{{item}}"
          bindtap="selectColor"
        >{{item}}色</button>
      </view>
    </view>
  </view>
  <view class="button-primary home__submit" role="button" bindtap="startCreating">
    开始生成
  </view>
</view>

</page-layout>
