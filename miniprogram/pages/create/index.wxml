<page-layout title="小露拼豆" back show-main-nav selected-tab="{{0}}" fill-viewport="{{creationSource === 'text'}}">
  <view class="home-page {{creationSource === 'text' ? 'home-page--text' : ''}}">
    <view class="creation-source-tabs" role="tablist" aria-label="创作方式">
      <view class="creation-source-tab {{creationSource === 'image' ? 'creation-source-tab--active' : ''}}" data-source="image" bindtap="selectCreationSource" role="tab" aria-selected="{{creationSource === 'image'}}">
        <image class="creation-source-tab__icon" src="/assets/icons/upload-cloud.svg" mode="aspectFit" aria-hidden="true" />
        <text>上传图片</text>
      </view>
      <view class="creation-source-tab {{creationSource === 'text' ? 'creation-source-tab--active' : ''}}" data-source="text" bindtap="selectCreationSource" role="tab" aria-selected="{{creationSource === 'text'}}">
        <image class="creation-source-tab__icon creation-source-tab__icon--idea" src="/assets/icons/iconsax/edit-2.svg" mode="aspectFit" aria-hidden="true" />
        <text>描述想法</text>
      </view>
    </view>

    <view wx:if="{{creationSource === 'image'}}" class="home-form-section">
      <upload-status-card
        sourceImagePath="{{sourceImagePath}}"
        choosing="{{choosing}}"
        uploadStatus="{{uploadStatus}}"
        uploadProgress="{{uploadProgress}}"
        bind:chooseimage="chooseImage"
        bind:removeimage="removeImage"
        bind:previewerror="handlePreviewError"
      />

      <view class="section-block">
        <view class="section-label">
          <text>生成方式</text>
          <view class="generation-tips-trigger-slot">
            <button class="generation-tips-trigger {{generationTipsOpen ? 'generation-tips-trigger--open' : ''}}" bindtap="toggleGenerationTips" aria-label="{{generationTipsOpen ? '收起生成方式说明' : '查看生成方式说明'}}" aria-expanded="{{generationTipsOpen}}" aria-controls="generation-tips"><view class="generation-tips-trigger__icon">?</view></button>
          </view>
        </view>
        <view wx:if="{{generationTipsOpen}}" id="generation-tips" class="generation-tips" role="tooltip">
          <view wx:for="{{generationModes}}" wx:key="id" class="generation-tip">
            <text class="generation-tip__label generation-tip__label--{{item.id}}">{{item.tipTitle}}:</text>
            <view class="generation-tip__content"><text wx:for="{{item.tips}}" wx:key="*this" class="generation-tip__line">{{item}}</text></view>
          </view>
        </view>
        <view class="mode-cards" role="radiogroup" aria-label="生成方式">
          <view wx:for="{{generationModes}}" wx:key="id" class="mode-card mode-card--{{item.id}} {{generationMode === item.id ? 'mode-card--active mode-card--active-' + item.id : ''}}" data-mode="{{item.id}}" bindtap="selectMode" role="radio" aria-checked="{{generationMode === item.id}}" aria-label="{{item.title}}">
            <view wx:if="{{item.badge}}" class="mode-card__badge mode-card__badge--{{item.id}}">{{item.badge}}</view>
            <view wx:if="{{generationMode === item.id}}" class="mode-card__check mode-card__check--{{item.id}}"><image src="/assets/icons/iconsax/check.svg" mode="aspectFit" /></view>
            <image class="mode-card__icon" src="{{item.icon}}" mode="aspectFit" />
            <view class="mode-card__content"><view class="mode-card__title mode-card__title--{{item.id}}">{{item.title}}</view></view>
          </view>
        </view>
      </view>

      <view class="section-block">
        <view wx:if="{{generationMode === 'standard'}}" class="section-label">标准模式效果</view>
        <view wx:if="{{generationMode === 'standard'}}" class="standard-example">
          <view class="standard-example__media">
            <image class="standard-example__image" src="/assets/samples/home-standard-example.jpg" mode="aspectFit" aria-label="原图转换为标准拼豆网格前后对照" />
          </view>
        </view>
        <block wx:elif="{{generationMode === 'ai'}}">
          <view class="section-label">AI 效果风格</view>
          <view class="ai-style-cards" role="radiogroup" aria-label="AI 效果风格">
            <view wx:for="{{aiStyles}}" wx:key="id" class="ai-style-option {{aiStyle === item.id ? 'ai-style-option--active' : ''}}" data-style="{{item.id}}" bindtap="selectAiStyle" role="radio" aria-checked="{{aiStyle === item.id}}" aria-label="{{item.label}}">
              <image class="ai-style-option__icon" src="{{item.icon}}" mode="aspectFit" />
              <text class="ai-style-option__label">{{item.label}}</text>
              <view wx:if="{{aiStyle === item.id}}" class="ai-style-option__check"><image src="/assets/icons/iconsax/check.svg" mode="aspectFit" /></view>
            </view>
          </view>

          <view class="section-label ai-example-heading">效果示例</view>
          <view class="ai-example-card">
            <view class="ai-example-card__item">
              <image class="ai-example-card__image" src="/assets/samples/home-ai-source.jpg" mode="aspectFill" aria-label="AI 风格转换原图" />
              <text class="ai-example-card__label">原图</text>
            </view>
            <image class="ai-example-card__arrow" src="/assets/icons/iconsax/arrow-right.svg" mode="aspectFit" aria-hidden="true" />
            <view wx:for="{{aiStyles}}" wx:for-item="styleItem" wx:key="id" wx:if="{{aiStyle === styleItem.id}}" class="ai-example-card__item">
              <image class="ai-example-card__image" src="{{styleItem.exampleImage}}" mode="aspectFill" aria-label="{{styleItem.label}}效果示例" />
              <text class="ai-example-card__label">{{styleItem.label}}效果</text>
            </view>
          </view>
        </block>
      </view>

      <view class="setting-options">
        <view class="setting-options__header">
          <view class="section-label">图纸参数</view>
          <button class="setting-options__toggle" bindtap="toggleSettings" aria-expanded="{{settingsExpanded}}" aria-label="{{settingsExpanded ? '收起图纸参数' : '展开图纸参数'}}">
            <text>{{settings.width}}×{{settings.height}} · {{settings.colorLimit}}色</text>
            <view class="setting-options__chevron {{settingsExpanded ? 'setting-options__chevron--expanded' : ''}}" aria-hidden="true"></view>
          </button>
        </view>
        <view wx:if="{{settingsExpanded}}" class="setting-options__body">
          <view class="option-group">
            <view class="option-group__label">尺寸</view>
            <view class="option-row option-row--sizes"><button wx:for="{{sizeOptions}}" wx:key="*this" class="option-button {{settings.width === item ? 'option-button--active' : ''}}" data-value="{{item}}" bindtap="selectSize">{{item}}×{{item}}</button></view>
          </view>
          <view class="option-group option-group--colors">
            <view class="option-group__label">颜色数量</view>
            <view class="option-row"><button wx:for="{{colorOptions}}" wx:key="*this" class="option-button {{settings.colorLimit === item ? 'option-button--active' : ''}}" data-value="{{item}}" bindtap="selectColor">{{item}}色</button></view>
          </view>
        </view>
      </view>

      <button class="button-primary home__submit" style="width: 100%;" bindtap="startCreating" disabled="{{generating || submitting || uploadStatus === 'uploading' || uploadStatus === 'checking' || uploadStatus === 'rejected' || uploadStatus === 'error'}}" loading="{{generating || submitting}}">{{generating ? '正在生成' : (submitting ? '正在准备生成' : (generationMode === 'ai' ? (aiStyle === 'kawaii' ? '生成 Q版拼豆图' : (aiStyle === 'cartoon' ? '生成卡通拼豆图' : '生成极简拼豆图')) : '生成拼豆图'))}}</button>
    </view>

    <view wx:elif="{{creationSource === 'text'}}" class="home-form-section home-form-section--text">
      <view class="text-card">
        <view class="text-card__heading"><text>描述你想生成的画面</text><button class="text-action text-action--muted" bindtap="clearPrompt" disabled="{{creatingText}}" aria-label="清空描述">清空<image class="text-action__icon" src="/assets/icons/iconsax/close-circle.svg" mode="aspectFit" /></button></view>
        <textarea wx:if="{{!sizeSheetOpen}}" class="text-prompt-card__input" value="{{prompt}}" maxlength="500" disabled="{{creatingText}}" placeholder="描述主体、场景、风格和颜色…" placeholder-class="text-prompt-card__placeholder" bindinput="changePrompt" aria-label="描述你想生成的画面" />
        <view wx:else class="text-prompt-card__input text-prompt-card__placeholder">{{prompt || '描述主体、场景、风格和颜色…'}}</view>
        <view class="text-prompt-card__footer"><text>最多 500 字</text><text>{{promptLength}} / 500</text></view>
      </view>
      <view class="text-card">
        <view class="text-card__heading"><view class="text-card__title"><image class="text-card__icon" src="/assets/icons/mode-ai-sparkle.svg" mode="aspectFit" /><text>AI 灵感</text></view><button class="text-action" bindtap="refreshInspirations" disabled="{{inspirationLoading}}" loading="{{inspirationLoading}}">换一换</button></view>
        <view wx:if="{{inspirationLoading}}" class="text-status" aria-role="status">AI 正在寻找新灵感…</view>
        <view wx:elif="{{inspirationError}}" class="text-status" aria-role="alert">{{inspirationError}}</view>
        <view wx:else class="text-inspirations"><button wx:for="{{inspirations}}" wx:key="prompt" class="text-inspiration" data-index="{{index}}" bindtap="useInspiration" disabled="{{creatingText}}">{{item.title}}</button></view>
      </view>
      <button class="text-card text-size-trigger" style="width: 100%;" bindtap="openTextSizes" disabled="{{creatingText || textOptionsLoading}}" aria-label="选择图片尺寸">
        <image class="text-card__icon" src="/assets/icons/iconsax/gallery.svg" mode="aspectFit" />
        <view class="text-size-trigger__content"><text class="text-card__title">图片尺寸</text><text class="text-size-trigger__value">{{textOptionsLoading ? '正在读取尺寸…' : (textOptionsError || textSize)}}</text></view>
        <text class="text-size-trigger__select">选择</text><image class="text-action__icon" src="/assets/icons/iconsax/arrow-right.svg" mode="aspectFit" />
      </button>
      <view class="text-generation-footer">
        <view class="text-cost">生成成功消耗 {{textCost}} 次 AI 额度 · {{aiRemaining === null ? '余额暂未读取' : '剩余 ' + aiRemaining + ' 次'}}<text>失败不扣费，描述会经过安全检查</text></view>
        <button class="button-primary home__submit text-submit" style="width: 100%; background: {{creatingText || !promptLength || !textSizes.length || textOptionsLoading ? '#d8dae2' : '#12b466'}}; color: #fff; border-radius: 48rpx;" bindtap="startTextGeneration" disabled="{{creatingText || !promptLength || !textSizes.length || textOptionsLoading}}" loading="{{creatingText}}">{{creatingText ? '正在创建任务' : '生成灵感图'}}</button>
        <view class="text-save-hint">生成结果可在作品中继续查看和制作</view>
      </view>
    </view>
  </view>
</page-layout>
<view wx:if="{{sizeSheetOpen}}" class="text-size-mask" catchtap="closeTextSizes" catchtouchmove="preventSheetClose">
  <view class="text-size-sheet" catchtap="preventSheetClose" role="dialog" aria-label="选择图片尺寸">
    <view class="text-size-sheet__handle"></view>
    <view class="text-card__heading"><text>选择图片尺寸</text><button class="text-action text-action--muted" bindtap="closeTextSizes" aria-label="关闭尺寸选择">关闭</button></view>
    <scroll-view class="text-size-sheet__scroll" scroll-y>
      <view class="text-size-options"><button wx:for="{{textSizes}}" wx:key="*this" class="text-size-option {{pendingTextSize === item ? 'text-size-option--active' : ''}}" data-size="{{item}}" bindtap="selectTextSize" role="radio" aria-checked="{{pendingTextSize === item}}">{{item}}</button></view>
    </scroll-view>
    <button class="button-primary home__submit text-submit" style="width: 100%; background: #12b466; color: #fff; border-radius: 48rpx;" bindtap="confirmTextSize">使用此尺寸</button>
  </view>
</view>
