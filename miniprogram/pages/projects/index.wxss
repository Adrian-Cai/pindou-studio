@import "../../styles/profile-pages.wxss";

.project-summary { display: flex; padding: 32rpx 20rpx; }
.project-summary__item { display: flex; min-width: 0; flex: 1; align-items: center; justify-content: center; gap: 18rpx; }
.project-summary__icon { font-size: 48rpx; }
.project-summary__icon--green { color: var(--color-primary); }
.project-summary__icon--blue { color: #2d84f5; }
.project-summary__icon--yellow { color: #f4b223; }
.project-summary__label { font-size: 25rpx; white-space: nowrap; }
.project-summary__value { margin-top: 2rpx; font-size: 40rpx; font-weight: 600; }
.project-summary__value--green { color: var(--color-primary); }
.project-summary__line { width: 1rpx; height: 80rpx; align-self: center; background: var(--color-border); }

.project-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24rpx; margin-top: 24rpx; }
.project-card { display: grid; min-width: 0; grid-template-columns: 46% minmax(0, 1fr); overflow: hidden; padding: 20rpx; }
.project-card__cover { width: 100%; height: 100%; min-height: 244rpx; border-radius: var(--radius-media); background: var(--color-surface-muted); }
.project-card__body { min-width: 0; padding-left: 20rpx; }
.project-card__top { display: flex; align-items: center; justify-content: space-between; }
.project-card__more { display: flex; width: 52rpx; height: 52rpx; align-items: center; justify-content: center; border: 1rpx solid var(--color-border); border-radius: 50%; font-size: 18rpx; letter-spacing: 1rpx; }
.project-card__title { overflow: hidden; margin-top: 28rpx; font-size: 29rpx; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
.project-card__meta, .project-card__date { margin-top: 12rpx; color: var(--color-text-secondary); font-size: 22rpx; white-space: nowrap; }
.project-card__date { color: var(--color-text-tertiary); }
.project-card__continue { display: flex; height: 54rpx; align-items: center; justify-content: center; margin-top: 20rpx; border: 2rpx solid var(--color-primary); border-radius: var(--radius-control); color: var(--color-primary); font-size: 23rpx; }

@media (max-width: 380px) {
  .project-summary__icon { display: none; }
  .project-grid { grid-template-columns: 1fr; }
  .project-card { grid-template-columns: 42% minmax(0, 1fr); }
}
