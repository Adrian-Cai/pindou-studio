@import "../../styles/profile-pages.wxss";

.project-summary { display: flex; padding: 28rpx 12rpx; }
.project-summary__item { display: flex; min-width: 0; flex: 1; align-items: center; justify-content: center; gap: 14rpx; padding: 0 8rpx; }
.project-summary__icon { width: 44rpx; height: 44rpx; flex-shrink: 0; }
.project-summary__content { min-width: 0; }
.project-summary__label { color: var(--color-text-secondary); font-size: 24rpx; line-height: 32rpx; white-space: nowrap; }
.project-summary__value { margin-top: 2rpx; color: var(--color-text); font-size: 40rpx; font-weight: 700; line-height: 48rpx; }
.project-summary__value--green { color: var(--color-primary); }
.project-summary__line { width: 1rpx; height: 72rpx; align-self: center; background: var(--color-border); }

.project-list { display: flex; width: 100%; flex-direction: column; gap: var(--space-3); margin-top: var(--space-3); }
.project-card { display: flex; box-sizing: border-box; width: 100%; min-width: 0; min-height: 256rpx; align-items: stretch; gap: var(--space-3); padding: var(--space-3); }
.project-card__cover-wrap { position: relative; width: 208rpx; height: 208rpx; flex: 0 0 208rpx; overflow: hidden; border-radius: var(--radius-media); background: var(--color-surface-muted); }
.project-card__cover { width: 100%; height: 100%; }
/* AI 态封面遮罩：绝对定位叠加，不影响卡片布局高度 */
.project-card__overlay { position: absolute; top: 0; right: 0; bottom: 0; left: 0; display: flex; align-items: center; justify-content: center; background: rgba(0, 0, 0, 0.38); }
.project-card__overlay--failed { background: rgba(0, 0, 0, 0.48); }
.project-card__overlay-text { color: #fff; font-size: 30rpx; font-weight: 600; line-height: 40rpx; }
.project-card__body { display: flex; width: 0; min-width: 0; flex: 1; flex-direction: column; align-self: stretch; justify-content: flex-start; }
.project-card__header { display: flex; min-width: 0; align-items: flex-start; justify-content: space-between; gap: 16rpx; }
.project-card__info { min-width: 0; flex: 1; }
.project-card__title { min-width: 0; overflow: hidden; font-size: 32rpx; font-weight: 600; line-height: 44rpx; text-overflow: ellipsis; white-space: nowrap; }
.project-card .status-pill { box-sizing: border-box; height: 36rpx; flex-shrink: 0; padding: 0 12rpx; font-size: 20rpx; line-height: 36rpx; }
.project-card .status-pill--danger { background: var(--color-danger-soft, #fee2e2); color: var(--color-danger, #ef4444); }
.project-card__meta { margin-top: 8rpx; color: var(--color-text-secondary); font-size: 24rpx; line-height: 32rpx; white-space: nowrap; }
.project-card__date { margin-top: 6rpx; color: var(--color-text-tertiary); font-size: 24rpx; line-height: 32rpx; white-space: nowrap; }
.project-card__failure { margin-top: 6rpx; color: var(--color-danger); font-size: 24rpx; line-height: 32rpx; }
.project-card__taskline { display: flex; min-width: 0; flex-direction: row; flex-wrap: nowrap; align-items: center; gap: 12rpx; margin-top: 8rpx; font-size: 24rpx; line-height: 32rpx; }
.project-card__taskline-text { flex-shrink: 0; color: var(--color-text-tertiary); }
.project-card__taskline-link { flex-shrink: 0; color: var(--color-primary); }
.project-card__taskline-link--danger { color: var(--color-danger); }
.project-card__taskline-link:active { opacity: 0.6; }
.project-card__continue { display: flex; box-sizing: border-box; height: 88rpx; align-items: center; align-self: flex-end; justify-content: center; gap: var(--space-1); margin-top: var(--space-2); padding: 0 var(--space-2); border: 0; border-radius: var(--radius-card-small); background: transparent; box-shadow: var(--shadow-ghost); color: var(--color-primary); font-size: 24rpx; line-height: 1; transition: var(--transition-press); }
.project-card__continue-icon { width: 28rpx; height: 28rpx; }
.project-card__continue:active { background: var(--strong-overlay); transform: scale(0.97); }

.project-card__actions-inline { display: flex; box-sizing: border-box; width: 100%; min-width: 0; flex-direction: row; flex-wrap: nowrap; align-items: center; margin-top: auto; padding-top: 16rpx; }
.project-card__action-inline { display: flex; box-sizing: border-box; min-width: 0; height: 48rpx; flex: 1 1 0; align-items: center; justify-content: center; gap: 8rpx; color: var(--color-text-secondary); font-size: 24rpx; line-height: 1; white-space: nowrap; transition: var(--transition-press); }
.project-card__action-icon { width: 28rpx; height: 28rpx; flex-shrink: 0; }
.project-card__action-inline:active { background: var(--strong-overlay); transform: scale(0.97); }
.project-card__action-inline--danger { color: var(--color-danger); }
.project-card__action-inline--danger:active { background: var(--color-danger-soft); }

.rename-dialog-mask { position: fixed; z-index: 300; display: flex; inset: 0; align-items: center; justify-content: center; padding: 40rpx; background: rgba(0, 0, 0, 0.35); animation: overlay-fade-in 180ms ease-out; }

.rename-dialog { box-sizing: border-box; width: 100%; max-width: 640rpx; padding: 40rpx; border-radius: var(--radius-card-large); background: var(--color-surface); box-shadow: 0 24rpx 80rpx rgba(0, 0, 0, 0.2), var(--shadow-card); animation: dialog-scale-in 180ms ease-out; }
.rename-dialog__title { font-size: 34rpx; font-weight: 600; line-height: 48rpx; text-align: center; }
.rename-dialog__input { box-sizing: border-box; width: 100%; height: 88rpx; margin-top: 32rpx; padding: 0 24rpx; border: 2rpx solid var(--color-border); border-radius: var(--radius-control); background: var(--color-bg); font-size: 28rpx; }
.rename-dialog__input:focus { border-color: var(--color-primary); background: var(--color-surface); }
.rename-dialog__feedback { display: flex; min-height: 34rpx; align-items: flex-start; justify-content: space-between; gap: 16rpx; margin-top: 10rpx; color: var(--color-text-tertiary); font-size: 21rpx; line-height: 32rpx; }
.rename-dialog__error { flex: 1; color: var(--color-danger); }
.rename-dialog__buttons { display: flex; box-sizing: border-box; width: 100%; align-items: center; gap: 16rpx; margin-top: 24rpx; }
.rename-dialog__button { display: flex; box-sizing: border-box; width: auto; min-width: 0; flex: 1 1 0; height: 88rpx; align-items: center; justify-content: center; margin: 0; padding: 0; border: 0; border-radius: var(--radius-card-small); font-size: 28rpx; font-weight: 600; line-height: 1; box-shadow: none; transition: var(--transition-press); }
.rename-dialog__button::after { border: 0; }
.rename-dialog__button:active { transform: scale(0.97); opacity: 0.88; }
.rename-dialog__button--cancel { background: var(--color-surface); color: var(--color-text); box-shadow: inset 0 0 0 1rpx var(--color-border); }
.rename-dialog__button--save { background: var(--color-primary); color: #fff; }
.rename-dialog__button--save[disabled] { background: var(--color-primary-soft); color: var(--color-text-tertiary); }

@keyframes overlay-fade-in { from { opacity: 0; } to { opacity: 1; } }
@keyframes dialog-scale-in { from { opacity: 0; transform: scale(0.96); } to { opacity: 1; transform: scale(1); } }

@media (max-width: 380px) {
  .project-summary { padding-right: 4rpx; padding-left: 4rpx; }
  .project-summary__item { gap: 10rpx; padding-right: 4rpx; padding-left: 4rpx; }
  .project-summary__icon { width: 40rpx; height: 40rpx; }
  .project-summary__label { font-size: 22rpx; }
  .project-summary__value { font-size: 36rpx; line-height: 44rpx; }
  .project-card { min-height: 240rpx; gap: var(--space-2); padding: var(--space-2); }
  .project-card__cover-wrap { width: 192rpx; height: 192rpx; flex-basis: 192rpx; }
  .project-card__title { font-size: 30rpx; line-height: 40rpx; }
  .project-card__meta, .project-card__date, .project-card__failure, .project-card__taskline { font-size: 22rpx; line-height: 30rpx; }
  .project-card__action-inline { font-size: 22rpx; gap: 4rpx; }
  .project-card__action-icon { width: 24rpx; height: 24rpx; }
}
