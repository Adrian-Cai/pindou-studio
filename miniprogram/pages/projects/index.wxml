<page-layout title="我的作品" showMainNav="{{showPageNav}}" selectedTab="1">
  <view class="subpage projects-page">
    <view class="project-summary ui-card">
      <view class="project-summary__item">
        <image class="project-summary__icon" src="/assets/icons/iconsax/gallery.svg" mode="aspectFit" aria-hidden="true" />
        <view class="project-summary__content"><view class="project-summary__label">全部作品</view><view class="project-summary__value project-summary__value--green">{{allWorks.length}}</view></view>
      </view>
      <view class="project-summary__line"></view>
      <view class="project-summary__item">
        <image class="project-summary__icon" src="/assets/icons/iconsax/clock.svg" mode="aspectFit" aria-hidden="true" />
        <view class="project-summary__content"><view class="project-summary__label">最近更新</view><view class="project-summary__value">{{recentCount}}</view></view>
      </view>
      <view class="project-summary__line"></view>
      <view class="project-summary__item">
        <image class="project-summary__icon" src="/assets/icons/iconsax/document-text.svg" mode="aspectFit" aria-hidden="true" />
        <view class="project-summary__content"><view class="project-summary__label">草稿</view><view class="project-summary__value">{{draftCount}}</view></view>
      </view>
    </view>

    <view class="search-row">
      <view class="search-box">
        <image class="search-box__icon" src="/assets/icons/iconsax/search.svg" mode="aspectFit" aria-hidden="true" />
        <input class="search-box__input" placeholder-class="search-box__placeholder" placeholder="搜索作品名称" value="{{query}}" bindinput="changeSearch" />
      </view>
      <view class="filter-button" bindtap="showFilter"><image class="filter-button__symbol" src="/assets/icons/iconsax/filter.svg" mode="aspectFit" aria-hidden="true" /><text>筛选</text></view>
    </view>

    <view class="segmented">
      <view
        class="segmented__item {{activeTab === item.id ? 'segmented__item--active' : ''}}"
        wx:for="{{tabs}}"
        wx:key="id"
        data-tab="{{item.id}}"
        bindtap="changeTab"
      >{{item.label}}</view>
    </view>

    <view wx:if="{{works.length}}" class="project-list">
      <view
        class="project-card ui-card"
        wx:for="{{works}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="openWork"
        aria-role="button"
        aria-label="查看作品 {{item.title}}"
      >
        <image class="project-card__cover" src="{{item.coverPath}}" data-id="{{item.id}}" mode="aspectFill" binderror="handleCoverError" />
        <view class="project-card__body">
          <view class="project-card__header">
            <view class="project-card__info">
              <view class="project-card__title">{{item.title}}</view>
              <view class="project-card__meta">{{item.dimensions}} · {{item.colorCount}}色</view>
              <view class="project-card__date">{{item.updatedText}}</view>
            </view>
            <text class="status-pill {{item.isAiGenerating ? 'status-pill--ai-generating' : (item.isAiFailed ? 'status-pill--danger' : (item.isDraft ? 'status-pill--draft' : ''))}}">{{item.statusLabel}}</text>
            <text wx:if="{{item.syncLabel}}" class="status-pill status-pill--draft">{{item.syncLabel}}</text>
          </view>
          <view wx:if="{{!item.isAiGenerating && !item.isAiFailed}}" class="project-card__actions-inline" catchtap="stopPropagation" aria-label="{{item.title}} 的操作">
            <view class="project-card__action-inline" data-id="{{item.id}}" catchtap="startRename" aria-role="button" aria-label="重命名作品 {{item.title}}">
              <image class="project-card__action-icon" src="/assets/icons/iconsax/edit-2.svg" mode="aspectFit" aria-hidden="true" />
              <text>重命名</text>
            </view>
            <view class="project-card__action-inline" data-id="{{item.id}}" catchtap="downloadWork" aria-role="button" aria-label="下载作品 {{item.title}}">
              <image class="project-card__action-icon" src="/assets/icons/iconsax/download.svg" mode="aspectFit" aria-hidden="true" />
              <text>下载</text>
            </view>
            <view class="project-card__action-inline project-card__action-inline--danger" data-id="{{item.id}}" catchtap="deleteWork" aria-role="button" aria-label="删除作品 {{item.title}}">
              <image class="project-card__action-icon" src="/assets/icons/iconsax/trash.svg" mode="aspectFit" aria-hidden="true" />
              <text>删除</text>
            </view>
          </view>
          <view wx:else class="project-card__actions-inline" catchtap="stopPropagation" aria-label="{{item.title}} 的操作">
            <view class="project-card__action-inline project-card__action-inline--danger" data-id="{{item.id}}" catchtap="deleteWork" aria-role="button" aria-label="取消任务 {{item.title}}">
              <image class="project-card__action-icon" src="/assets/icons/iconsax/trash.svg" mode="aspectFit" aria-hidden="true" />
              <text>取消任务</text>
            </view>
          </view>
          <view
            wx:if="{{item.isDraft}}"
            class="project-card__continue"
            data-id="{{item.id}}"
            catchtap="editWork"
            aria-role="button"
            aria-label="{{item.isAiGenerating ? '查看进度' : (item.isAiFailed ? '查看重试' : '继续编辑')}} {{item.title}}"
          >
            <image class="project-card__continue-icon" src="{{item.isAiGenerating ? '/assets/icons/iconsax/clock.svg' : '/assets/icons/iconsax/edit-2.svg'}}" mode="aspectFit" aria-hidden="true" />
            <text>{{item.isAiGenerating ? '查看进度' : (item.isAiFailed ? '查看重试' : '继续编辑')}}</text>
          </view>
        </view>
      </view>
    </view>

    <view wx:else class="empty-state">
      <image class="empty-state__icon" src="/assets/icons/project-empty.svg" mode="aspectFit" />
      <view class="empty-state__title">{{loading ? '正在读取作品' : (allWorks.length ? '没有匹配的作品' : '还没有作品')}}</view>
      <view class="empty-state__desc">{{loading ? '正在同步云端数据，请稍候' : (allWorks.length ? '换个关键词或筛选条件试试' : '从一张喜欢的图片开始，做出你的第一份拼豆图纸')}}</view>
      <button wx:if="{{!loading && !allWorks.length}}" class="button-primary empty-state__button" bindtap="createNew">开始制作</button>
    </view>
  </view>

<view wx:if="{{renameWorkId}}" class="rename-dialog-mask" catchtap="closeRenameDialog" catchtouchmove="stopPropagation">
  <view class="rename-dialog" catchtap="stopPropagation" aria-role="dialog" aria-label="重命名作品">
    <view class="rename-dialog__title">重命名作品</view>
    <input
      class="rename-dialog__input"
      value="{{renameDraft}}"
      maxlength="120"
      focus
      confirm-type="done"
      placeholder="请输入作品名称"
      aria-label="作品名称"
      bindinput="changeRenameDraft"
      bindconfirm="submitRename"
    />
    <view class="rename-dialog__feedback">
      <text class="rename-dialog__error">{{renameError}}</text>
      <text>{{renameLength}} / 120</text>
    </view>
    <view class="rename-dialog__buttons">
      <button class="rename-dialog__button rename-dialog__button--cancel" disabled="{{renameSaving}}" bindtap="closeRenameDialog">取消</button>
      <button
        class="rename-dialog__button rename-dialog__button--save"
        loading="{{renameSaving}}"
        disabled="{{!renameCanSave || renameSaving}}"
        bindtap="submitRename"
      >保存</button>
    </view>
  </view>
</view>
</page-layout>
