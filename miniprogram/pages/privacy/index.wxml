<page-layout title="隐私设置" back showMainNav selectedTab="2">
  <view class="subpage privacy-page">
    <view class="privacy-intro">◇　我们重视您的隐私与数据安全，您可以在这里管理个人信息与隐私偏好</view>

    <view class="privacy-card ui-card">
      <view class="privacy-card__title"><text>☁</text> 数据与同步</view>
      <view class="privacy-setting">
        <view class="privacy-setting__icon">▱</view>
        <view class="privacy-setting__content"><view>仅在本地保存作品</view><text>作品仅保存在当前设备，不上传至云端</text></view>
        <switch data-key="localOnly" checked="{{preferences.localOnly}}" color="#12b466" bindchange="changePreference" />
      </view>
      <view class="privacy-setting">
        <view class="privacy-setting__icon">☁</view>
        <view class="privacy-setting__content"><view>同步作品到云端</view><text>开启后，作品将安全备份到云端，可多设备同步</text></view>
        <switch data-key="cloudSync" checked="{{preferences.cloudSync}}" color="#12b466" bindchange="changePreference" />
      </view>
      <view class="privacy-setting">
        <view class="privacy-setting__icon">♢</view>
        <view class="privacy-setting__content"><view>接收服务通知</view><text>接收订单、活动、系统等重要通知</text></view>
        <switch data-key="serviceNotices" checked="{{preferences.serviceNotices}}" color="#12b466" bindchange="changePreference" />
      </view>
      <view class="privacy-setting">
        <view class="privacy-setting__icon">☆</view>
        <view class="privacy-setting__content"><view>允许个性化推荐</view><text>根据您的使用偏好，推荐更合适的内容</text></view>
        <switch data-key="personalizedRecommendations" checked="{{preferences.personalizedRecommendations}}" color="#12b466" bindchange="changePreference" />
      </view>
    </view>

    <view class="privacy-card ui-card privacy-documents">
      <view class="privacy-card__title"><text>◇</text> 隐私与协议</view>
      <view class="privacy-document" data-title="隐私政策" bindtap="openDocument"><text>▤</text><view>隐私政策</view><text>›</text></view>
      <view class="privacy-document" data-title="个人信息收集清单" bindtap="openDocument"><text>▤</text><view>个人信息收集清单</view><text>›</text></view>
      <view class="privacy-document" data-title="第三方信息共享清单" bindtap="openDocument"><text>▤</text><view>第三方信息共享清单</view><text>›</text></view>
    </view>

    <view class="cancel-account ui-card" bindtap="cancelAccount"><view class="cancel-account__icon">◯</view><view><view>注销账号</view><text>注销后将无法恢复，请谨慎操作</text></view><text>›</text></view>
    <view class="privacy-safe">♙　您的隐私安全，我们全力守护</view>
  </view>
</page-layout>
