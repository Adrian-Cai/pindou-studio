<page-layout title="我的" showMainNav selectedTab="2">
  <!-- ── 未登录状态 ── -->
  <view wx:if="{{!isLoggedIn}}" class="profile-page profile-guest">
    <view class="guest-body">
      <image class="guest-avatar" src="/assets/icons/brand-avatar.webp" mode="aspectFit" />
      <view class="guest-title">登录后使用更多功能</view>

      <view class="guest-agreement">
        <view
          class="guest-agreement__consent"
          bindtap="toggleLoginAgreement"
          aria-role="checkbox"
          aria-checked="{{loginAgreementAccepted}}"
          aria-label="我已阅读并同意用户协议和隐私政策"
        >
          <view class="login-sheet__checkbox {{loginAgreementAccepted ? 'login-sheet__checkbox--checked' : ''}}">
            <image wx:if="{{loginAgreementAccepted}}" src="/assets/icons/login/check.svg" mode="aspectFit" aria-hidden="true" />
          </view>
          <text>我已阅读并同意</text>
        </view>
        <text class="login-sheet__agreement-link" catchtap="openUserAgreement" aria-role="link">《用户协议》</text>
        <text>和</text>
        <text class="login-sheet__agreement-link" catchtap="openPrivacyPolicy" aria-role="link">《隐私政策》</text>
      </view>

      <view
        wx:if="{{loginMessage}}"
        class="guest-message {{loginMessageTone === 'error' ? 'guest-message--error' : ''}}"
      >{{loginMessage}}</view>

      <button
        class="login-sheet__submit guest-login-btn"
        loading="{{loginUiState === 'loading'}}"
        disabled="{{loginUiState === 'loading'}}"
        bindtap="startWechatLogin"
      >
        <image wx:if="{{loginUiState !== 'loading'}}" class="login-sheet__wechat" src="/assets/icons/login/wechat.svg" mode="aspectFit" aria-hidden="true" />
        <text>{{loginUiState === 'loading' ? '登录中…' : loginUiState === 'error' ? '重新登录' : '微信登录'}}</text>
      </button>
    </view>
  </view>

  <!-- ── 已登录状态 ── -->
  <view wx:else class="profile-page">
    <!-- A. 用户卡 -->
    <view class="user-card ui-card" bindtap="openUserPanel">
      <image class="user-card__avatar" src="{{avatarPath}}" mode="aspectFill" />
      <view class="user-card__name">{{accountName}}</view>
      <view class="user-card__arrow">›</view>
    </view>

    <!-- B. 权益卡 -->
    <view class="benefit-card">
      <view class="benefit-card__left">
        <view class="benefit-card__label">
          <image class="benefit-card__icon" src="/assets/icons/profile-benefit-badge.svg" mode="aspectFit" />
          <text>我的权益</text>
        </view>
        <view class="benefit-card__quota-row">
          <text class="benefit-card__caption">今日剩余</text>
          <text class="benefit-card__quota"><text class="benefit-card__quota-num">{{downloadQuota}}</text> / {{dailyFreeDownloadQuota}} 次</text>
        </view>
      </view>
      <view class="benefit-card__action" bindtap="showRechargeSheet">获取更多次数 ›</view>
    </view>

    <!-- C. 2×2 功能宫格 -->
    <view class="profile-grid">
      <view class="profile-grid__item ui-card" bindtap="openProjects">
        <image class="profile-grid__icon" src="/assets/icons/profile-stat-gallery.svg" mode="aspectFit" />
        <text class="profile-grid__title">我的作品</text>
        <text class="profile-grid__arrow">›</text>
      </view>
      <view class="profile-grid__item ui-card" bindtap="openFavorites">
        <image class="profile-grid__icon" src="/assets/icons/profile-stat-star.svg" mode="aspectFit" />
        <text class="profile-grid__title">我的收藏</text>
        <text class="profile-grid__arrow">›</text>
      </view>
      <view class="profile-grid__item ui-card" bindtap="openDownloads">
        <image class="profile-grid__icon" src="/assets/icons/profile-stat-download.svg" mode="aspectFit" />
        <text class="profile-grid__title">下载记录</text>
        <text class="profile-grid__arrow">›</text>
      </view>
      <view class="profile-grid__item ui-card" bindtap="openSettings">
        <image class="profile-grid__icon" src="/assets/icons/profile-menu-settings.svg" mode="aspectFit" />
        <text class="profile-grid__title">设置</text>
        <text class="profile-grid__arrow">›</text>
      </view>
    </view>
  </view>
</page-layout>

<!-- ── Recharge Sheet ── -->
<view wx:if="{{activeSheet === 'recharge'}}" class="sheet-mask" catchtap="hideActiveSheet" catchtouchmove="stopPropagation">
  <view class="profile-sheet recharge-sheet" catchtap="stopPropagation">
    <view class="profile-sheet__handle"></view>
    <view class="recharge-sheet__title">获取下载次数</view>
    <view class="recharge-sheet__quota">今日剩余 <text>{{downloadQuota}}</text> 次</view>
    <view
      class="recharge-option package-row {{selectedPackage === index ? 'recharge-option--active' : ''}}"
      wx:for="{{packages}}"
      wx:key="id"
      data-index="{{index}}"
      bindtap="selectPackage"
    >
      <view class="package-icon-wrap">
        <image class="package-icon" src="/assets/icons/bead-stack.svg" mode="aspectFit" />
      </view>
      <text class="recharge-option__label">{{item.label}}</text>
      <view class="package-right">
        <text class="recharge-option__price">¥ {{item.price}}</text>
        <view class="package-radio {{selectedPackage === index ? 'package-radio--selected' : ''}}"></view>
      </view>
    </view>
    <view class="payment-row">
      <text>支付方式</text>
      <view class="payment-row__method">
        <text>微信支付</text>
        <text class="payment-row__arrow">›</text>
      </view>
    </view>
    <button class="button-primary recharge-sheet__pay" style="width: 100%;" bindtap="purchase">立即支付</button>
    <view class="recharge-sheet__cancel" bindtap="hideActiveSheet">取消</view>
  </view>
</view>

<!-- ── Login Sheet（后台回退：过期 / account 触发 relogin） ── -->
<view wx:if="{{activeSheet === 'login'}}" class="login-mask {{loginClosing ? 'login-mask--closing' : ''}}" catchtap="closeLoginSheet" catchtouchmove="stopPropagation">
  <view class="login-sheet" catchtap="stopPropagation" aria-role="dialog" aria-label="登录小露拼豆">
    <view class="login-sheet__handle"></view>
    <view class="login-sheet__close" bindtap="closeLoginSheet" aria-role="button" aria-label="关闭登录弹层" hover-class="login-sheet__pressed">
      <image src="/assets/icons/login/close.svg" mode="aspectFit" aria-hidden="true" />
    </view>
    <image class="login-sheet__avatar" src="/assets/icons/brand-avatar.webp" mode="aspectFit" />
    <view class="login-sheet__title">登录小露拼豆</view>
    <view class="login-sheet__subtitle">
      <view>登录后即可保存作品，跨设备同步</view>
      <view>享受完整的创作体验</view>
    </view>

    <view
      wx:if="{{loginMessage}}"
      class="login-sheet__message {{loginMessageTone === 'error' ? 'login-sheet__message--error' : ''}}"
    >{{loginMessage}}</view>

    <button
      class="login-sheet__submit"
      loading="{{loginUiState === 'loading'}}"
      disabled="{{loginUiState === 'loading' || loginClosing}}"
      bindtap="startWechatLogin"
    >
      <image wx:if="{{loginUiState !== 'loading'}}" class="login-sheet__wechat" src="/assets/icons/login/wechat.svg" mode="aspectFit" aria-hidden="true" />
      <text>{{loginUiState === 'loading' ? '登录中…' : loginUiState === 'error' ? '重新登录' : '微信一键登录'}}</text>
    </button>
    <view class="login-sheet__agreement">
      <view class="login-sheet__consent" bindtap="toggleLoginAgreement" aria-role="checkbox" aria-checked="{{loginAgreementAccepted}}" aria-label="我已阅读并同意用户协议和隐私政策" hover-class="login-sheet__pressed">
        <view class="login-sheet__checkbox {{loginAgreementAccepted ? 'login-sheet__checkbox--checked' : ''}}">
          <image wx:if="{{loginAgreementAccepted}}" src="/assets/icons/login/check.svg" mode="aspectFit" aria-hidden="true" />
        </view>
        <text>我已阅读并同意</text>
      </view>
      <text class="login-sheet__agreement-link" catchtap="openUserAgreement" aria-role="link">《用户协议》</text>
      <text>和</text>
      <text class="login-sheet__agreement-link" catchtap="openPrivacyPolicy" aria-role="link">《隐私政策》</text>
    </view>
  </view>
</view>

<!-- ── Profile Editor Sheet ── -->
<view wx:if="{{activeSheet === 'profile'}}" class="sheet-mask" catchtap="hideActiveSheet" catchtouchmove="stopPropagation">
  <view class="profile-sheet profile-editor" catchtap="stopPropagation">
    <view class="profile-sheet__handle"></view>
    <view class="profile-sheet__close" bindtap="hideActiveSheet" aria-role="button" aria-label="关闭个人资料编辑">×</view>
    <view class="profile-editor__title">完善个人资料</view>
    <view class="profile-editor__subtitle">头像使用默认品牌图，昵称保存到账号</view>
    <view class="profile-editor__avatar-button" aria-label="默认头像">
      <image class="profile-editor__avatar" src="{{profileDraftAvatarPath}}" mode="aspectFill" />
    </view>

    <view class="profile-editor__field">
      <view class="profile-editor__label">昵称</view>
      <input
        class="profile-editor__input"
        type="nickname"
        value="{{profileDraftNickname}}"
        maxlength="80"
        placeholder="请输入昵称"
        confirm-type="done"
        cursor-spacing="32"
        bindinput="updateProfileNickname"
      />
    </view>

    <view wx:if="{{profileMessage}}" class="profile-editor__message">{{profileMessage}}</view>
    <button
      class="profile-editor__submit"
      loading="{{profileSaving}}"
      disabled="{{profileSaving || !profileCanSave}}"
      bindtap="saveProfile"
    >{{profileSaving ? '保存中…' : '保存个人资料'}}</button>
  </view>
</view>

<!-- ── Account Sheet ── -->
<view wx:if="{{activeSheet === 'account'}}" class="sheet-mask" catchtap="hideActiveSheet" catchtouchmove="stopPropagation">
  <view class="profile-sheet account-sheet" catchtap="stopPropagation">
    <view class="profile-sheet__handle"></view>
    <view class="profile-sheet__close" bindtap="hideActiveSheet" aria-role="button" aria-label="关闭账号面板">×</view>
    <view class="account-sheet__title">账号与登录</view>

    <view class="account-summary">
      <image class="account-summary__avatar" src="{{avatarPath}}" mode="aspectFill" />
      <view class="account-summary__content">
        <view class="account-summary__name">{{accountName}}</view>
        <view class="account-summary__desc">{{accountStatusText}}</view>
      </view>
      <view class="account-summary__status">✓ 已登录</view>
    </view>

    <view class="account-action" bindtap="openProfileEditor">
      <image class="account-action__avatar-icon" src="/assets/icons/brand-avatar.svg" mode="aspectFit" />
      <text>编辑个人资料</text>
      <view>›</view>
    </view>
    <view class="account-action {{accountRefreshing ? 'account-action--disabled' : ''}}" bindtap="refreshAccountData">
      <image src="/assets/icons/profile-stat-download.svg" mode="aspectFit" />
      <text>{{accountRefreshing ? '正在刷新…' : '刷新账号数据'}}</text>
      <view>›</view>
    </view>
    <view class="account-action account-action--danger" bindtap="confirmLogout">
      <text class="account-action__logout-icon">↪</text>
      <text>退出登录</text>
    </view>
    <view class="account-sheet__cancel" bindtap="hideActiveSheet">取消</view>
  </view>
</view>
