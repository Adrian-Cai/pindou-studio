<view class="page profile">
  <top-bar title="我的" />

  <view class="profile-card">
    <view class="profile-card__avatar">拼</view>
    <view class="profile-card__content">
      <view class="profile-card__name">拼豆玩家</view>
      <view class="profile-card__desc">把灵感一颗一颗拼出来</view>
    </view>
    <view class="profile-card__edit">编辑 ›</view>
  </view>

  <view class="stats card">
    <view class="stat" bindtap="openProjects">
      <view class="stat__value">{{workCount}}</view>
      <view class="stat__label">我的作品</view>
    </view>
    <view class="stats__line"></view>
    <view class="stat" data-url="/pages/favorites/index" bindtap="openMenu">
      <view class="stat__value">{{favoriteCount}}</view>
      <view class="stat__label">我的收藏</view>
    </view>
    <view class="stats__line"></view>
    <view class="stat" data-url="/pages/downloads/index" bindtap="openMenu">
      <view class="stat__value">{{downloadQuota}}</view>
      <view class="stat__label">剩余下载</view>
    </view>
  </view>

  <view class="quota-card" bindtap="openRecharge">
    <view class="quota-card__icon">↓</view>
    <view class="quota-card__content">
      <view class="quota-card__title">获取更多下载次数</view>
      <view class="quota-card__desc">完整图纸、材料表一次保存</view>
    </view>
    <view class="quota-card__button">去看看</view>
  </view>

  <view class="menu card">
    <view
      class="menu__item"
      wx:for="{{menuItems}}"
      wx:key="id"
      data-url="{{item.url}}"
      bindtap="openMenu"
    >
      <view class="menu__symbol">{{item.symbol}}</view>
      <view class="menu__title">{{item.title}}</view>
      <view class="menu__arrow">›</view>
    </view>
  </view>

  <view class="profile__version">拼豆工作室 · 0.1.0</view>
</view>
