@import "../../styles/profile-pages.wxss";

.profile-page { box-sizing: border-box; padding: 16rpx var(--page-padding) 0; }
.user-card { display: flex; align-items: center; padding: 28rpx 32rpx; }
.user-card__avatar { width: 112rpx; height: 112rpx; flex-shrink: 0; border-radius: 20rpx; background: var(--color-primary-soft); }
.user-card__content { min-width: 0; flex: 1; margin-left: 28rpx; }
.user-card__name { font-size: 34rpx; font-weight: 600; line-height: 48rpx; }
.user-card__desc { margin-top: 6rpx; color: var(--color-text-secondary); font-size: 24rpx; line-height: 36rpx; }
.user-card__arrow, .profile-menu__arrow { color: var(--color-text-secondary); font-size: 48rpx; font-weight: 300; }

.benefit-card { overflow: hidden; margin-top: 24rpx; border: 2rpx solid var(--color-primary); border-radius: var(--radius-card); background: linear-gradient(135deg, #f7fffb, var(--color-primary-soft)); }
.benefit-card__label { display: flex; align-items: center; padding: 24rpx 32rpx 0; color: var(--color-primary); font-size: 27rpx; font-weight: 600; }
.benefit-card__icon { width: 40rpx; height: 40rpx; flex-shrink: 0; margin-right: 10rpx; }
.benefit-card__body { display: flex; min-height: 210rpx; align-items: center; justify-content: space-between; padding: 8rpx 40rpx 18rpx; }
.benefit-card__caption { font-size: 28rpx; }
.benefit-card__quota { margin-top: 10rpx; font-size: 36rpx; font-weight: 600; }
.benefit-card__quota text { color: var(--color-primary); font-size: 60rpx; }
.benefit-card__hint { margin-top: 8rpx; color: var(--color-text-secondary); font-size: 23rpx; }
.benefit-card__beads { width: 190rpx; height: 150rpx; }
.benefit-card__action { height: 76rpx; border-top: 1rpx solid rgba(18, 180, 102, 0.14); color: var(--color-primary); font-size: 27rpx; font-weight: 600; line-height: 76rpx; text-align: center; }

.profile-stats { display: flex; margin-top: 24rpx; padding: 28rpx 20rpx; }
.profile-stat { display: flex; min-width: 0; flex: 1; align-items: center; justify-content: center; gap: 16rpx; }
.profile-stat__icon { width: 44rpx; height: 44rpx; flex-shrink: 0; }
.profile-stat__content { min-width: 0; }
.profile-stat__label { font-size: 24rpx; }
.profile-stat__value { margin-top: 2rpx; font-size: 34rpx; font-weight: 700; line-height: 42rpx; }
.profile-stats__line { width: 1rpx; height: 64rpx; align-self: center; background: var(--color-border); }

.profile-menu { margin-top: 24rpx; padding: 0 32rpx; }
.profile-menu__item { display: flex; height: 96rpx; align-items: center; border-bottom: 1rpx solid var(--color-border); }
.profile-menu__item:last-child { border-bottom: 0; }
.profile-menu__icon-wrap { display: flex; width: 48rpx; height: 48rpx; flex-shrink: 0; align-items: center; justify-content: center; }
.profile-menu__icon { width: 38rpx; height: 38rpx; }
.profile-menu__title { flex: 1; margin-left: 16rpx; font-size: 28rpx; }
.profile-menu__arrow { font-size: 42rpx; }
.profile-page__version { padding: 32rpx 0 8rpx; color: var(--color-text-tertiary); font-size: 22rpx; text-align: center; }

.sheet-mask { position: fixed; z-index: 300; inset: 0; background: rgba(15, 18, 17, 0.48); }
.profile-sheet { position: absolute; right: 0; bottom: 0; left: 0; box-sizing: border-box; padding: 16rpx 32rpx calc(32rpx + env(safe-area-inset-bottom)); border-radius: 36rpx 36rpx 0 0; background: #fff; }
.profile-sheet__handle { width: 80rpx; height: 8rpx; margin: 0 auto 24rpx; border-radius: 8rpx; background: var(--color-disabled); }
.profile-sheet__close { position: absolute; top: 24rpx; right: 28rpx; display: flex; width: 64rpx; height: 64rpx; align-items: center; justify-content: center; border-radius: 50%; background: var(--color-background); color: var(--color-text-secondary); font-size: 40rpx; font-weight: 300; line-height: 1; }
.recharge-sheet__title { font-size: 36rpx; font-weight: 600; text-align: center; }
.recharge-sheet__quota { margin: 8rpx 0 24rpx; color: var(--color-text-secondary); font-size: 25rpx; text-align: center; }
.recharge-sheet__quota text { color: var(--color-primary); font-size: 34rpx; font-weight: 600; }
.recharge-option { display: flex; height: 92rpx; align-items: center; margin-bottom: 16rpx; padding: 0 24rpx; border: 1rpx solid var(--color-border); border-radius: var(--radius-control); }
.recharge-option--active { border: 2rpx solid var(--color-primary); background: #f8fffb; }
.package-row { display: flex; align-items: center; }
.package-icon-wrap { display: flex; width: 52rpx; height: 52rpx; flex-shrink: 0; align-items: center; justify-content: center; }
.package-icon { width: 40rpx; height: 40rpx; flex-shrink: 0; }
.recharge-option__label { min-width: 0; flex: 1; margin-left: 16rpx; font-size: 27rpx; white-space: nowrap; }
.package-right { display: flex; align-items: center; gap: 16rpx; margin-left: auto; padding-left: 16rpx; }
.recharge-option__price { min-width: 112rpx; color: var(--color-text); font-size: 30rpx; font-weight: 600; text-align: right; white-space: nowrap; }
.package-radio { display: flex; width: 32rpx; height: 32rpx; box-sizing: border-box; flex-shrink: 0; align-items: center; justify-content: center; border: 2rpx solid var(--color-disabled); border-radius: 50%; background: var(--color-surface); }
.package-radio--selected { border-color: var(--color-primary); }
.package-radio--selected::after { width: 14rpx; height: 14rpx; border-radius: 50%; background: var(--color-primary); content: ""; }
.payment-row { display: flex; height: 88rpx; align-items: center; justify-content: space-between; padding: 0 24rpx; border: 1rpx solid var(--color-border); border-radius: var(--radius-control); font-size: 26rpx; }
.payment-row__method { display: flex; align-items: center; gap: 16rpx; color: var(--color-text); }
.payment-row__arrow { color: var(--color-text-secondary); font-size: 40rpx; font-weight: 300; line-height: 1; }
.recharge-sheet__pay { width: calc(100vw - 64rpx); margin-top: 24rpx; }
.recharge-sheet__cancel { padding-top: 28rpx; color: var(--color-text-secondary); font-size: 27rpx; text-align: center; }

.login-sheet { text-align: center; }
.login-sheet__avatar { width: 120rpx; height: 120rpx; margin-top: 4rpx; border-radius: 24rpx; background: var(--color-primary-soft); }
.login-sheet__title { margin-top: 20rpx; font-size: 36rpx; font-weight: 600; line-height: 50rpx; }
.login-sheet__subtitle { margin-top: 6rpx; color: var(--color-text-secondary); font-size: 24rpx; line-height: 36rpx; }
.login-benefits { display: flex; justify-content: space-between; margin: 32rpx 8rpx 24rpx; }
.login-benefit { display: flex; min-width: 0; flex: 1; align-items: center; flex-direction: column; gap: 12rpx; color: var(--color-text-secondary); font-size: 22rpx; line-height: 32rpx; }
.login-benefit image { width: 48rpx; height: 48rpx; }
.login-sheet__message { margin-bottom: 20rpx; padding: 18rpx 20rpx; border-radius: 16rpx; background: var(--color-primary-soft); color: var(--color-primary); font-size: 23rpx; line-height: 34rpx; text-align: left; }
.login-sheet__message--error { background: #fff1f1; color: #d94848; }
.login-sheet__submit { display: flex; height: 92rpx; align-items: center; justify-content: center; border-radius: var(--radius-control); background: var(--color-primary); color: #fff; font-size: 28rpx; font-weight: 600; line-height: 92rpx; }
.login-sheet__submit::after { border: 0; }
.login-sheet__submit[disabled] { background: var(--color-primary); color: #fff; opacity: 0.62; }
.login-sheet__later { padding: 28rpx 0 18rpx; color: var(--color-text-secondary); font-size: 26rpx; }
.login-sheet__agreement, .login-sheet__local-hint { color: var(--color-text-tertiary); font-size: 21rpx; line-height: 32rpx; }

.profile-editor { text-align: center; }
.profile-editor__title { margin-top: 4rpx; font-size: 36rpx; font-weight: 600; line-height: 50rpx; }
.profile-editor__subtitle { margin-top: 6rpx; color: var(--color-text-secondary); font-size: 23rpx; line-height: 34rpx; }
.profile-editor__avatar-button { position: relative; width: 152rpx; min-width: 0; max-width: 152rpx; height: 152rpx; box-sizing: border-box; margin: 28rpx auto 30rpx; padding: 0; border-radius: 32rpx; background: var(--color-primary-soft); line-height: 1; }
.profile-editor__avatar-button::after, .profile-editor__submit::after { border: 0; }
.profile-editor__avatar { width: 152rpx; height: 152rpx; border-radius: 32rpx; }
.profile-editor__avatar-badge { position: absolute; right: -12rpx; bottom: -10rpx; min-width: 64rpx; height: 40rpx; padding: 0 12rpx; border: 4rpx solid #fff; border-radius: 999rpx; background: var(--color-primary); color: #fff; font-size: 20rpx; line-height: 40rpx; }
.profile-editor__field { text-align: left; }
.profile-editor__label { margin-bottom: 12rpx; color: var(--color-text-secondary); font-size: 24rpx; }
.profile-editor__input { box-sizing: border-box; width: 100%; height: 88rpx; padding: 0 24rpx; border: 1rpx solid var(--color-border); border-radius: var(--radius-control); background: var(--color-background); font-size: 28rpx; }
.profile-editor__message { margin-top: 16rpx; padding: 16rpx 20rpx; border-radius: 16rpx; background: #fff1f1; color: #d94848; font-size: 23rpx; line-height: 34rpx; text-align: left; }
.profile-editor__submit { display: flex; height: 92rpx; align-items: center; justify-content: center; margin-top: 24rpx; border-radius: var(--radius-control); background: var(--color-primary); color: #fff; font-size: 28rpx; font-weight: 600; line-height: 92rpx; }
.profile-editor__submit[disabled] { background: var(--color-primary); color: #fff; opacity: 0.5; }
.profile-editor__later { padding-top: 28rpx; color: var(--color-text-secondary); font-size: 26rpx; }

.account-sheet__title { margin: 4rpx 0 28rpx; font-size: 36rpx; font-weight: 600; line-height: 50rpx; }
.account-summary { display: flex; align-items: center; padding: 24rpx; border-radius: var(--radius-control); background: var(--color-primary-soft); }
.account-summary__avatar { width: 96rpx; height: 96rpx; flex-shrink: 0; border-radius: 20rpx; }
.account-summary__content { min-width: 0; flex: 1; margin-left: 20rpx; }
.account-summary__name { font-size: 29rpx; font-weight: 600; line-height: 42rpx; }
.account-summary__desc { margin-top: 4rpx; color: var(--color-text-secondary); font-size: 22rpx; line-height: 32rpx; }
.account-summary__status { flex-shrink: 0; padding: 10rpx 16rpx; border-radius: 999rpx; background: #dff8eb; color: var(--color-primary); font-size: 21rpx; }
.account-action { display: flex; height: 96rpx; align-items: center; margin-top: 20rpx; padding: 0 24rpx; border-radius: var(--radius-control); background: var(--color-background); font-size: 27rpx; }
.account-action image { width: 36rpx; height: 36rpx; margin-right: 18rpx; }
.account-action .account-action__avatar-icon { border-radius: 8rpx; }
.account-action text:nth-child(2) { min-width: 0; flex: 1; }
.account-action view { color: var(--color-text-secondary); font-size: 40rpx; font-weight: 300; }
.account-action--disabled { opacity: 0.56; }
.account-action--danger { margin-top: 12rpx; background: #fff1f1; color: #d94848; }
.account-action__logout-icon { display: flex; width: 36rpx; height: 36rpx; flex: none !important; align-items: center; justify-content: center; margin-right: 18rpx; font-size: 34rpx; }
.account-sheet__cancel { padding-top: 28rpx; color: var(--color-text-secondary); font-size: 27rpx; text-align: center; }

@media (max-width: 340px) {
  .profile-page { padding-right: var(--page-padding-compact); padding-left: var(--page-padding-compact); }
  .profile-stat { gap: 8rpx; }
  .profile-stat__icon { width: 40rpx; height: 40rpx; }
  .login-benefits { margin-right: 0; margin-left: 0; }
  .login-benefit { font-size: 20rpx; }
}
