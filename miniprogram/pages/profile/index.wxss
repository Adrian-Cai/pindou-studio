@import "../../styles/profile-pages.wxss";
@import "./login-sheet.wxss";

/* ── 页面容器 ── */
.profile-page { box-sizing: border-box; padding: 16rpx var(--page-padding) 0; }

/* ── 用户卡 ── */
.user-card {
  display: flex;
  height: 192rpx;
  box-sizing: border-box;
  align-items: center;
  padding: 0 38rpx;
  border-radius: 38rpx;
  background: var(--surface);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}
.user-card__avatar {
  width: 116rpx;
  height: 116rpx;
  flex-shrink: 0;
  border-radius: 28rpx;
  background: var(--color-primary-soft);
}
.user-card__name {
  min-width: 0;
  flex: 1;
  margin-left: 30rpx;
  color: var(--color-text);
  font-size: 36rpx;
  font-weight: 600;
  line-height: 48rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.user-card__arrow {
  width: 36rpx;
  height: 36rpx;
  flex-shrink: 0;
}

/* ── 权益卡 ── */
.benefit-card {
  position: relative;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  margin-top: 20rpx;
  padding: 28rpx 28rpx 24rpx;
  border-radius: 40rpx;
  background: var(--color-primary-surface);
  box-shadow: var(--shadow-card);
}
.benefit-card__header {
  display: flex;
  min-width: 0;
  align-items: center;
}
.benefit-card__brand-mark {
  display: flex;
  width: 64rpx;
  height: 64rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  border-radius: 22rpx;
  background: var(--color-primary-soft);
}
.benefit-card__icon {
  width: 48rpx;
  height: 48rpx;
  flex-shrink: 0;
}
.benefit-card__heading {
  min-width: 0;
  flex: 1;
  margin-left: 16rpx;
}
.benefit-card__heading text {
  display: block;
}
.benefit-card__title {
  color: var(--color-text);
  font-size: 32rpx;
  font-weight: 600;
  line-height: 44rpx;
  white-space: nowrap;
}
.benefit-card__subtitle {
  margin-top: 2rpx;
  color: var(--color-text-secondary);
  font-size: 23rpx;
  line-height: 32rpx;
}
.benefit-card__header-action {
  display: flex;
  width: 72rpx;
  height: 72rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  margin-left: 16rpx;
  border-radius: 50%;
  background: var(--color-primary-soft);
  transition: var(--transition-press);
}
.benefit-card__header-action image {
  width: 36rpx;
  height: 36rpx;
}
.benefit-card__header-action--pressed {
  opacity: 0.72;
  transform: scale(0.97);
}
.benefit-card__content {
  display: flex;
  min-width: 0;
  margin-top: 28rpx;
}
.benefit-card__quota-panel {
  min-width: 0;
  width: 42%;
  box-sizing: border-box;
  padding: 12rpx 20rpx 0 0;
}
.benefit-card__caption-row {
  display: flex;
  align-items: center;
}
.benefit-card__caption {
  color: var(--color-text-secondary);
  font-size: 27rpx;
  font-weight: 500;
  line-height: 36rpx;
}
.benefit-card__info-trigger {
  display: flex;
  width: 48rpx;
  height: 48rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  margin-left: 2rpx;
  border-radius: 50%;
  transition: var(--transition-press);
}
.benefit-card__info-trigger:active {
  background: var(--strong-overlay);
  transform: scale(0.97);
}
.benefit-card__info-icon {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
}
.benefit-card__quota-val {
  display: flex;
  align-items: baseline;
  margin-top: 8rpx;
}
.benefit-card__quota-num {
  color: var(--color-primary);
  font-size: 88rpx;
  font-weight: 700;
  letter-spacing: -2rpx;
  line-height: 0.98;
}
.benefit-card__quota-unit {
  margin-left: 8rpx;
  color: var(--color-text);
  font-size: 36rpx;
  font-weight: 600;
  line-height: 1;
}
.benefit-card__insight-pill {
  display: inline-flex;
  max-width: 100%;
  height: 48rpx;
  box-sizing: border-box;
  align-items: center;
  margin-top: 20rpx;
  padding: 0 14rpx 0 16rpx;
  border-radius: var(--radius-full);
  background: var(--color-primary-soft);
  color: var(--color-primary);
  font-size: 21rpx;
  line-height: 48rpx;
  white-space: nowrap;
}
.benefit-card__sparkle {
  margin-left: 8rpx;
  font-size: 24rpx;
  line-height: 1;
}
.benefit-card__details {
  min-width: 0;
  flex: 1;
  box-sizing: border-box;
  padding-left: 20rpx;
  border-left: 1rpx solid var(--track);
}
.benefit-card__detail-row {
  display: flex;
  min-width: 0;
  min-height: 84rpx;
  align-items: center;
}
.benefit-card__detail-icon-wrap {
  display: flex;
  width: 56rpx;
  height: 56rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--color-primary-soft);
}
.benefit-card__detail-icon {
  width: 32rpx;
  height: 32rpx;
}
.benefit-card__detail-copy {
  min-width: 0;
  flex: 1;
  margin-left: 14rpx;
}
.benefit-card__detail-line {
  display: flex;
  min-width: 0;
  align-items: baseline;
  white-space: nowrap;
}
.benefit-card__detail-label {
  flex-shrink: 0;
  color: var(--color-text-secondary);
  font-size: 23rpx;
  line-height: 32rpx;
  white-space: nowrap;
}
.benefit-card__detail-value {
  display: flex;
  flex-shrink: 0;
  align-items: baseline;
  margin-left: 12rpx;
}
.benefit-card__detail-count {
  color: var(--color-text);
  font-size: 31rpx;
  font-weight: 600;
  line-height: 38rpx;
  white-space: nowrap;
}
.benefit-card__detail-unit {
  margin-left: 4rpx;
  color: var(--color-text-secondary);
  font-size: 22rpx;
  line-height: 32rpx;
}
.benefit-card__detail-divider {
  height: 1rpx;
  margin-left: 70rpx;
  background: var(--track);
}
.benefit-card__action {
  display: flex;
  width: 100%;
  height: 72rpx;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  margin-top: 16rpx;
  border-radius: var(--radius-full);
  background: var(--color-primary);
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 72rpx;
  box-shadow: var(--shadow-primary);
  transition: var(--transition-press);
}
.benefit-card__action image {
  width: 28rpx;
  height: 28rpx;
  margin-left: 8rpx;
  filter: brightness(0) invert(1);
}
.benefit-card__action--pressed {
  background: var(--color-primary-pressed);
  opacity: 0.9;
  transform: scale(0.97);
}
.benefit-card__action text {
  line-height: 1;
}
.benefit-card__quota-tip {
  position: absolute;
  z-index: 20;
  top: 116rpx;
  right: 24rpx;
  left: 24rpx;
  box-sizing: border-box;
  padding: 26rpx 28rpx 22rpx;
  border-radius: var(--radius-card-small);
  background: var(--surface);
  box-shadow: var(--shadow-card);
  color: var(--color-text-secondary);
}
.benefit-card__quota-tip-arrow {
  position: absolute;
  top: -10rpx;
  left: 124rpx;
  width: 20rpx;
  height: 20rpx;
  border-radius: 4rpx 0 0;
  background: var(--surface);
  transform: rotate(45deg);
}
.benefit-card__quota-tip-title {
  position: relative;
  color: var(--color-text);
  font-size: 27rpx;
  font-weight: 600;
  line-height: 38rpx;
}
.benefit-card__quota-tip-list {
  position: relative;
  display: grid;
  gap: 8rpx;
  margin-top: 14rpx;
  font-size: 22rpx;
  line-height: 32rpx;
}
.benefit-card__quota-tip-close {
  position: relative;
  margin-top: 14rpx;
  color: var(--color-primary);
  font-size: 24rpx;
  font-weight: 600;
  line-height: 36rpx;
  text-align: right;
}

/* ── 订单入口 ── */
.order-entry {
  display: flex;
  min-height: 112rpx;
  box-sizing: border-box;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
  padding: 24rpx 32rpx;
  border-radius: 38rpx;
  transition: var(--transition-press);
}
.order-entry:active {
  opacity: 0.72;
  transform: scale(0.98);
}
.order-entry__content {
  min-width: 0;
}
.order-entry__title {
  color: var(--color-text);
  font-size: 30rpx;
  font-weight: 600;
  line-height: 40rpx;
}
.order-entry__description {
  margin-top: 6rpx;
  color: var(--color-text-secondary);
  font-size: 23rpx;
  line-height: 34rpx;
}
.order-entry__arrow {
  width: 36rpx;
  height: 36rpx;
  flex-shrink: 0;
  margin-left: 24rpx;
}

/* ── 2×2 功能宫格 ── */
.profile-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 22rpx;
  margin-top: 20rpx;
}
.profile-grid__item {
  display: flex;
  flex-direction: row;
  height: 224rpx;
  box-sizing: border-box;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 28rpx 28rpx 32rpx;
  border-radius: 38rpx;
  background: var(--surface);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  transition: var(--transition-press);
}
.profile-grid__item:active {
  opacity: 0.72;
  transform: scale(0.98);
}
.profile-grid__body {
  display: flex;
  flex-direction: column;
  justify-content: center;
}
.profile-grid__icon {
  width: 56rpx;
  height: 56rpx;
  margin-bottom: 28rpx;
  flex-shrink: 0;
}
.profile-grid__title {
  color: var(--color-text);
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.2;
}
.profile-grid__arrow {
  width: 36rpx;
  height: 36rpx;
  flex-shrink: 0;
}

/* ── 未登录状态 ── */
.profile-guest { display: flex; flex-direction: column; min-height: 80vh; }
.guest-body { display: flex; flex: 1; flex-direction: column; align-items: center; justify-content: center; padding: 48rpx 0 32rpx; }
.guest-avatar { width: 240rpx; height: 240rpx; border-radius: 40rpx; }
.guest-title { margin-top: 48rpx; font-size: 36rpx; font-weight: 700; line-height: 50rpx; text-align: center; }
.guest-subtitle { margin-top: 12rpx; color: var(--color-text-secondary); font-size: 26rpx; line-height: 40rpx; text-align: center; }
.guest-agreement { display: flex; align-items: center; justify-content: center; margin-top: 48rpx; color: var(--color-text-secondary); font-size: 24rpx; line-height: 36rpx; white-space: nowrap; }
.guest-agreement__consent { display: flex; align-items: center; padding: 11px 0; margin: -11px 0; }
.guest-message { margin-top: 20rpx; color: var(--color-text-secondary); font-size: 24rpx; text-align: center; }
.guest-message--error { color: var(--color-danger); }
.guest-login-btn { width: 100%; max-width: 560rpx; margin-top: 32rpx; }
.guest-footer { display: flex; align-items: center; justify-content: center; padding: 40rpx 0 calc(32rpx + env(safe-area-inset-bottom)); color: var(--color-text-secondary); font-size: 24rpx; }
.guest-footer__link { color: var(--color-text-secondary); }
.guest-footer__link:active { opacity: 0.72; }
.guest-footer__dot { margin: 0 8rpx; }

/* ── Sheet 基础 ── */
.sheet-mask { position: fixed; z-index: 300; inset: 0; background: rgba(15, 18, 17, 0.48); }
.profile-sheet { position: absolute; right: 0; bottom: 0; left: 0; box-sizing: border-box; padding: 16rpx 32rpx calc(32rpx + env(safe-area-inset-bottom)); border-radius: var(--radius-card-large) var(--radius-card-large) 0 0; background: var(--color-surface); box-shadow: var(--shadow-card); }
.profile-sheet__handle { width: 80rpx; height: 8rpx; margin: 0 auto 24rpx; border-radius: 8rpx; background: var(--color-disabled); }
.profile-sheet__close { position: absolute; top: 24rpx; right: 28rpx; display: flex; width: 88rpx; height: 88rpx; align-items: center; justify-content: center; border: 0; border-radius: var(--radius-card-small); background: transparent; box-shadow: var(--shadow-ghost); transition: var(--transition-press); }
.profile-sheet__close image { width: 36rpx; height: 36rpx; }
.profile-sheet__close:active { background: var(--strong-overlay); transform: scale(0.97); }

/* ── Recharge Sheet ── */
.recharge-sheet__title { font-size: 36rpx; font-weight: 600; line-height: 50rpx; text-align: center; }
.recharge-sheet__quota { display: flex; align-items: baseline; justify-content: center; margin-top: 4rpx; line-height: 44rpx; }
.recharge-sheet__quota-label,
.recharge-sheet__quota-unit { color: var(--color-text-secondary); font-size: 28rpx; }
.recharge-sheet__quota-number { margin: 0 8rpx; color: var(--color-primary); font-size: 44rpx; font-weight: 700; line-height: 1; }
.recharge-sheet__quota-detail { margin-top: 2rpx; color: var(--color-text-secondary); font-size: 23rpx; line-height: 32rpx; text-align: center; }
.recharge-sheet__section-title { margin: 20rpx 0 12rpx; color: var(--color-text); font-size: 28rpx; font-weight: 600; line-height: 40rpx; }
.recharge-sheet__message { padding: 28rpx 0; color: var(--color-text-secondary); font-size: 25rpx; line-height: 36rpx; text-align: center; }
.recharge-option { display: flex; height: 104rpx; box-sizing: border-box; align-items: center; margin-bottom: 16rpx; padding: 0 24rpx; border: 2rpx solid var(--color-border); border-radius: var(--radius-card-small); background: var(--color-surface); box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04); transition: var(--transition-press); }
.recharge-option--active { border-color: var(--color-primary); background: var(--color-primary-surface); box-shadow: 0 4rpx 16rpx rgba(18, 180, 102, 0.1); }
.recharge-option:active { background: var(--strong-overlay); transform: scale(0.97); }
.recharge-option__copy { display: flex; min-width: 0; flex: 1; flex-direction: column; justify-content: center; }
.recharge-option__name { color: var(--color-text); font-size: 28rpx; font-weight: 600; line-height: 38rpx; white-space: nowrap; }
.recharge-option__count { margin-top: 2rpx; color: var(--color-text-secondary); font-size: 23rpx; line-height: 32rpx; white-space: nowrap; }
.recharge-option__price { flex-shrink: 0; margin-left: 20rpx; color: var(--color-text); font-size: 30rpx; font-variant-numeric: tabular-nums; font-weight: 600; line-height: 38rpx; text-align: right; white-space: nowrap; }
.package-radio { display: flex; width: 36rpx; height: 36rpx; box-sizing: border-box; flex-shrink: 0; align-items: center; justify-content: center; margin-left: 20rpx; border: 2rpx solid var(--color-disabled); border-radius: 50%; background: var(--color-surface); }
.package-radio--selected { border-color: var(--color-primary); }
.package-radio--selected::after { width: 16rpx; height: 16rpx; border-radius: 50%; background: var(--color-primary); content: ""; }
.payment-row { display: flex; height: 88rpx; align-items: center; justify-content: space-between; padding: 0 24rpx; border: 0; border-radius: var(--radius-card-small); background: var(--color-surface); box-shadow: var(--shadow-card); font-size: 26rpx; }
.payment-row__method { display: flex; align-items: center; gap: 16rpx; color: var(--color-text); }
.payment-row__arrow { width: 36rpx; height: 36rpx; }
.recharge-sheet__pay { width: calc(100vw - 64rpx); margin-top: 24rpx; }
.recharge-sheet__cancel { padding-top: 24rpx; color: var(--color-text-secondary); font-size: 27rpx; text-align: center; }

/* ── Profile Editor Sheet ── */
.profile-editor { padding-bottom: calc(48rpx + env(safe-area-inset-bottom)); text-align: center; }
.profile-editor__title { margin-top: 4rpx; font-size: 36rpx; font-weight: 600; line-height: 50rpx; }
.profile-editor__subtitle { margin-top: 6rpx; color: var(--color-text-secondary); font-size: 23rpx; line-height: 34rpx; }
.profile-editor__avatar-button { display: flex; width: 152rpx; height: 152rpx; box-sizing: border-box; align-items: center; justify-content: center; margin: 28rpx auto 30rpx; border: 0; border-radius: var(--radius-card-large); background: var(--color-primary-soft); box-shadow: var(--shadow-ghost); line-height: 1; transition: var(--transition-press); }
.profile-editor__avatar-button::after, .profile-editor__submit::after { border: 0; }
.profile-editor__avatar-button:active { background: var(--strong-overlay); transform: scale(0.97); }
.profile-editor__avatar { width: 152rpx; height: 152rpx; border-radius: 32rpx; }
.profile-editor__field { text-align: left; }
.profile-editor__label { margin-bottom: 12rpx; color: var(--color-text-secondary); font-size: 24rpx; }
.profile-editor__input { box-sizing: border-box; width: 100%; height: 88rpx; padding: 0 24rpx; border: 1rpx solid var(--color-border); border-radius: var(--radius-control); background: var(--color-background); font-size: 28rpx; }
.profile-editor__message { margin-top: 16rpx; padding: 16rpx 20rpx; border-radius: 16rpx; background: var(--color-danger-soft); color: var(--color-danger); font-size: 23rpx; line-height: 34rpx; text-align: left; }
.profile-editor__submit { display: flex; height: 92rpx; align-items: center; justify-content: center; margin-top: 32rpx; border: 0; border-radius: var(--radius-card-small); background: var(--color-primary); color: #fff; font-size: 28rpx; font-weight: 600; line-height: 92rpx; box-shadow: var(--shadow-primary); transition: var(--transition-press); }
.profile-editor__submit:active { transform: scale(0.97); }
.profile-editor__submit[disabled] { background: var(--color-primary); color: #fff; opacity: 0.5; }

@media (max-width: 340px) {
  .profile-page { padding-right: var(--page-padding-compact); padding-left: var(--page-padding-compact); }
  .benefit-card { padding: 24rpx 24rpx 20rpx; }
  .benefit-card__brand-mark { width: 56rpx; height: 56rpx; }
  .benefit-card__icon { width: 42rpx; height: 42rpx; }
  .benefit-card__heading { margin-left: 12rpx; }
  .benefit-card__title { font-size: 29rpx; }
  .benefit-card__subtitle { font-size: 21rpx; }
  .benefit-card__header-action { width: 64rpx; height: 64rpx; margin-left: 10rpx; }
  .benefit-card__content { margin-top: 22rpx; }
  .benefit-card__quota-panel { padding-right: 12rpx; }
  .benefit-card__details { padding-left: 12rpx; }
  .benefit-card__quota-tip { top: 104rpx; right: 18rpx; left: 18rpx; padding-right: 22rpx; padding-left: 22rpx; }
  .benefit-card__quota-tip-arrow { left: 108rpx; }
  .benefit-card__quota-num { font-size: 76rpx; }
  .benefit-card__quota-unit { font-size: 32rpx; }
  .benefit-card__insight-pill { padding-right: 10rpx; padding-left: 12rpx; font-size: 18rpx; }
  .benefit-card__detail-icon-wrap { width: 50rpx; height: 50rpx; }
  .benefit-card__detail-icon { width: 28rpx; height: 28rpx; }
  .benefit-card__detail-copy { margin-left: 10rpx; }
  .benefit-card__detail-value { margin-left: 8rpx; }
  .benefit-card__detail-label { font-size: 21rpx; }
  .benefit-card__detail-count { font-size: 28rpx; }
  .benefit-card__detail-divider { margin-left: 60rpx; }
  .benefit-card__action { height: 64rpx; font-size: 24rpx; line-height: 64rpx; }
  .profile-grid { gap: 16rpx; }
  .profile-grid__item { height: 204rpx; padding: 24rpx 20rpx 24rpx 24rpx; }
  .profile-grid__icon { width: 48rpx; height: 48rpx; margin-bottom: 20rpx; }
  .profile-grid__title { font-size: 30rpx; }
}
