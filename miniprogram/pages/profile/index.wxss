@import "../../styles/profile-pages.wxss";
@import "./login-sheet.wxss";

/* ── 页面容器 ── */
.profile-page { box-sizing: border-box; padding: 16rpx var(--page-padding) 0; }

/* ── 用户卡 ── */
.user-card {
  display: flex;
  height: 192rpx;
  box-sizing: border-box;
  align-items: center;
  padding: 0 38rpx;
  border-radius: 38rpx;
  background: var(--surface);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}
.user-card__avatar {
  width: 116rpx;
  height: 116rpx;
  flex-shrink: 0;
  border-radius: 28rpx;
  background: var(--color-primary-soft);
}
.user-card__name {
  min-width: 0;
  flex: 1;
  margin-left: 30rpx;
  color: var(--color-text);
  font-size: 36rpx;
  font-weight: 600;
  line-height: 48rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.user-card__arrow {
  width: 36rpx;
  height: 36rpx;
  flex-shrink: 0;
}

/* ── 权益卡 ── */
.benefit-card {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-height: 248rpx;
  box-sizing: border-box;
  margin-top: 20rpx;
  padding: 30rpx 40rpx 28rpx;
  border-radius: 38rpx;
  background: var(--color-primary-surface);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.03);
}
.benefit-card__header {
  display: flex;
  align-items: center;
}
.benefit-card__icon {
  width: 34rpx;
  height: 34rpx;
  flex-shrink: 0;
  margin-right: 12rpx;
}
.benefit-card__title {
  color: var(--color-primary);
  font-size: 30rpx;
  font-weight: 600;
  line-height: 40rpx;
}
.benefit-card__content {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
}
.benefit-card__quota-info {
  display: flex;
  flex-direction: column;
}
.benefit-card__caption {
  margin-bottom: 8rpx;
  color: var(--color-text-secondary);
  font-size: 26rpx;
  line-height: 34rpx;
}
.benefit-card__quota-val {
  display: flex;
  align-items: baseline;
}
.benefit-card__quota-num {
  color: var(--color-primary);
  font-size: 60rpx;
  font-weight: 600;
  line-height: 1;
}
.benefit-card__quota-unit {
  margin-left: 8rpx;
  color: var(--color-text);
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1;
}
.benefit-card__action {
  display: inline-flex;
  height: 72rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: var(--color-primary);
  font-size: 26rpx;
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  transition: var(--transition-press);
}
.benefit-card__action:active {
  opacity: 0.76;
  transform: scale(0.97);
}
.benefit-card__action image { width: 28rpx; height: 28rpx; margin-left: 6rpx; }

/* ── 订单入口 ── */
.order-entry {
  display: flex;
  min-height: 112rpx;
  box-sizing: border-box;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
  padding: 24rpx 32rpx;
  border-radius: 38rpx;
  transition: var(--transition-press);
}
.order-entry:active {
  opacity: 0.72;
  transform: scale(0.98);
}
.order-entry__content {
  min-width: 0;
}
.order-entry__title {
  color: var(--color-text);
  font-size: 30rpx;
  font-weight: 600;
  line-height: 40rpx;
}
.order-entry__description {
  margin-top: 6rpx;
  color: var(--color-text-secondary);
  font-size: 23rpx;
  line-height: 34rpx;
}
.order-entry__arrow {
  width: 36rpx;
  height: 36rpx;
  flex-shrink: 0;
  margin-left: 24rpx;
}

/* ── 2×2 功能宫格 ── */
.profile-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 22rpx;
  margin-top: 20rpx;
}
.profile-grid__item {
  display: flex;
  flex-direction: row;
  height: 224rpx;
  box-sizing: border-box;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 28rpx 28rpx 32rpx;
  border-radius: 38rpx;
  background: var(--surface);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  transition: var(--transition-press);
}
.profile-grid__item:active {
  opacity: 0.72;
  transform: scale(0.98);
}
.profile-grid__body {
  display: flex;
  flex-direction: column;
  justify-content: center;
}
.profile-grid__icon {
  width: 56rpx;
  height: 56rpx;
  margin-bottom: 28rpx;
  flex-shrink: 0;
}
.profile-grid__title {
  color: var(--color-text);
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.2;
}
.profile-grid__arrow {
  width: 36rpx;
  height: 36rpx;
  flex-shrink: 0;
}

/* ── 未登录状态 ── */
.profile-guest { display: flex; flex-direction: column; min-height: 80vh; }
.guest-body { display: flex; flex: 1; flex-direction: column; align-items: center; justify-content: center; padding: 48rpx 0 32rpx; }
.guest-avatar { width: 240rpx; height: 240rpx; border-radius: 40rpx; }
.guest-title { margin-top: 48rpx; font-size: 36rpx; font-weight: 700; line-height: 50rpx; text-align: center; }
.guest-subtitle { margin-top: 12rpx; color: var(--color-text-secondary); font-size: 26rpx; line-height: 40rpx; text-align: center; }
.guest-agreement { display: flex; align-items: center; justify-content: center; margin-top: 48rpx; color: var(--color-text-secondary); font-size: 24rpx; line-height: 36rpx; white-space: nowrap; }
.guest-agreement__consent { display: flex; align-items: center; padding: 11px 0; margin: -11px 0; }
.guest-message { margin-top: 20rpx; color: var(--color-text-secondary); font-size: 24rpx; text-align: center; }
.guest-message--error { color: var(--color-danger); }
.guest-login-btn { width: 100%; max-width: 560rpx; margin-top: 32rpx; }
.guest-footer { display: flex; align-items: center; justify-content: center; padding: 40rpx 0 calc(32rpx + env(safe-area-inset-bottom)); color: var(--color-text-secondary); font-size: 24rpx; }
.guest-footer__link { color: var(--color-text-secondary); }
.guest-footer__link:active { opacity: 0.72; }
.guest-footer__dot { margin: 0 8rpx; }

/* ── Sheet 基础 ── */
.sheet-mask { position: fixed; z-index: 300; inset: 0; background: rgba(15, 18, 17, 0.48); }
.profile-sheet { position: absolute; right: 0; bottom: 0; left: 0; box-sizing: border-box; padding: 16rpx 32rpx calc(32rpx + env(safe-area-inset-bottom)); border-radius: var(--radius-card-large) var(--radius-card-large) 0 0; background: var(--color-surface); box-shadow: var(--shadow-card); }
.profile-sheet__handle { width: 80rpx; height: 8rpx; margin: 0 auto 24rpx; border-radius: 8rpx; background: var(--color-disabled); }
.profile-sheet__close { position: absolute; top: 24rpx; right: 28rpx; display: flex; width: 88rpx; height: 88rpx; align-items: center; justify-content: center; border: 0; border-radius: var(--radius-card-small); background: transparent; box-shadow: var(--shadow-ghost); transition: var(--transition-press); }
.profile-sheet__close image { width: 36rpx; height: 36rpx; }
.profile-sheet__close:active { background: var(--strong-overlay); transform: scale(0.97); }

/* ── Recharge Sheet ── */
.recharge-sheet__title { font-size: 36rpx; font-weight: 600; text-align: center; }
.recharge-sheet__quota { margin: 8rpx 0 24rpx; color: var(--color-text-secondary); font-size: 25rpx; text-align: center; }
.recharge-sheet__quota text { color: var(--color-primary); font-size: 34rpx; font-weight: 600; }
.recharge-sheet__message { padding: 28rpx 0; color: var(--color-text-secondary); font-size: 25rpx; line-height: 36rpx; text-align: center; }
.recharge-option { display: flex; height: 92rpx; align-items: center; margin-bottom: 16rpx; padding: 0 24rpx; border: 0; border-radius: var(--radius-card-small); background: var(--color-surface); box-shadow: var(--shadow-card); transition: var(--transition-press); }
.recharge-option--active { background: var(--color-primary-surface); box-shadow: 0 0 0 2rpx var(--color-primary), var(--shadow-card); }
.recharge-option:active { background: var(--strong-overlay); transform: scale(0.97); }
.package-row { display: flex; align-items: center; }
.package-icon-wrap { display: flex; width: 52rpx; height: 52rpx; flex-shrink: 0; align-items: center; justify-content: center; }
.package-icon { width: 40rpx; height: 40rpx; flex-shrink: 0; }
.recharge-option__label { min-width: 0; flex: 1; margin-left: 16rpx; font-size: 27rpx; white-space: nowrap; }
.package-right { display: flex; align-items: center; gap: 16rpx; margin-left: auto; padding-left: 16rpx; }
.recharge-option__price { min-width: 112rpx; color: var(--color-text); font-size: 30rpx; font-weight: 600; text-align: right; white-space: nowrap; }
.package-radio { display: flex; width: 32rpx; height: 32rpx; box-sizing: border-box; flex-shrink: 0; align-items: center; justify-content: center; border: 2rpx solid var(--color-disabled); border-radius: 50%; background: var(--color-surface); }
.package-radio--selected { border-color: var(--color-primary); }
.package-radio--selected::after { width: 14rpx; height: 14rpx; border-radius: 50%; background: var(--color-primary); content: ""; }
.payment-row { display: flex; height: 88rpx; align-items: center; justify-content: space-between; padding: 0 24rpx; border: 0; border-radius: var(--radius-card-small); background: var(--color-surface); box-shadow: var(--shadow-card); font-size: 26rpx; }
.payment-row__method { display: flex; align-items: center; gap: 16rpx; color: var(--color-text); }
.payment-row__arrow { width: 36rpx; height: 36rpx; }
.recharge-sheet__pay { width: calc(100vw - 64rpx); margin-top: 24rpx; }
.recharge-sheet__cancel { padding-top: 28rpx; color: var(--color-text-secondary); font-size: 27rpx; text-align: center; }

/* ── Profile Editor Sheet ── */
.profile-editor { padding-bottom: calc(48rpx + env(safe-area-inset-bottom)); text-align: center; }
.profile-editor__title { margin-top: 4rpx; font-size: 36rpx; font-weight: 600; line-height: 50rpx; }
.profile-editor__subtitle { margin-top: 6rpx; color: var(--color-text-secondary); font-size: 23rpx; line-height: 34rpx; }
.profile-editor__avatar-button { display: flex; width: 152rpx; height: 152rpx; box-sizing: border-box; align-items: center; justify-content: center; margin: 28rpx auto 30rpx; border: 0; border-radius: var(--radius-card-large); background: var(--color-primary-soft); box-shadow: var(--shadow-ghost); line-height: 1; transition: var(--transition-press); }
.profile-editor__avatar-button::after, .profile-editor__submit::after { border: 0; }
.profile-editor__avatar-button:active { background: var(--strong-overlay); transform: scale(0.97); }
.profile-editor__avatar { width: 152rpx; height: 152rpx; border-radius: 32rpx; }
.profile-editor__field { text-align: left; }
.profile-editor__label { margin-bottom: 12rpx; color: var(--color-text-secondary); font-size: 24rpx; }
.profile-editor__input { box-sizing: border-box; width: 100%; height: 88rpx; padding: 0 24rpx; border: 1rpx solid var(--color-border); border-radius: var(--radius-control); background: var(--color-background); font-size: 28rpx; }
.profile-editor__message { margin-top: 16rpx; padding: 16rpx 20rpx; border-radius: 16rpx; background: var(--color-danger-soft); color: var(--color-danger); font-size: 23rpx; line-height: 34rpx; text-align: left; }
.profile-editor__submit { display: flex; height: 92rpx; align-items: center; justify-content: center; margin-top: 32rpx; border: 0; border-radius: var(--radius-card-small); background: var(--color-primary); color: #fff; font-size: 28rpx; font-weight: 600; line-height: 92rpx; box-shadow: var(--shadow-primary); transition: var(--transition-press); }
.profile-editor__submit:active { transform: scale(0.97); }
.profile-editor__submit[disabled] { background: var(--color-primary); color: #fff; opacity: 0.5; }

@media (max-width: 340px) {
  .profile-page { padding-right: var(--page-padding-compact); padding-left: var(--page-padding-compact); }
  .benefit-card { min-height: 232rpx; padding: 24rpx 28rpx 24rpx; }
  .benefit-card__quota-num { font-size: 50rpx; }
  .benefit-card__action { height: 64rpx; padding: 0 20rpx; font-size: 24rpx; }
  .profile-grid { gap: 16rpx; }
  .profile-grid__item { height: 204rpx; padding: 24rpx 20rpx 24rpx 24rpx; }
  .profile-grid__icon { width: 48rpx; height: 48rpx; margin-bottom: 20rpx; }
  .profile-grid__title { font-size: 30rpx; }
}
