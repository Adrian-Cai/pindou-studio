.profile-card {
  display: flex;
  align-items: center;
  padding: 28rpx 8rpx 36rpx;
}

.profile-card__avatar {
  display: flex;
  width: 112rpx;
  height: 112rpx;
  align-items: center;
  justify-content: center;
  border: 10rpx solid rgba(255, 255, 255, 0.75);
  border-radius: 50%;
  background: linear-gradient(145deg, #ff9d7f, #ff7043);
  box-shadow: 0 14rpx 30rpx rgba(255, 112, 67, 0.22);
  color: #fff;
  font-size: 38rpx;
  font-weight: 700;
}

.profile-card__content {
  flex: 1;
  margin-left: 24rpx;
}

.profile-card__name {
  font-size: 36rpx;
  font-weight: 700;
}

.profile-card__desc {
  margin-top: 8rpx;
  color: #918b84;
  font-size: 23rpx;
}

.profile-card__edit {
  color: #918b84;
  font-size: 23rpx;
}

.stats {
  display: flex;
  padding: 28rpx 12rpx;
}

.stat {
  flex: 1;
  text-align: center;
}

.stat__value {
  font-size: 36rpx;
  font-weight: 700;
}

.stat__label {
  margin-top: 7rpx;
  color: #918b84;
  font-size: 21rpx;
}

.stats__line {
  width: 1rpx;
  height: 66rpx;
  align-self: center;
  background: #ece7e1;
}

.quota-card {
  display: flex;
  align-items: center;
  margin-top: 22rpx;
  padding: 28rpx;
  border-radius: 28rpx;
  background: linear-gradient(120deg, #332d29, #514840);
  color: #fff;
}

.quota-card__icon {
  display: flex;
  width: 72rpx;
  height: 72rpx;
  align-items: center;
  justify-content: center;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.12);
  font-size: 34rpx;
}

.quota-card__content {
  flex: 1;
  margin-left: 20rpx;
}

.quota-card__title {
  font-size: 28rpx;
  font-weight: 650;
}

.quota-card__desc {
  margin-top: 7rpx;
  color: rgba(255, 255, 255, 0.62);
  font-size: 21rpx;
}

.quota-card__button {
  padding: 13rpx 20rpx;
  border-radius: 24rpx;
  background: #ff8a63;
  font-size: 22rpx;
  font-weight: 600;
}

.menu {
  margin-top: 22rpx;
  padding: 4rpx 28rpx;
}

.menu__item {
  display: flex;
  height: 100rpx;
  align-items: center;
  border-bottom: 1rpx solid #eeeae5;
}

.menu__item:last-child {
  border-bottom: 0;
}

.menu__symbol {
  display: flex;
  width: 54rpx;
  height: 54rpx;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  background: #f3efea;
  color: #5f5953;
  font-size: 26rpx;
  font-weight: 650;
}

.menu__title {
  flex: 1;
  margin-left: 20rpx;
  font-size: 27rpx;
}

.menu__arrow {
  color: #b3aca4;
  font-size: 40rpx;
}

.profile__version {
  padding: 32rpx 0 10rpx;
  color: #b0a9a1;
  font-size: 20rpx;
  text-align: center;
}
