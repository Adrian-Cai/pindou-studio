@import "../../styles/profile-pages.wxss";

.recharge-page { max-width: 720rpx; margin: 0 auto; }
.recharge-hero { padding: 28rpx 0 36rpx; text-align: center; }
.recharge-hero image { width: 180rpx; height: 128rpx; }
.recharge-hero__title { margin-top: 10rpx; font-size: 38rpx; font-weight: 600; }
.recharge-hero__quota { margin-top: 8rpx; color: var(--color-text-secondary); font-size: 25rpx; }
.recharge-hero__quota text { color: var(--color-primary); font-size: 36rpx; font-weight: 600; }

.recharge-options { display: grid; gap: 18rpx; }
.recharge-option { display: flex; height: 104rpx; align-items: center; padding: 0 28rpx; border: 1rpx solid var(--color-border); border-radius: var(--radius-control); background: #fff; }
.recharge-option--active { border: 2rpx solid var(--color-primary); background: #f8fffb; box-shadow: 0 8rpx 24rpx rgba(18, 180, 102, 0.08); }
.recharge-option image { width: 82rpx; height: 62rpx; }
.recharge-option__label { flex: 1; margin-left: 18rpx; font-size: 28rpx; }
.recharge-option__price { font-size: 31rpx; font-weight: 600; }
.recharge-option--active .recharge-option__price { color: var(--color-primary); }
.recharge-option__check { display: flex; width: 36rpx; height: 36rpx; align-items: center; justify-content: center; margin-left: 18rpx; border-radius: 50%; background: var(--color-primary); color: #fff; font-size: 22rpx; }

.payment-method { display: flex; height: 88rpx; align-items: center; justify-content: space-between; margin-top: 24rpx; padding: 0 28rpx; font-size: 27rpx; box-shadow: none; }
.payment-method view text { color: var(--color-primary); }
.recharge-button { width: 100%; margin-top: 24rpx; }
.recharge-notes { margin-top: 22rpx; color: var(--color-text-tertiary); font-size: 21rpx; line-height: 34rpx; text-align: center; }
