@import "../../styles/profile-pages.wxss";

.favorite-tabs { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16rpx; }
.favorite-tabs__item { position: relative; display: flex; min-width: 0; height: 72rpx; align-items: center; justify-content: center; padding: 0 12rpx; border: 1rpx solid var(--color-border); border-radius: var(--radius-full); background: #fff; font-size: 25rpx; white-space: nowrap; }
.favorite-tabs__item--active { border: 2rpx solid var(--color-primary); color: var(--color-primary); font-weight: 600; }
.favorite-tabs__item--active::after { position: absolute; right: 34%; bottom: -2rpx; left: 34%; height: 6rpx; border-radius: 6rpx; background: var(--color-primary); content: ""; }

.favorite-summary { display: flex; padding: 36rpx 52rpx; }
.favorite-summary__item { display: flex; flex: 1; align-items: center; justify-content: center; gap: 24rpx; color: var(--color-text-secondary); font-size: 24rpx; }
.favorite-summary__item text { margin-right: 8rpx; color: var(--color-primary); font-size: 44rpx; font-weight: 600; }
.favorite-summary__badge { display: flex; width: 88rpx; height: 88rpx; align-items: center; justify-content: center; border-radius: 50%; background: var(--color-primary-soft); color: var(--color-primary); font-size: 42rpx; }
.favorite-summary__badge--yellow { background: #fff8e8; color: #f4b223; }
.favorite-summary__line { width: 1rpx; height: 80rpx; background: var(--color-border); }

.favorite-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24rpx; margin-top: 24rpx; }
.favorite-card { min-width: 0; padding: 18rpx; }
.favorite-card__main { display: grid; grid-template-columns: 52% minmax(0, 1fr); gap: 20rpx; }
.favorite-card__cover { width: 100%; height: 200rpx; border-radius: var(--radius-media); background: var(--color-surface-muted); }
.favorite-card__info { min-width: 0; }
.favorite-card__title { overflow: hidden; font-size: 28rpx; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
.favorite-card__meta { margin-top: 18rpx; color: var(--color-text-secondary); font-size: 22rpx; white-space: nowrap; }
.favorite-card__date { margin-top: 36rpx; color: var(--color-text-tertiary); font-size: 21rpx; line-height: 32rpx; }
.favorite-card__actions { display: flex; align-items: center; gap: 16rpx; margin-top: 20rpx; }
.favorite-card__heart { color: var(--color-primary); font-size: 42rpx; }
.favorite-card__view { height: 58rpx; flex: 1; border: 2rpx solid var(--color-primary); border-radius: var(--radius-control); color: var(--color-primary); font-size: 24rpx; line-height: 58rpx; text-align: center; }
.favorite-card__more { display: flex; width: 58rpx; height: 58rpx; align-items: center; justify-content: center; border: 1rpx solid var(--color-border); border-radius: 50%; font-size: 18rpx; }

@media (max-width: 380px) {
  .favorite-tabs { gap: 8rpx; }
  .favorite-tabs__item { padding: 0 6rpx; font-size: 21rpx; }
  .favorite-summary { padding: 28rpx 20rpx; }
  .favorite-summary__badge { width: 68rpx; height: 68rpx; }
  .favorite-grid { grid-template-columns: 1fr; }
}
