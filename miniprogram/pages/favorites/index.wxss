@import "../../styles/content.wxss";

.favorite-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.favorite-card {
  overflow: hidden;
  border: 1rpx solid #e8e3dc;
  border-radius: 24rpx;
  background: #fff;
}

.favorite-card__cover {
  width: 100%;
  height: 300rpx;
  background: #eeeae5;
}

.favorite-card__info {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx;
}

.favorite-card__title {
  overflow: hidden;
  font-size: 25rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.favorite-card__heart {
  color: #ff7043;
}
