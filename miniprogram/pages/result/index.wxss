.result-page {
  --color-primary: #12b466;
  --color-primary-pressed: #0f9f5b;
  --color-primary-soft: #ecfaf3;
  --color-surface: #ffffff;
  --color-surface-muted: #fafafa;
  --color-text: #111111;
  --color-text-secondary: #666666;
  --color-text-tertiary: #888888;
  --color-border: #eeeeee;
  --color-brand: #12b466;
  height: 100vh;
  overflow: hidden;
  background: #f8f9f8;
  color: var(--color-text);
}

.result-header {
  position: fixed;
  z-index: 30;
  top: 0;
  right: 0;
  left: 0;
}

.result-scroll {
  width: 100%;
}

.result-scroll__spacer {
  height: calc(132rpx + env(safe-area-inset-bottom));
}

.result-content {
  padding: 16rpx 32rpx 48rpx;
}

.work-summary,
.result-panel,
.quota-strip {
  border: 1rpx solid var(--color-border);
  border-radius: 32rpx;
  background: var(--color-surface);
  box-shadow: 0 4rpx 20rpx rgba(17, 56, 36, 0.04);
}

.work-summary {
  position: relative;
  display: grid;
  grid-template-columns: 144rpx minmax(0, 1fr);
  gap: 24rpx;
  align-items: center;
  padding: 28rpx;
}

.work-summary__thumb-canvas {
  position: absolute;
  top: 0;
  left: -9999px;
  width: 144rpx;
  height: 144rpx;
  pointer-events: none;
}

.preview-render-canvas {
  position: absolute;
  top: 0;
  left: -9999px;
  width: calc(100vw - 120rpx);
  height: calc(100vw - 120rpx);
  pointer-events: none;
}

.work-summary__thumb {
  width: 144rpx;
  height: 144rpx;
  border: 1rpx solid var(--color-border);
  border-radius: 16rpx;
  background: #f7f7f9;
  flex-shrink: 0;
}

.work-summary__info {
  min-width: 0;
  padding-right: 116rpx;
}

.work-summary__title-button {
  position: relative;
  display: flex;
  box-sizing: border-box;
  width: 100%;
  min-width: 0;
  min-height: 56rpx;
  align-items: center;
  justify-content: flex-start;
  gap: 10rpx;
  margin: -6rpx 0 0;
  padding: 6rpx 0;
  border-radius: 8rpx;
  background: transparent;
  color: var(--color-text);
  font-size: 32rpx;
  font-weight: 600;
  line-height: 44rpx;
  text-align: left;
}

.work-summary__title-button::after {
  border: 0;
}

.work-summary__title-button::before {
  position: absolute;
  top: -16rpx;
  right: -8rpx;
  bottom: -16rpx;
  left: -8rpx;
  content: "";
}

.work-summary__title-button--pressed {
  opacity: 0.58;
}

.work-summary__title-button[disabled] {
  color: var(--color-text);
  opacity: 0.58;
}

.work-summary__title {
  min-width: 0;
  overflow: hidden;
  flex: 0 1 auto;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.work-summary__edit-icon {
  width: 28rpx;
  height: 28rpx;
  flex: 0 0 28rpx;
}

.work-summary__meta,
.work-summary__count {
  margin-top: 8rpx;
  color: var(--color-text);
  font-size: 28rpx;
  font-weight: 400;
  line-height: 44rpx;
}

.work-summary__count {
  font-weight: 500;
}

.work-summary__date {
  overflow: hidden;
  margin-top: 12rpx;
  color: var(--color-text-tertiary);
  font-size: 24rpx;
  font-weight: 400;
  line-height: 36rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.favorite {
  position: absolute;
  min-width: 0;
  top: 28rpx;
  right: 28rpx;
  display: flex;
  width: 112rpx;
  height: 56rpx;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 0;
  border: 1rpx solid var(--color-border);
  border-radius: 12rpx;
  background: #ffffff;
  color: var(--color-text-secondary);
  font-size: 22rpx;
  font-weight: 500;
  line-height: 56rpx;
}

.favorite--active {
  border-color: rgba(18, 180, 102, 0.28);
  background: var(--color-primary-soft);
  color: var(--color-primary);
}

.favorite__heart {
  font-size: 28rpx;
}

.result-tabs {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  margin-top: 16rpx;
  border-bottom: 1rpx solid var(--color-border);
}

.result-tabs__item {
  position: relative;
  box-sizing: border-box;
  min-width: 0;
  height: 96rpx;
  padding: 0;
  background: transparent;
  color: var(--color-text-secondary);
  font-size: 30rpx;
  font-weight: 500;
  line-height: 96rpx;
  text-align: center;
}

.result-tabs__item--active {
  color: var(--color-primary);
  font-weight: 600;
}

.result-tabs__item--active::after {
  position: absolute;
  right: 24rpx;
  bottom: -1rpx;
  left: 24rpx;
  height: 6rpx;
  border-radius: 6rpx;
  background: var(--color-primary);
  content: "";
}

.render-error {
  margin-top: 24rpx;
  padding: 20rpx 24rpx;
  border: 1rpx solid rgba(229, 72, 77, 0.24);
  border-radius: 16rpx;
  background: #fff7f7;
  color: #b42328;
  font-size: 23rpx;
  line-height: 34rpx;
}

.result-panel {
  margin-top: 24rpx;
  padding: 28rpx;
}

.panel-heading {
  margin-bottom: 24rpx;
}

.panel-heading__title {
  color: var(--color-text);
  font-size: 32rpx;
  font-weight: 600;
  line-height: 48rpx;
}

.panel-heading__hint {
  margin-top: 8rpx;
  color: var(--color-text-secondary);
  font-size: 24rpx;
  font-weight: 400;
  line-height: 36rpx;
}

.preview-stage {
  box-sizing: border-box;
  width: 100%;
  overflow: hidden;
  border-radius: 16rpx;
  aspect-ratio: 1;
  background: var(--color-primary-soft);
}

.preview-stage__image {
  display: block;
  width: 100%;
  height: 100%;
}

.download-format {
  margin-top: 16rpx;
  color: var(--color-text-secondary);
  font-size: 22rpx;
  line-height: 32rpx;
}

.download-button {
  display: flex;
  width: 100%;
  height: 80rpx;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin-top: 20rpx;
  padding: 0 24rpx;
  border-radius: 12rpx;
  background: var(--color-primary);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 80rpx;
}

.download-button:active {
  background: var(--color-primary-pressed);
  transform: scale(0.98);
}

.download-button__icon {
  font-size: 36rpx;
  font-weight: 400;
}

.material-summary {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.material-summary > view {
  padding: 24rpx;
  border-radius: 16rpx;
  background: var(--color-surface-muted);
}

.material-summary__value {
  font-size: 38rpx;
  font-weight: 600;
}

.material-summary__unit {
  margin-left: 6rpx;
  color: var(--color-text-secondary);
  font-size: 22rpx;
}

.material-summary__label {
  margin-top: 6rpx;
  color: var(--color-text-secondary);
  font-size: 22rpx;
}

.material-list {
  border-top: 1rpx solid var(--color-border);
}

.material-list__header,
.material-row {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 104rpx 96rpx;
  column-gap: 16rpx;
  align-items: center;
  border-bottom: 1rpx solid var(--color-border);
}

.material-list__header {
  min-height: 56rpx;
  color: var(--color-text-tertiary);
  font-size: 22rpx;
}

.material-list__header-number {
  text-align: right;
}

.material-row {
  min-height: 88rpx;
}

.material-row__color {
  display: flex;
  min-width: 0;
  align-items: center;
}

.material-row__swatch {
  box-sizing: border-box;
  flex: 0 0 auto;
  width: 24rpx;
  height: 24rpx;
  border: 1rpx solid rgba(17, 17, 17, 0.1);
  border-radius: 50%;
}

.material-row__detail {
  min-width: 0;
  flex: 1;
  margin-left: 20rpx;
}

.material-row__code {
  font-size: 25rpx;
  font-weight: 600;
}

.material-row__hex {
  margin-top: 2rpx;
  color: var(--color-text-tertiary);
  font-size: 19rpx;
  text-transform: uppercase;
}

.material-row__count {
  color: var(--color-text-secondary);
  font-size: 23rpx;
  font-variant-numeric: tabular-nums;
  text-align: right;
}

.material-row__percentage {
  color: var(--color-text);
  font-size: 23rpx;
  font-variant-numeric: tabular-nums;
  font-weight: 500;
  text-align: right;
}

.material-list__toggle {
  box-sizing: border-box;
  display: flex;
  width: 100%;
  height: 96rpx;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  margin: 8rpx 0 0;
  padding: 0 24rpx;
  border-radius: 12rpx;
  background: transparent;
  color: var(--color-primary);
  font-size: 24rpx;
  font-weight: 500;
  line-height: 96rpx;
}

.material-list__toggle::after {
  border: 0;
}

.material-list__toggle:active {
  background: var(--color-primary-soft);
}

.material-list__toggle-icon {
  font-size: 26rpx;
}

.chart-render-canvas {
  position: absolute;
  top: 0;
  left: -9999px;
  pointer-events: none;
}

.chart-stage {
  box-sizing: border-box;
  width: 100%;
  padding: 1rpx;
  border: 1rpx solid var(--color-border);
  border-radius: 16rpx;
  background: var(--color-surface-muted);
}

.chart-stage__image {
  display: block;
  width: 100%;
  height: auto;
  background: #ffffff;
}

.chart-loading {
  padding: 32rpx 0;
  color: var(--color-text-secondary);
  font-size: 24rpx;
  line-height: 36rpx;
  text-align: center;
}

.palette-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  column-gap: 24rpx;
  row-gap: 40rpx;
}

.palette-card {
  min-width: 0;
  text-align: center;
}

.palette-card__color {
  box-sizing: border-box;
  width: 100%;
  border: 1rpx solid rgba(17, 17, 17, 0.08);
  border-radius: 16rpx;
  aspect-ratio: 1;
}

.palette-card__code {
  overflow: hidden;
  margin-top: 16rpx;
  color: var(--color-text);
  font-size: 24rpx;
  font-weight: 600;
  line-height: 36rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.palette-card__count {
  overflow: hidden;
  margin-top: 2rpx;
  color: var(--color-text-tertiary);
  font-size: 21rpx;
  font-variant-numeric: tabular-nums;
  line-height: 32rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.panel-empty {
  padding: 64rpx 24rpx;
  color: var(--color-text-tertiary);
  font-size: 24rpx;
  text-align: center;
}

.quota-strip {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
  padding: 24rpx 28rpx;
  color: var(--color-text-secondary);
  font-size: 22rpx;
}

.quota-strip__value,
.quota-strip__link {
  color: var(--color-primary);
  font-weight: 500;
}

.result-empty {
  margin: 120rpx 32rpx 0;
  padding: 64rpx 40rpx;
  border: 1rpx solid var(--color-border);
  border-radius: 32rpx;
  background: #ffffff;
  text-align: center;
}

.result-empty__mark {
  color: var(--color-primary);
  font-size: 72rpx;
}

.result-empty__title {
  margin-top: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.result-empty__hint {
  margin-top: 12rpx;
  color: var(--color-text-secondary);
  font-size: 23rpx;
  line-height: 36rpx;
}

.result-empty__button {
  margin-top: 32rpx;
}

.result-nav {
  position: fixed;
  z-index: 20;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  box-sizing: content-box;
  height: 104rpx;
  padding-bottom: env(safe-area-inset-bottom);
  border-top: 1rpx solid var(--color-border);
  background: rgba(255, 255, 255, 0.98);
}

.result-nav__item {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #8a908c;
  font-size: 20rpx;
  line-height: 28rpx;
}

.result-nav__item--active {
  color: var(--color-primary);
  font-weight: 500;
}

.result-nav__icon {
  width: 40rpx;
  height: 40rpx;
  margin-bottom: 2rpx;
}

@media (max-width: 340px) {
  .result-content {
    padding-right: 24rpx;
    padding-left: 24rpx;
  }

  .work-summary {
    grid-template-columns: 128rpx minmax(0, 1fr);
    gap: 20rpx;
    padding: 24rpx;
  }

  .work-summary__thumb {
    width: 128rpx;
    height: 128rpx;
  }

  .work-summary__info {
    padding-right: 104rpx;
  }

  .favorite {
    top: 24rpx;
    right: 24rpx;
    width: 100rpx;
  }

  .result-tabs__item {
    font-size: 24rpx;
  }

  .quota-strip {
    align-items: flex-start;
    gap: 12rpx;
    flex-direction: column;
  }
}
