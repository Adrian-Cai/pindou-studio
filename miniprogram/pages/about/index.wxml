      <view class="about-menu__item" data-id="update" bindtap="openItem"><text class="about-menu__icon about-menu__icon--blue">⇧</text><view>检查更新</view><text class="about-menu__meta">当前已是最新版本　›</text></view>
      <view class="about-menu__item" data-id="support" bindtap="openItem"><text class="about-menu__icon about-menu__icon--yellow">☏</text><view>联系客服</view><text class="about-menu__meta">工作日 9:00-18:00　›</text></view>
    </view>

    <view class="about-footer">
      <view>© 2026 拼豆制作工具</view>
      <view>由 拼豆工作室 用心打造</view>
