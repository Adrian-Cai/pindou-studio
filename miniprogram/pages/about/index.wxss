@import "../../styles/content.wxss";

.about {
  padding-top: 42rpx;
  text-align: center;
}

.about__logo {
  display: flex;
  width: 132rpx;
  height: 132rpx;
  align-items: center;
  justify-content: center;
  margin: 0 auto;
  border: 12rpx solid rgba(255, 255, 255, 0.7);
  border-radius: 42rpx;
  background: linear-gradient(145deg, #ff9d7f, #ff7043);
  box-shadow: 0 18rpx 42rpx rgba(255, 112, 67, 0.24);
  color: #fff;
  font-size: 48rpx;
  font-weight: 700;
}

.about__name {
  margin-top: 26rpx;
  font-size: 36rpx;
  font-weight: 700;
}

.about__version {
  margin: 8rpx 0 40rpx;
  color: #a19a92;
  font-size: 21rpx;
}

.about__story,
.about__links {
  text-align: left;
}

.about__link {
  display: flex;
  height: 94rpx;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid #eeeae5;
}

.about__link:last-child {
  border-bottom: 0;
}
