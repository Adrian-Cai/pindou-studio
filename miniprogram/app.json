{
  "pages": [
    "pages/home/index",
    "pages/projects/index",
    "pages/profile/index"
  ],
  "subPackages": [
    {
      "root": "pages-sub",
      "pages": [
        "editor/index",
        "result/index",
        "downloads/index",
        "favorites/index",
        "help/index",
        "about/index",
        "privacy/index",
        "privacy-document/index",
        "feedback/index",
        "recharge/index",
        "payment-success/index",
        "settings/index"
      ]
    }
  ],
  "preloadRule": {
    "pages/profile/index": {
      "network": "all",
      "packages": ["pages-sub"]
    }
  },
  "window": {
    "navigationStyle": "custom",
    "backgroundColor": "#FFFFFF",
    "backgroundTextStyle": "dark"
  },
  "tabBar": {
    "custom": true,
    "color": "#8A908C",
    "selectedColor": "#12B466",
    "backgroundColor": "#FFFFFF",
    "list": [
      { "pagePath": "pages/home/index", "text": "首页" },
      { "pagePath": "pages/projects/index", "text": "作品" },
      { "pagePath": "pages/profile/index", "text": "我的" }
    ]
  },
  "sitemapLocation": "sitemap.json",
  "lazyCodeLoading": "requiredComponents",
  "style": "v2"
}
