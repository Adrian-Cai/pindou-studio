<view wx:if="{{visible}}" class="download-sheet" catchtouchmove="preventTouchMove">
  <!-- 半透明黑色背景遮罩 -->
  <view
    class="download-sheet__mask"
    bindtap="onTapMask"
    role="button"
    aria-label="关闭弹层"
  ></view>

  <!-- 底部半屏面板 -->
  <view class="download-sheet__panel" role="dialog" aria-modal="true">
    <!-- 顶部轻量 Drag Handle -->
    <view class="download-sheet__handle"></view>

    <!-- ── 状态 1：确认下载 / 保存中 ── -->
    <block wx:if="{{state === 'confirm' || state === 'processing'}}">
      <view class="download-sheet__title">{{config.title}}</view>

      <!-- 文件类型展示卡片 -->
      <view class="download-sheet__file-card">
        <view class="download-sheet__file-icon download-sheet__file-icon--{{config.iconType}}">
          <!-- 成品图图标 -->
          <image
            wx:if="{{config.iconType === 'image'}}"
            class="download-sheet__icon-img"
            src="/assets/icons/project-summary-gallery.svg"
            mode="aspectFit"
          />
          <!-- 材料清单图标 -->
          <image
            wx:elif="{{config.iconType === 'document'}}"
            class="download-sheet__icon-img"
            src="/assets/icons/project-summary-document.svg"
            mode="aspectFit"
          />
          <!-- 施工图图标 -->
          <image
            wx:elif="{{config.iconType === 'chart'}}"
            class="download-sheet__icon-img"
            src="/assets/icons/bead-stack.svg"
            mode="aspectFit"
          />
          <!-- 色板参考图标 -->
          <image
            wx:else
            class="download-sheet__icon-img"
            src="/assets/icons/palette-grid.svg"
            mode="aspectFit"
          />
        </view>

        <view class="download-sheet__file-info">
          <view class="download-sheet__file-name">{{config.fileLabel}}</view>
          <view class="download-sheet__file-desc">{{config.description}}</view>
        </view>

        <view class="download-sheet__file-check">
          <text class="download-sheet__check-symbol">✓</text>
        </view>
      </view>

      <!-- 下载参数明细卡片 -->
      <view class="download-sheet__meta-card">
        <view class="download-sheet__meta-row">
          <text class="download-sheet__meta-label">保存位置</text>
          <text class="download-sheet__meta-value">{{config.saveLocation}}</text>
        </view>
        <view class="download-sheet__meta-row">
          <text class="download-sheet__meta-label">本次消耗</text>
          <text class="download-sheet__meta-value">{{isVip ? '会员权益免费' : costText}}</text>
        </view>
        <view class="download-sheet__meta-row">
          <text class="download-sheet__meta-label">今日剩余</text>
          <text class="download-sheet__meta-value download-sheet__meta-value--purple">{{isVip ? '无限下载' : (quota + ' 次')}}</text>
        </view>
      </view>

      <!-- 确认下载主按钮 -->
      <button
        class="download-sheet__cta-btn {{state === 'processing' ? 'download-sheet__cta-btn--loading' : ''}}"
        bindtap="onConfirm"
        disabled="{{state === 'processing'}}"
        role="button"
        aria-label="{{state === 'processing' ? '正在保存文件' : '确认下载'}}"
      >
        <view wx:if="{{state === 'processing'}}" class="download-sheet__spinner"></view>
        <image
          wx:else
          class="download-sheet__cta-icon"
          src="/assets/icons/import-arrow.svg"
          mode="aspectFit"
        />
        <text>{{state === 'processing' ? '正在保存…' : '确认下载'}}</text>
      </button>

      <!-- 取消按钮 -->
      <view
        class="download-sheet__cancel-btn {{state === 'processing' ? 'download-sheet__cancel-btn--disabled' : ''}}"
        bindtap="onCancel"
        role="button"
        aria-label="取消下载"
      >取消</view>
    </block>

    <!-- ── 状态 2：下载成功 ── -->
    <block wx:elif="{{state === 'success'}}">
      <!-- 绿色发光成功图标 -->
      <view class="download-sheet__success-badge">
        <view class="download-sheet__success-halo">
          <view class="download-sheet__success-circle">
            <text class="download-sheet__success-check">✓</text>
          </view>
        </view>
      </view>

      <!-- 成功标题与文案 -->
      <view class="download-sheet__success-title">{{config.successTitle || '下载成功'}}</view>
      <view class="download-sheet__success-desc">{{config.successDescription}}</view>
      <view class="download-sheet__success-hint">{{config.successHint}}</view>

      <!-- 剩余次数状态条 -->
      <view class="download-sheet__quota-bar">
        <image
          class="download-sheet__quota-icon"
          src="/assets/icons/import-arrow.svg"
          mode="aspectFit"
        />
        <text class="download-sheet__quota-text">
          <text>今日剩余 </text>
          <text class="download-sheet__quota-num">{{quota}}</text>
          <text> 次下载</text>
        </text>
      </view>

      <!-- 查看图片/文件主按钮 -->
      <button
        class="download-sheet__cta-btn"
        bindtap="onPreview"
        role="button"
        aria-label="{{config.primaryActionLabel || '查看图片'}}"
      >
        <image
          class="download-sheet__cta-icon"
          src="/assets/icons/project-summary-gallery.svg"
          mode="aspectFit"
        />
        <text>{{config.primaryActionLabel || '查看图片'}}</text>
      </button>

      <!-- 完成按钮 -->
      <view
        class="download-sheet__cancel-btn"
        bindtap="onComplete"
        role="button"
        aria-label="完成"
      >完成</view>
    </block>
  </view>
</view>
