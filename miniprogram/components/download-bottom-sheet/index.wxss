.download-sheet {
  position: fixed;
  z-index: 1000;
  inset: 0;
}

.download-sheet__mask {
  position: fixed;
  z-index: 1001;
  inset: 0;
  background: rgba(0, 0, 0, 0.45);
  animation: sheetFadeIn 0.25s ease-out forwards;
}

.download-sheet__panel {
  position: fixed;
  z-index: 1002;
  right: 0;
  bottom: 0;
  left: 0;
  box-sizing: border-box;
  width: 100%;
  padding: 20rpx 40rpx calc(32rpx + env(safe-area-inset-bottom));
  border-radius: 40rpx 40rpx 0 0;
  background: #ffffff;
  box-shadow: 0 -8rpx 32rpx rgba(0, 0, 0, 0.08);
  animation: sheetSlideUp 0.28s cubic-bezier(0.25, 1, 0.5, 1) forwards;
}

.download-sheet__handle {
  width: 72rpx;
  height: 8rpx;
  margin: 0 auto 32rpx;
  border-radius: 4rpx;
  background: #d6d6d8;
}

/* ── 确认状态样式 ── */
.download-sheet__title {
  color: #111111;
  font-size: 36rpx;
  font-weight: 600;
  line-height: 48rpx;
  margin-bottom: 32rpx;
  text-align: center;
}

.download-sheet__file-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 24rpx;
  padding: 24rpx 28rpx;
  border: 2rpx solid #efeff2;
  border-radius: 24rpx;
  background: #ffffff;
}

.download-sheet__file-icon {
  display: flex;
  width: 88rpx;
  height: 88rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
  background: #6F5BFF;
}

.download-sheet__icon-img {
  width: 46rpx;
  height: 46rpx;
  filter: brightness(0) invert(1);
}

.download-sheet__file-info {
  min-width: 0;
  flex: 1;
}

.download-sheet__file-name {
  color: #111111;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 42rpx;
}

.download-sheet__file-desc {
  margin-top: 6rpx;
  color: #888888;
  font-size: 24rpx;
  line-height: 34rpx;
}

.download-sheet__file-check {
  display: flex;
  width: 44rpx;
  height: 44rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #6F5BFF;
}

.download-sheet__check-symbol {
  color: #ffffff;
  font-size: 26rpx;
  font-weight: bold;
  line-height: 1;
}

.download-sheet__meta-card {
  margin-bottom: 36rpx;
  padding: 24rpx 32rpx;
  border-radius: 24rpx;
  background: #f8f8fa;
}

.download-sheet__meta-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10rpx 0;
}

.download-sheet__meta-label {
  color: #666666;
  font-size: 26rpx;
  line-height: 36rpx;
}

.download-sheet__meta-value {
  color: #333333;
  font-size: 26rpx;
  line-height: 36rpx;
}

.download-sheet__meta-value--purple {
  color: #6F5BFF;
  font-weight: 600;
}

/* ── 成功状态样式 ── */
.download-sheet__success-badge {
  display: flex;
  justify-content: center;
  margin-top: 8rpx;
  margin-bottom: 24rpx;
}

.download-sheet__success-halo {
  display: flex;
  width: 136rpx;
  height: 136rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #e6f9ee;
}

.download-sheet__success-circle {
  display: flex;
  width: 92rpx;
  height: 92rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #12b466;
  box-shadow: 0 4rpx 16rpx rgba(18, 180, 102, 0.35);
}

.download-sheet__success-check {
  color: #ffffff;
  font-size: 48rpx;
  font-weight: bold;
  line-height: 1;
}

.download-sheet__success-title {
  color: #111111;
  font-size: 38rpx;
  font-weight: 700;
  line-height: 52rpx;
  text-align: center;
}

.download-sheet__success-desc {
  margin-top: 12rpx;
  color: #333333;
  font-size: 28rpx;
  line-height: 40rpx;
  text-align: center;
}

.download-sheet__success-hint {
  margin-top: 8rpx;
  color: #888888;
  font-size: 24rpx;
  line-height: 34rpx;
  text-align: center;
}

.download-sheet__quota-bar {
  display: flex;
  height: 72rpx;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin: 32rpx 0 36rpx;
  padding: 0 24rpx;
  border-radius: 16rpx;
  background: #f0fbf4;
}

.download-sheet__quota-icon {
  width: 28rpx;
  height: 28rpx;
  filter: invert(48%) sepia(85%) saturate(490%) hue-rotate(100deg) brightness(92%) contrast(92%);
}

.download-sheet__quota-text {
  color: #166534;
  font-size: 26rpx;
  line-height: 36rpx;
}

.download-sheet__quota-num {
  margin: 0 4rpx;
  color: #12b466;
  font-weight: 700;
}

/* ── 按钮与交互 ── */
.download-sheet__cta-btn {
  display: flex;
  box-sizing: border-box;
  width: 100%;
  height: 96rpx;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin: 0;
  padding: 0 32rpx;
  border: 0;
  border-radius: 24rpx;
  background: linear-gradient(90deg, #6A55F6, #8A63FF);
  box-shadow: 0 8rpx 20rpx rgba(106, 85, 246, 0.28);
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 96rpx;
}

.download-sheet__cta-btn::after {
  border: 0;
}

.download-sheet__cta-btn:active {
  background: #5B48E0;
  transform: scale(0.99);
}

.download-sheet__cta-btn--loading {
  opacity: 0.88;
}

.download-sheet__cta-icon {
  width: 36rpx;
  height: 36rpx;
  filter: brightness(0) invert(1);
}

.download-sheet__spinner {
  width: 32rpx;
  height: 32rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.35);
  border-top-color: #ffffff;
  border-radius: 50%;
  animation: sheetSpin 0.8s linear infinite;
}

.download-sheet__cancel-btn {
  display: flex;
  width: 100%;
  height: 80rpx;
  align-items: center;
  justify-content: center;
  margin-top: 16rpx;
  color: #666666;
  font-size: 30rpx;
  text-align: center;
}

.download-sheet__cancel-btn:active {
  opacity: 0.65;
}

.download-sheet__cancel-btn--disabled {
  opacity: 0.45;
  pointer-events: none;
}

/* ── 动画 ── */
@keyframes sheetFadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes sheetSlideUp {
  from {
    transform: translateY(100%);
  }
  to {
    transform: translateY(0);
  }
}

@keyframes sheetSpin {
  0% {
    transform: rotate(0deg);
  }
  100% {
    transform: rotate(360deg);
  }
}
