.top-bar {
  background: rgba(255, 255, 255, 0.96);
}

.top-bar--home {
  background: #ffffff;
}

.top-bar--home .top-bar__inner {
  box-sizing: border-box;
  /* 高度由 navigationBarHeight 动态注入，不再硬编码 */
  padding: 0 40rpx;
}

.top-bar--dynamic-height .top-bar__inner {
  height: var(--top-bar-navigation-height);
}

.top-bar--home .top-bar__heading {
  position: absolute;
  left: 50%;
  width: auto;
  align-items: center;
  transform: translateX(-50%);
}

.top-bar--home .top-bar__title {
  color: #15151a;
  font-size: 36rpx;
  font-weight: 600;
  line-height: 52rpx;
}

.top-bar__inner {
  display: flex;
  box-sizing: border-box;
  height: 112rpx;
  align-items: center;
  padding: 0 32rpx;
}

.top-bar__heading {
  position: absolute;
  left: 50%;
  display: flex;
  max-width: calc(100% - 224rpx);
  flex-direction: column;
  align-items: center;
  justify-content: center;
  transform: translateX(-50%);
}

.top-bar__title {
  color: #111111;
  font-size: 34rpx;
  font-weight: 600;
  line-height: 48rpx;
}

.top-bar__subtitle {
  margin-top: 8rpx;
  color: #666666;
  font-size: 22rpx;
  line-height: 32rpx;
}

.top-bar__back,
.top-bar__action,
.top-bar__side {
  box-sizing: border-box;
  width: 112rpx;
}

.top-bar__back,
.top-bar__action {
  min-height: 80rpx;
  padding: 0;
  background: transparent;
  color: #111111;
  line-height: 80rpx;
}

.top-bar__back {
  position: relative;
  margin: 0;
  overflow: visible;
  font-family: Arial, sans-serif;
  text-align: left;
}

.top-bar__back-icon {
  position: absolute;
  display: block;
  width: 48rpx;
  height: 48rpx;
  top: 50%;
  left: 0;
  transform: translateY(-50%);
}

.top-bar__back.top-bar__back--positioned {
  position: absolute;
  left: var(--top-bar-back-inset);
  display: flex;
  width: 88rpx;
  min-width: 88rpx;
  max-width: 88rpx;
  height: 88rpx;
  min-height: 88rpx;
  align-items: center;
  justify-content: flex-start;
  line-height: 1;
  text-align: left;
}

.top-bar__back.top-bar__back--positioned .top-bar__back-icon {
  position: static;
  transform: none;
}

.top-bar__action {
  color: #12b466;
  font-size: 24rpx;
  font-weight: 500;
  text-align: right;
}

.top-bar__action--more {
  width: 64rpx;
  min-height: 64rpx;
  height: 64rpx;
  margin-left: 48rpx;
  border: 1rpx solid #eeeeee;
  border-radius: 32rpx;
  color: #111111;
  font-size: 18rpx;
  letter-spacing: 2rpx;
  line-height: 62rpx;
  text-align: center;
}

.top-bar__inner {
  position: relative;
}

.top-bar__back,
.top-bar__action,
.top-bar__side {
  min-width: 0;
  flex-shrink: 0;
}

.top-bar__title {
  white-space: nowrap;
}

.top-bar--with-more .top-bar__heading {
  position: absolute;
  left: 50%;
  width: 240rpx;
  transform: translateX(-50%);
}

.top-bar__action--more {
  min-width: 64rpx;
  margin-left: auto;
}
