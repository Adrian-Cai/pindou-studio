.top-bar {
  background: var(--surface);
}

.top-bar--home {
  background: var(--surface);
}

.top-bar--home .top-bar__inner {
  box-sizing: border-box;
  /* 高度由 navigationBarHeight 动态注入，不再硬编码 */
  padding: 0 40rpx;
}

.top-bar--dynamic-height .top-bar__inner {
  height: var(--top-bar-navigation-height);
}

.top-bar--home .top-bar__heading {
  position: absolute;
  left: 50%;
  width: auto;
  align-items: center;
  transform: translateX(-50%);
}

.top-bar--home .top-bar__title {
  font-family: var(--font-heading);
  color: var(--text);
  font-size: var(--font-size-h2);
  font-weight: 600;
  line-height: var(--line-height-h2);
  letter-spacing: var(--letter-spacing-h2);
}

.top-bar__inner {
  display: flex;
  box-sizing: border-box;
  height: 112rpx;
  align-items: center;
  padding: 0 32rpx;
}

.top-bar__heading {
  position: absolute;
  left: 50%;
  display: flex;
  max-width: calc(100% - 224rpx);
  flex-direction: column;
  align-items: center;
  justify-content: center;
  transform: translateX(-50%);
}

.top-bar__title {
  font-family: var(--font-heading);
  color: var(--text);
  font-size: var(--font-size-h2);
  font-weight: 600;
  line-height: var(--line-height-h2);
  letter-spacing: var(--letter-spacing-h2);
}

.top-bar__subtitle {
  margin-top: 8rpx;
  color: var(--muted);
  font-size: 22rpx;
  line-height: 32rpx;
}

.top-bar__back,
.top-bar__action,
.top-bar__side {
  box-sizing: border-box;
  width: 112rpx;
}

.top-bar__back,
.top-bar__action {
  min-height: 80rpx;
  padding: 0;
  background: transparent;
  color: var(--text);
  line-height: 80rpx;
}

.top-bar__back {
  position: relative;
  margin: 0;
  overflow: visible;
  border: 0;
  border-radius: var(--radius-card-small);
  box-shadow: var(--shadow-ghost);
  font-family: var(--font-heading);
  text-align: left;
  transition: var(--transition-press);
}

.top-bar__back:active {
  background: var(--strong-overlay);
  transform: scale(0.97);
}

.top-bar__back-icon {
  position: absolute;
  display: block;
  width: 48rpx;
  height: 48rpx;
  top: 50%;
  left: 0;
  transform: translateY(-50%);
}

.top-bar__back.top-bar__back--positioned {
  position: absolute;
  left: var(--top-bar-back-inset);
  display: flex;
  width: 88rpx;
  min-width: 88rpx;
  max-width: 88rpx;
  height: 88rpx;
  min-height: 88rpx;
  align-items: center;
  justify-content: flex-start;
  line-height: 1;
  text-align: left;
}

.top-bar__back.top-bar__back--positioned .top-bar__back-icon {
  position: static;
  transform: none;
}

.top-bar__action {
  color: var(--strong);
  font-size: 24rpx;
  font-weight: 500;
  text-align: right;
}

.top-bar__action--more {
  width: 88rpx;
  min-width: 88rpx;
  min-height: 88rpx;
  height: 88rpx;
  margin-left: 48rpx;
  border: 0;
  border-radius: var(--radius-card-small);
  background: transparent;
  box-shadow: var(--shadow-ghost);
  color: var(--text);
  font-size: 18rpx;
  letter-spacing: 2rpx;
  line-height: 88rpx;
  text-align: center;
  transition: var(--transition-press);
}

.top-bar__action--more:active {
  background: var(--strong-overlay);
  transform: scale(0.97);
}

.top-bar__inner {
  position: relative;
}

.top-bar__back,
.top-bar__action,
.top-bar__side {
  min-width: 0;
  flex-shrink: 0;
}

.top-bar__title {
  white-space: nowrap;
}

.top-bar--with-more .top-bar__heading {
  position: absolute;
  left: 50%;
  width: 240rpx;
  transform: translateX(-50%);
}

.top-bar__action--more {
  margin-left: auto;
}
