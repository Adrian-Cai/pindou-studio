.top-bar {
  background: rgba(255, 255, 255, 0.96);
}

.top-bar--home {
  background: #ffffff;
}

.top-bar--home .top-bar__inner {
  box-sizing: border-box;
  height: 112rpx;
  padding: 0 40rpx;
}

.top-bar--home .top-bar__heading {
  align-items: flex-start;
}

.top-bar--home .top-bar__title {
  color: #15151a;
  font-size: 36rpx;
  font-weight: 600;
  line-height: 52rpx;
}

.top-bar__inner {
  display: flex;
  box-sizing: border-box;
  height: 112rpx;
  align-items: center;
  padding: 0 32rpx;
}

.top-bar__heading {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.top-bar__title {
  color: #111111;
  font-size: 34rpx;
  font-weight: 600;
  line-height: 48rpx;
}

.top-bar__subtitle {
  margin-top: 8rpx;
  color: #666666;
  font-size: 22rpx;
  line-height: 32rpx;
}

.top-bar__back,
.top-bar__action,
.top-bar__side {
  box-sizing: border-box;
  width: 112rpx;
}

.top-bar__back,
.top-bar__action {
  min-height: 80rpx;
  padding: 0;
  background: transparent;
  color: #111111;
  line-height: 80rpx;
}

.top-bar__back {
  font-family: Arial, sans-serif;
  font-size: 48rpx;
  font-weight: 300;
  text-align: left;
}

.top-bar__action {
  color: #6c4cf6;
  font-size: 24rpx;
  font-weight: 500;
  text-align: right;
}

.top-bar__action--more {
  width: 64rpx;
  min-height: 64rpx;
  height: 64rpx;
  margin-left: 48rpx;
  border: 1rpx solid #eeeeee;
  border-radius: 32rpx;
  color: #111111;
  font-size: 18rpx;
  letter-spacing: 2rpx;
  line-height: 62rpx;
  text-align: center;
}

.top-bar__inner {
  position: relative;
}

.top-bar__back,
.top-bar__action,
.top-bar__side {
  min-width: 0;
  flex-shrink: 0;
}

.top-bar__title {
  white-space: nowrap;
}

.top-bar--with-more .top-bar__heading {
  position: absolute;
  left: 50%;
  width: 240rpx;
  transform: translateX(-50%);
}

.top-bar__action--more {
  min-width: 64rpx;
  margin-left: auto;
}
