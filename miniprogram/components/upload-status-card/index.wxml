<view class="upload-status-card upload-status-card--{{securityStatus}} {{sourceImagePath ? 'upload-status-card--has-image' : 'upload-status-card--empty'}}">
  <view wx:if="{{sourceImagePath}}" class="upload-status-card__layout">
    <view
      class="upload-status-card__preview-wrap {{securityStatus === 'rejected' ? 'upload-status-card__preview-wrap--blocked' : ''}}"
      style="width:{{previewWidth}}rpx;height:{{previewHeight}}rpx;"
      bindtap="handleChooseImage"
    >
      <image
        class="upload-status-card__preview"
        src="{{sourceImagePath}}"
        mode="aspectFill"
        bindload="handlePreviewLoad"
        binderror="handlePreviewError"
      />
      <view wx:if="{{securityStatus === 'rejected'}}" class="upload-status-card__preview-mask">
        <view class="upload-status-card__blocked-icon" aria-hidden="true"></view>
        <text>图片已被屏蔽</text>
      </view>
      <view
        class="upload-status-card__remove"
        catchtap="handleClearImage"
        role="button"
        aria-label="移除图片"
      >×</view>
    </view>

    <view
      class="upload-status-card__status upload-status-card__status--{{securityStatus}} {{securityStatus === 'checking' && !securityLoadingVisible ? 'upload-status-card__status--pending' : ''}}"
      aria-live="polite"
    >
      <block wx:if="{{securityStatus === 'checking'}}">
        <view class="upload-status-card__status-icon upload-status-card__status-icon--spinner" aria-hidden="true"></view>
        <view class="upload-status-card__copy">
          <view class="upload-status-card__title">正在检测图片安全性</view>
          <view class="upload-status-card__description">{{securityLongWait ? '检测时间稍长，请稍候' : '检测完成后即可生成拼豆图'}}</view>
        </view>
      </block>

      <block wx:elif="{{securityStatus === 'passed'}}">
        <view class="upload-status-card__status-icon upload-status-card__status-icon--passed" aria-hidden="true">✓</view>
        <view class="upload-status-card__copy">
          <view class="upload-status-card__title">图片已准备好</view>
          <view class="upload-status-card__description">可以继续选择生成方式和尺寸</view>
          <button class="upload-status-card__secondary-action" bindtap="handleChooseImage" disabled="{{choosing}}">重新选择</button>
        </view>
      </block>

      <block wx:elif="{{securityStatus === 'rejected'}}">
        <view class="upload-status-card__status-icon upload-status-card__status-icon--rejected" aria-hidden="true">!</view>
        <view class="upload-status-card__copy">
          <view class="upload-status-card__title">这张图片暂时无法处理</view>
          <view class="upload-status-card__description">未通过内容安全检查，请更换其他图片后继续</view>
          <button class="upload-status-card__primary-action" bindtap="handleChooseImage" disabled="{{choosing}}">重新选择图片</button>
          <view class="upload-status-card__help" bindtap="handleSecurityHelp" role="button">为什么无法处理？<text aria-hidden="true">›</text></view>
        </view>
      </block>

      <block wx:elif="{{securityStatus === 'error'}}">
        <view class="upload-status-card__status-icon upload-status-card__status-icon--error" aria-hidden="true">!</view>
        <view class="upload-status-card__copy">
          <view class="upload-status-card__title">图片检测失败，请稍后重试</view>
          <view class="upload-status-card__description">可以重新选择一张图片</view>
          <button class="upload-status-card__primary-action" bindtap="handleChooseImage" disabled="{{choosing}}">重新选择图片</button>
        </view>
      </block>
    </view>
  </view>

  <button
    wx:else
    class="upload-status-card__empty"
    bindtap="handleChooseImage"
    disabled="{{choosing}}"
    aria-label="选择一张图片"
  >
    <image class="upload-status-card__empty-icon" src="/assets/icons/upload-cloud.svg" mode="aspectFit" />
    <view class="upload-status-card__empty-title">上传图片</view>
    <view class="upload-status-card__empty-hint">支持 JPG / PNG / WEBP 格式</view>
    <view class="upload-status-card__empty-description">建议图片清晰，效果更佳</view>
  </button>
</view>
