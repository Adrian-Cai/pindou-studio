<view class="upload-status-card upload-status-card--{{uploadStatus}} {{uploadStatus === 'empty' ? 'upload-status-card--empty' : 'upload-status-card--has-image'}}">
  <view wx:if="{{uploadStatus !== 'empty'}}" class="upload-status-card__layout">
    <view
      class="upload-status-card__preview-wrap {{uploadStatus === 'rejected' ? 'upload-status-card__preview-wrap--blocked' : ''}}"
    >
      <image
        wx:if="{{sourceImagePath}}"
        class="upload-status-card__preview"
        src="{{sourceImagePath}}"
        mode="aspectFill"
        binderror="handlePreviewError"
      />
      <view wx:else class="upload-status-card__preview-placeholder" aria-label="图片占位">
        <image src="/assets/icons/image-upload.svg" mode="aspectFit" />
      </view>
      <view wx:if="{{uploadStatus === 'rejected'}}" class="upload-status-card__preview-mask">
        <view class="upload-status-card__blocked-icon" aria-hidden="true"></view>
        <text>图片已被屏蔽</text>
      </view>
    </view>

    <view class="upload-status-card__state-content upload-status-card__state-content--{{uploadStatus}}" aria-live="polite">
      <block wx:if="{{uploadStatus === 'uploading'}}">
        <view class="upload-status-card__upload-heading">
          <view class="upload-status-card__title">正在上传图片</view>
          <view wx:if="{{uploadProgress >= 0}}" class="upload-status-card__progress-value">{{uploadProgress}}%</view>
        </view>
        <view class="upload-status-card__progress" aria-label="图片上传进度">
          <view wx:if="{{uploadProgress >= 0}}" class="upload-status-card__progress-bar" style="width: {{uploadProgress}}%;"></view>
          <view wx:else class="upload-status-card__progress-bar upload-status-card__progress-bar--indeterminate"></view>
        </view>
        <view class="upload-status-card__description">请稍候，不要关闭页面</view>
      </block>

      <block wx:elif="{{uploadStatus === 'checking'}}">
        <view class="upload-status-card__title-row">
          <view class="upload-status-card__status-icon upload-status-card__status-icon--spinner" aria-hidden="true"></view>
          <view class="upload-status-card__title">正在进行安全检测</view>
        </view>
        <view class="upload-status-card__description">正在检查图片内容是否符合规范</view>
      </block>

      <block wx:elif="{{uploadStatus === 'success'}}">
        <view class="upload-status-card__title-row">
          <view class="upload-status-card__status-icon upload-status-card__status-icon--success" aria-hidden="true"></view>
          <view class="upload-status-card__title">图片已通过检测</view>
        </view>
        <view class="upload-status-card__description">可以继续选择生成方式</view>
      </block>

      <block wx:elif="{{uploadStatus === 'rejected'}}">
        <view class="upload-status-card__title-row">
          <view class="upload-status-card__status-icon upload-status-card__status-icon--warning" aria-hidden="true"></view>
          <view class="upload-status-card__title">图片暂时无法处理</view>
        </view>
        <view class="upload-status-card__description">未通过内容安全检测，请更换图片</view>
      </block>

      <block wx:elif="{{uploadStatus === 'error'}}">
        <view class="upload-status-card__title-row">
          <view class="upload-status-card__status-icon upload-status-card__status-icon--warning" aria-hidden="true"></view>
          <view class="upload-status-card__title">处理失败</view>
        </view>
        <view class="upload-status-card__description">网络异常或服务繁忙，请稍后重试</view>
      </block>

      <button
        wx:if="{{uploadStatus === 'success' || uploadStatus === 'rejected' || uploadStatus === 'error'}}"
        class="upload-status-card__reselect-action"
        bindtap="handleChooseImage"
        disabled="{{choosing}}"
      >
        <image src="/assets/icons/image-reselect.svg" mode="aspectFit" />
        <text>重新选择图片</text>
      </button>
    </view>
  </view>

  <button
    wx:else
    class="upload-status-card__empty"
    bindtap="handleChooseImage"
    disabled="{{choosing}}"
    aria-label="选择一张图片"
  >
    <image class="upload-status-card__empty-icon" src="/assets/icons/upload-cloud.svg" mode="aspectFit" />
    <view class="upload-status-card__empty-title">上传图片</view>
    <view class="upload-status-card__empty-hint">支持 JPG / PNG / WEBP 格式</view>
    <view class="upload-status-card__empty-description">建议图片清晰，效果更佳</view>
  </button>
</view>
