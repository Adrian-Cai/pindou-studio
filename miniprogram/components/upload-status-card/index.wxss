.upload-status-card {
  box-sizing: border-box;
  width: 100%;
  margin-top: 24rpx;
  padding: 20rpx;
  border-radius: 28rpx;
  background: var(--color-surface);
  box-shadow: var(--shadow-card);
}

.upload-status-card--empty {
  padding: 0;
  background: transparent;
  box-shadow: none;
}

.upload-status-card__layout {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 16rpx;
}

.upload-status-card__preview-wrap {
  position: relative;
  box-sizing: border-box;
  width: 100%;
  height: calc(100vw - 120rpx);
  flex: 0 0 auto;
  overflow: hidden;
  border-radius: 20rpx;
  background: var(--color-primary-surface);
}

.upload-status-card__preview {
  display: block;
  width: 100%;
  height: 100%;
}

.upload-status-card__remove {
  position: absolute;
  z-index: 2;
  top: 0;
  right: 0;
  display: flex;
  width: 88rpx;
  height: 88rpx;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0;
  border: 0;
  background: transparent;
  color: #fff;
  line-height: normal;
  transition: var(--transition-press);
}

.upload-status-card__remove::after {
  border: 0;
}

.upload-status-card__remove:active {
  opacity: 0.84;
  transform: scale(0.97);
}

.upload-status-card__remove-symbol {
  display: flex;
  width: 56rpx;
  height: 56rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(21, 25, 32, 0.48);
  color: #fff;
  font-size: 42rpx;
  font-weight: 300;
  line-height: 1;
}

.upload-status-card__preview-placeholder {
  display: flex;
  width: 100%;
  height: 100%;
  align-items: center;
  justify-content: center;
  background: var(--color-surface-muted);
}

.upload-status-card__preview-placeholder-icon {
  width: 80rpx;
  height: 80rpx;
  opacity: 0.6;
}

.upload-status-card__preview-wrap--blocked .upload-status-card__preview {
  filter: blur(6rpx);
  opacity: 0.5;
  transform: scale(1.04);
}

.upload-status-card__preview-mask {
  position: absolute;
  z-index: 1;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  background: rgba(75, 65, 65, 0.25);
  color: rgba(255, 255, 255, 0.94);
  font-size: 22rpx;
  text-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.18);
}

.upload-status-card__blocked-icon {
  position: relative;
  box-sizing: border-box;
  width: 52rpx;
  height: 52rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.82);
  border-radius: 50%;
}

.upload-status-card__blocked-icon::after {
  position: absolute;
  top: 21rpx;
  left: 5rpx;
  width: 34rpx;
  height: 4rpx;
  border-radius: 2rpx;
  background: rgba(255, 255, 255, 0.82);
  content: '';
  transform: rotate(-45deg);
}

.upload-status-card__state-content {
  box-sizing: border-box;
  min-width: 0;
  width: 100%;
  flex: 0 0 auto;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
}

.upload-status-card__upload-heading,
.upload-status-card__title-row {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 12rpx;
}

.upload-status-card__upload-heading {
  justify-content: space-between;
}

.upload-status-card__progress-value {
  flex: 0 0 auto;
  color: var(--color-text-secondary);
  font-size: 27rpx;
  font-weight: 600;
  line-height: 40rpx;
}

.upload-status-card__status-icon {
  display: flex;
  position: relative;
  box-sizing: border-box;
  flex: 0 0 40rpx;
  width: 40rpx;
  height: 40rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
}

.upload-status-card__status-icon--spinner {
  box-sizing: border-box;
  border: 4rpx solid rgba(18, 180, 102, 0.2);
  border-top-color: var(--color-primary);
  animation: upload-status-spin 900ms linear infinite;
}

.upload-status-card__status-icon--success {
  background: var(--color-primary);
}

.upload-status-card__status-icon--success::after {
  box-sizing: border-box;
  width: 17rpx;
  height: 10rpx;
  border-bottom: 3rpx solid #fff;
  border-left: 3rpx solid #fff;
  content: '';
  transform: rotate(-45deg) translate(1rpx, -2rpx);
}

.upload-status-card__status-icon--warning {
  background: #e96b5e;
}

.upload-status-card__status-icon--warning::before {
  width: 4rpx;
  height: 16rpx;
  border-radius: 2rpx;
  background: #fff;
  content: '';
}

.upload-status-card__status-icon--warning::after {
  position: absolute;
  bottom: 8rpx;
  width: 4rpx;
  height: 4rpx;
  border-radius: 50%;
  background: #fff;
  content: '';
}

.upload-status-card__title {
  min-width: 0;
  color: var(--color-text);
  font-size: 29rpx;
  font-weight: 600;
  line-height: 42rpx;
}

.upload-status-card__description {
  margin-top: 4rpx;
  color: var(--color-text-secondary);
  font-size: 23rpx;
  line-height: 36rpx;
}

.upload-status-card__ticker {
  box-sizing: border-box;
  min-width: 0;
  height: 36rpx;
  flex: 1;
  overflow: hidden;
  color: var(--color-text-secondary);
  font-size: 20rpx;
  line-height: 36rpx;
}

.upload-status-card__status-band {
  box-sizing: border-box;
  display: flex;
  width: 100%;
  height: 68rpx;
  align-items: center;
  gap: 12rpx;
  padding: 0 16rpx;
  overflow: hidden;
  border-radius: 14rpx;
  background: var(--color-surface-muted);
}

.upload-status-card__status-band--success {
  background: var(--color-primary-soft);
  color: var(--color-primary);
}

.upload-status-card__ticker-track {
  animation: upload-status-ticker 8s ease-in-out infinite;
}

.upload-status-card__ticker-line {
  box-sizing: border-box;
  height: 36rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.upload-status-card__status-band .upload-status-card__status-icon {
  flex: 0 0 30rpx;
  width: 30rpx;
  height: 30rpx;
}

.upload-status-card__status-band .upload-status-card__status-icon--spinner {
  border-width: 3rpx;
}

.upload-status-card__status-band .upload-status-card__status-icon--success::after {
  width: 13rpx;
  height: 8rpx;
  border-width: 2rpx;
}

.upload-status-card__progress {
  box-sizing: border-box;
  width: 100%;
  height: 14rpx;
  margin-top: 12rpx;
  overflow: hidden;
  border: 0;
  border-radius: 7rpx;
  background: var(--color-surface-muted);
}

.upload-status-card__progress-bar {
  height: 100%;
  border-radius: inherit;
  background: var(--color-primary);
  transition: width 150ms ease;
}

.upload-status-card__progress-bar--indeterminate {
  width: 42%;
  animation: upload-status-progress 1s ease-in-out infinite;
}

.upload-status-card__empty {
  display: flex;
  box-sizing: border-box;
  width: calc(100vw - 80rpx);
  min-width: calc(100vw - 80rpx);
  min-height: 272rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 32rpx 24rpx;
  border: 2rpx dashed var(--color-primary);
  border-radius: 24rpx;
  background: var(--color-surface);
  color: inherit;
  line-height: normal;
  text-align: center;
}

.upload-status-card__empty::after {
  border: 0;
}

.upload-status-card__empty:active {
  background: var(--color-primary-soft);
}

.upload-status-card__empty--disabled {
  opacity: 0.72;
}

.upload-status-card__empty-icon {
  width: 80rpx;
  height: 80rpx;
}

.upload-status-card__empty-title {
  margin-top: 8rpx;
  color: var(--color-text);
  font-size: 32rpx;
  font-weight: 600;
  line-height: 48rpx;
}

.upload-status-card__empty-hint,
.upload-status-card__empty-description {
  color: var(--color-text-secondary);
  font-size: 24rpx;
  line-height: 36rpx;
}

.upload-status-card__empty-description {
  margin-top: 4rpx;
  color: var(--color-text-tertiary);
}

@keyframes upload-status-spin {
  to {
    transform: rotate(360deg);
  }
}

@keyframes upload-status-progress {
  from {
    transform: translateX(-110%);
  }

  to {
    transform: translateX(260%);
  }
}

@keyframes upload-status-ticker {
  0%,
  19% {
    transform: translateY(0);
  }

  24%,
  43% {
    transform: translateY(-36rpx);
  }

  48%,
  67% {
    transform: translateY(-72rpx);
  }

  72%,
  91% {
    transform: translateY(-108rpx);
  }

  96%,
  100% {
    transform: translateY(-144rpx);
  }
}

@media (max-width: 340px) {
  .upload-status-card__empty {
    width: calc(100vw - 64rpx);
    min-width: calc(100vw - 64rpx);
  }

  .upload-status-card__layout {
    gap: 12rpx;
  }

  .upload-status-card__title {
    font-size: 26rpx;
  }

  .upload-status-card__description {
    font-size: 21rpx;
  }

  .upload-status-card__ticker {
    font-size: 19rpx;
  }
}

@media (prefers-color-scheme: dark) {
  .upload-status-card__status-band--success {
    color: #58d895;
  }
}
