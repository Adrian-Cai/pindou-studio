.main-tab-bar {
  position: fixed;
  z-index: 100;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  box-sizing: content-box;
  height: 128rpx;
  padding-bottom: env(safe-area-inset-bottom);
  border-top: 1rpx solid var(--color-border, #e9eaf0);
  background: rgba(255, 255, 255, 0.98);
}

.main-tab-bar__item {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: var(--color-text-tertiary, #9699a8);
  font-size: 24rpx;
  font-weight: 400;
  line-height: 36rpx;
}

.main-tab-bar__item--active {
  color: var(--color-primary, #12b466);
  font-weight: 600;
}

.main-tab-bar__icon {
  width: 44rpx;
  height: 44rpx;
  margin-bottom: 8rpx;
}
