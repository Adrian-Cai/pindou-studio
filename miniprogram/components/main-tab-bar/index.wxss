.main-tab-bar {
  position: fixed;
  z-index: 1000;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  box-sizing: content-box;
  height: 128rpx;
  padding-bottom: env(safe-area-inset-bottom);
  border-top: 1rpx solid var(--color-border, #e9eaf0);
  /* 自定义 tabBar 位于页面组件树之外，不能依赖页面内一定能继承到 --surface。
     提供不透明兜底色，避免滚动内容透过 tabBar 与图标/文字重叠。 */
  background: var(--surface, #ffffff);
}

.main-tab-bar__item {
  display: flex;
  box-sizing: border-box;
  height: 100%;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: var(--color-text-secondary, #626573);
  font-size: 28rpx;
  font-weight: 500;
  line-height: 36rpx;
  letter-spacing: 0;
}

.main-tab-bar__item--active {
  color: var(--color-primary, #12b466);
  font-weight: 600;
}

.main-tab-bar__icon {
  display: block;
  flex: 0 0 auto;
  width: 44rpx;
  height: 44rpx;
  margin-bottom: 8rpx;
}

.main-tab-bar__label {
  display: block;
  flex: 0 0 auto;
  line-height: 36rpx;
  text-align: center;
  white-space: nowrap;
}

@media (prefers-color-scheme: dark) {
  .main-tab-bar {
    border-top-color: #35414d;
    background: #1a2028;
  }
}
