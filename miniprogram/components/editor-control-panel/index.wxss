:host {
  display: block;
  width: 100%;
  flex-shrink: 0;
}

/* ─── 缩放控制 ───────────────────────────────────────────────── */

.editor-panel__zoom {
  display: flex;
  flex-shrink: 0;
  height: 60rpx;
  align-items: center;
  justify-content: center;
  gap: 48rpx;
  margin-top: 24rpx;
}

.editor-panel__zoom-button {
  display: flex;
  box-sizing: border-box;
  width: 60rpx;
  min-width: 60rpx;
  max-width: 60rpx;
  height: 60rpx;
  flex: 0 0 60rpx;
  align-items: center;
  justify-content: center;
  padding: 0;
  border: 0;
  border-radius: var(--radius-card-small);
  background: transparent;
  box-shadow: var(--shadow-ghost);
  transition: var(--transition-press);
}

.editor-panel__zoom-icon {
  width: 32rpx;
  height: 32rpx;
}

.editor-panel__zoom-button[disabled] {
  opacity: 0.32;
}

.editor-panel__zoom-button:active {
  background: var(--strong-overlay);
  transform: scale(0.97);
}

.editor-panel__zoom-value {
  min-width: 88rpx;
  color: var(--color-text);
  font-size: 28rpx;
  font-weight: 400;
  line-height: 44rpx;
  text-align: center;
}

/* ─── 信息卡 ─────────────────────────────────────────────────── */

.editor-panel__info {
  display: flex;
  flex-shrink: 0;
  box-sizing: border-box;
  min-height: 84rpx;
  flex-direction: column;
  justify-content: center;
  margin-top: 24rpx;
  padding: 20rpx 28rpx;
  border: 0;
  border-radius: var(--radius-card-small);
  background: var(--color-surface-muted);
  color: var(--color-text);
  font-size: 28rpx;
  line-height: 44rpx;
  box-shadow: var(--shadow-card);
}

.editor-panel__info-row {
  display: flex;
  flex-wrap: nowrap;
  gap: 40rpx;
}

/* ─── 工具栏 ─────────────────────────────────────────────────── */

.editor-panel__tools {
  display: flex;
  flex-shrink: 0;
  height: 96rpx;
  margin: 32rpx 16rpx 0;
  gap: 8rpx;
}

.editor-panel__tool {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: var(--color-text);
  border-radius: 14rpx;
  border: 1.5rpx solid transparent;
  transition: background 0.15s ease, border-color 0.15s ease;
}

.editor-panel__tool--disabled {
  opacity: 0.34;
}

.editor-panel__tool-icon {
  width: 40rpx;
  height: 40rpx;
}

.editor-panel__tool-label {
  margin-top: 4rpx;
  font-size: 24rpx;
  font-weight: 500;
  line-height: 36rpx;
  color: var(--color-text-secondary);
}

.editor-panel__tool--active {
  background: var(--tool-active-bg, #f1ecff);
  border-color: var(--tool-active-border, #7c5cff);
}

.editor-panel__tool--active .editor-panel__tool-label {
  color: var(--tool-active-accent, #6f5bff);
  font-weight: 600;
}

/* ─── 调色板 ─────────────────────────────────────────────────── */

.editor-panel__palette {
  display: flex;
  flex-shrink: 0;
  flex-wrap: wrap;
  row-gap: 16rpx;
  margin: 24rpx 16rpx 0;
}

.editor-panel__palette-slot {
  display: flex;
  width: 12.5%;
  height: 44rpx;
  align-items: center;
  justify-content: center;
}

.editor-panel__palette-color {
  position: relative;
  display: flex;
  box-sizing: border-box;
  width: 44rpx;
  min-width: 44rpx;
  max-width: 44rpx;
  height: 44rpx;
  flex: 0 0 44rpx;
  align-items: center;
  justify-content: center;
  padding: 0;
  border: 1rpx solid rgba(17, 17, 17, 0.08);
  border-radius: 999rpx;
  overflow: hidden;
  line-height: 44rpx;
}

.editor-panel__palette-color--selected {
  border: 2rpx solid var(--color-primary);
  box-shadow: 0 0 0 2rpx #ffffff inset;
}

.editor-panel__palette-color--disabled {
  opacity: 0.55;
}

/* 生成中占位：颜色尚未产出时保持调色板高度稳定 */
.editor-panel__palette-color--placeholder {
  border-style: dashed;
  border-color: var(--color-border);
  background: var(--color-surface-muted);
}

.editor-panel__palette-check {
  width: 24rpx;
  height: 24rpx;
  filter: drop-shadow(0 1rpx 2rpx rgba(0, 0, 0, 0.28));
}

/* ─── 底部操作 ───────────────────────────────────────────────── */

.editor-panel__actions {
  display: flex;
  flex-shrink: 0;
  gap: 24rpx;
  margin: 32rpx 16rpx 0;
}

.editor-panel__action {
  box-sizing: border-box;
  height: 80rpx;
  min-width: 0;
  flex: 1;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 40rpx;
}

.editor-panel__actions .button-secondary {
  border: 0;
  background: transparent;
  color: var(--color-primary);
  box-shadow: var(--shadow-ghost);
}

.editor-panel__actions .button-primary {
  border: 0;
  background: var(--color-primary);
  color: #ffffff;
  box-shadow: var(--shadow-primary);
}

.editor-panel__actions .button-secondary:active {
  background: var(--color-primary-soft);
}

.editor-panel__actions .button-primary:active {
  background: var(--color-primary-pressed);
  transform: scale(0.97);
}

/* 未就绪时按钮必须明显不可点，优先级要高于上面的启用态配色 */
.editor-panel__actions .button-primary[disabled] {
  background: var(--color-disabled);
  color: #ffffff;
  box-shadow: none;
}

.editor-panel__actions .button-secondary[disabled] {
  background: transparent;
  color: var(--color-text-tertiary);
  box-shadow: var(--shadow-ghost);
}

.editor-panel__actions .button-primary[disabled]:active,
.editor-panel__actions .button-secondary[disabled]:active {
  transform: none;
}

@media (prefers-reduced-motion: reduce) {
  .editor-panel__zoom-button,
  .editor-panel__tool {
    transition: none;
  }
}
