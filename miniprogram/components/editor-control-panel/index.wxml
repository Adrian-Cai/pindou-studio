<view class="editor-panel">
  <!-- ── 缩放控制 ── -->
  <view class="editor-panel__zoom">
    <button
      class="editor-panel__zoom-button"
      bindtap="handleZoomOut"
      disabled="{{!ready || !canZoomOut}}"
      aria-label="缩小"
    ><image class="editor-panel__zoom-icon" src="/assets/icons/iconsax/minus.svg" mode="aspectFit" /></button>
    <text class="editor-panel__zoom-value">{{scalePercent}}%</text>
    <button
      class="editor-panel__zoom-button"
      bindtap="handleZoomIn"
      disabled="{{!ready || !canZoomIn}}"
      aria-label="放大"
    ><image class="editor-panel__zoom-icon" src="/assets/icons/iconsax/add.svg" mode="aspectFit" /></button>
  </view>

  <!-- ── 信息卡 ── -->
  <view class="editor-panel__info">
    <view class="editor-panel__info-row">
      <text>尺寸：{{width}}×{{height}}</text>
      <text>颜色：{{colorLimit}}色</text>
      <text>共 {{beadCount}} 颗</text>
    </view>
  </view>

  <!-- ── 工具栏 ── -->
  <view class="editor-panel__tools">
    <view
      wx:for="{{tools}}"
      wx:key="id"
      class="editor-panel__tool {{item.disabled ? 'editor-panel__tool--disabled' : ''}} {{activeTool === item.id ? 'editor-panel__tool--active' : ''}}"
      data-tool="{{item.id}}"
      bindtap="handleToolTap"
    >
      <image
        class="editor-panel__tool-icon"
        src="{{activeTool === item.id ? item.activeIcon : item.icon}}"
        mode="aspectFit"
      />
      <text class="editor-panel__tool-label">{{item.label}}</text>
    </view>
  </view>

  <!-- ── 调色板 ── -->
  <view class="editor-panel__palette">
    <block wx:if="{{paletteColors.length}}">
      <view wx:for="{{paletteColors}}" wx:key="*this" class="editor-panel__palette-slot">
        <button
          class="editor-panel__palette-color {{selectedColor === item ? 'editor-panel__palette-color--selected' : ''}} {{!ready ? 'editor-panel__palette-color--disabled' : ''}}"
          style="background-color: {{item}};"
          data-color="{{item}}"
          bindtap="handleColorTap"
          disabled="{{!ready}}"
          aria-label="选择颜色 {{item}}"
        >
          <image wx:if="{{selectedColor === item}}" class="editor-panel__palette-check" src="/assets/icons/iconsax/check.svg" mode="aspectFit" />
        </button>
      </view>
    </block>
    <block wx:else>
      <view wx:for="{{palettePlaceholders}}" wx:key="*this" class="editor-panel__palette-slot">
        <view class="editor-panel__palette-color editor-panel__palette-color--placeholder"></view>
      </view>
    </block>
  </view>

  <!-- ── 底部操作 ──
       生成中要保留占位但必须不可选：按钮位置不动，靠 disabled 呈现灰置态，
       等图案就绪后由编辑器页传 ready=true 自动恢复可点。 -->
  <view class="editor-panel__actions">
    <button
      class="button-secondary editor-panel__action"
      bindtap="handleRegenerate"
      disabled="{{!ready}}"
    >重新生成</button>
    <button
      class="button-primary editor-panel__action"
      bindtap="handleSave"
      loading="{{saving}}"
      disabled="{{saving || !ready}}"
    >{{saving ? '保存中' : '保存作品'}}</button>
  </view>
</view>
