<view class="page-layout">
  <top-bar
    title="{{title}}"
    subtitle="{{subtitle}}"
    back="{{back}}"
    actionText="{{actionText}}"
    actionType="{{actionType}}"
    home="{{home}}"
    navigationBarHeight="{{navigationBarHeight}}"
    bind:action="handleAction"
  />
  <scroll-view
    class="page-layout__scroll"
    scroll-y
    enhanced
    show-scrollbar="{{false}}"
    style="height: {{scrollAreaHeight}}px;"
  >
    <view class="page-layout__content {{showMainNav ? 'page-layout__content--with-nav' : ''}} {{compactBottomPadding ? 'page-layout__content--compact-bottom' : ''}}">
      <slot />
    </view>
  </scroll-view>
  <main-tab-bar wx:if="{{showMainNav}}" selected="{{selectedTab}}" />
</view>
