<view class="page-layout">
  <top-bar
    title="{{title}}"
    subtitle="{{subtitle}}"
    back="{{back}}"
    actionText="{{actionText}}"
    actionType="{{actionType}}"
    home="{{home}}"
    navigationBarHeight="{{navigationBarHeight}}"
    bind:action="handleAction"
  />
  <scroll-view
    class="page-layout__scroll"
    scroll-y
    enhanced
    scroll-into-view="{{scrollIntoView}}"
    show-scrollbar="{{false}}"
  >
    <view class="page-layout__content {{showMainNav ? (isMainTabPage ? 'page-layout__content--main-tab' : 'page-layout__content--with-nav') : ''}} {{compactBottomPadding ? 'page-layout__content--compact-bottom' : ''}} {{home || fillViewport ? 'page-layout__content--fill-viewport' : ''}}">
      <slot />
    </view>
  </scroll-view>
  <main-tab-bar wx:if="{{showEmbeddedMainNav}}" selected="{{selectedTab}}" />
</view>
