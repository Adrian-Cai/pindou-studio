.page-layout {
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: hidden;
  background: var(--color-bg, #f8f9fb);
}

.page-layout__scroll {
  width: 100%;
  min-height: 0;
  flex: 1;
}

.page-layout__content {
  box-sizing: border-box;
  min-height: 100%;
  padding-bottom: calc(var(--safe-bottom, 32rpx) + env(safe-area-inset-bottom));
}

.page-layout__content--with-nav {
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

.page-layout__content--main-tab {
  padding-bottom: calc(152rpx + env(safe-area-inset-bottom));
}

.page-layout__content--compact-bottom {
  padding-bottom: calc(128rpx + env(safe-area-inset-bottom));
}

.page-layout__content--fill-viewport {
  display: flex;
  flex-direction: column;
}
