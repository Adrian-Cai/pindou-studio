@import "../../styles/profile-pages.wxss";

.profile-edit-page {
  padding-top: 20rpx;
}

.profile-edit-card {
  padding: 44rpx 32rpx 36rpx;
  background: var(--color-surface);
  border-radius: var(--radius-card-large);
  box-shadow: var(--shadow-card);
}

.profile-edit-avatar-wrap {
  display: flex;
  width: 152rpx;
  height: 152rpx;
  align-items: center;
  justify-content: center;
  margin: 0 auto;
  border-radius: 32rpx;
  background: var(--color-primary-soft);
  overflow: hidden;
}

.profile-edit-avatar {
  width: 152rpx;
  height: 152rpx;
  border-radius: 32rpx;
}

.profile-edit-tip {
  display: block;
  margin-top: 18rpx;
  color: var(--color-text-secondary);
  font-size: 24rpx;
  line-height: 34rpx;
  text-align: center;
}

.profile-edit-field {
  margin-top: 40rpx;
}

.profile-edit-label {
  display: block;
  margin-bottom: 12rpx;
  color: var(--color-text-secondary);
  font-size: 26rpx;
}

.profile-edit-input {
  box-sizing: border-box;
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-control);
  background: var(--color-background);
  font-size: 28rpx;
  color: var(--color-text);
}

.profile-edit-message {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  background: var(--color-danger-soft);
  color: var(--color-danger);
  font-size: 24rpx;
  line-height: 34rpx;
}

.profile-edit-submit {
  display: flex;
  height: 92rpx;
  align-items: center;
  justify-content: center;
  margin-top: 36rpx;
  border: 0;
  border-radius: var(--radius-card-small);
  background: var(--color-primary);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 92rpx;
  box-shadow: var(--shadow-primary);
  transition: var(--transition-press);
}

.profile-edit-submit::after {
  border: 0;
}

.profile-edit-submit:active {
  transform: scale(0.98);
}

.profile-edit-submit[disabled] {
  background: var(--color-primary);
  color: #fff;
  opacity: 0.5;
}
