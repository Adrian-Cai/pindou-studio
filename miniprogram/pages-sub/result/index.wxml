<view class="result-page" bindtap="closeQuotaTips">
  <view class="result-header">
    <top-bar title="作品结果" back navigationBarHeight="{{navigationBarHeight}}" />
  </view>

  <scroll-view class="result-scroll" scroll-y enhanced show-scrollbar="{{false}}" style="height: {{scrollAreaHeight}}px; margin-top: {{topBarHeight}}px;">
    <view wx:if="{{draft && summary}}" class="result-content">
      <view class="work-summary">
        <!-- 画布仅用于离屏绘制，页面内展示导出后的 image，避免原生 canvas 滚动漂移 -->
        <canvas id="thumbnailCanvas" class="work-summary__thumb-canvas" type="2d"></canvas>
        <canvas id="previewRenderCanvas" class="preview-render-canvas" type="2d"></canvas>
        <canvas id="materialsDownloadCanvas" class="download-render-canvas" style="width: {{downloadCanvasWidth}}px; height: {{materialsCanvasHeight}}px;" type="2d"></canvas>
        <canvas id="paletteDownloadCanvas" class="download-render-canvas" style="width: {{downloadCanvasWidth}}px; height: {{paletteCanvasHeight}}px;" type="2d"></canvas>
        <image class="work-summary__thumb" src="{{thumbnailSrc}}" mode="aspectFit"></image>
        <view class="work-summary__info">
          <view class="work-summary__title-row {{renamingTitle ? 'work-summary__title-row--disabled' : ''}}" hover-class="work-summary__title-row--pressed" bindtap="editTitle" role="button" aria-label="编辑作品名称，当前名称 {{summary.title}}" aria-disabled="{{renamingTitle}}">
            <text class="work-summary__title">{{summary.title}}</text>
            <image class="work-summary__edit-icon" src="/assets/icons/work-edit.svg" mode="aspectFit" />
          </view>
          <view class="work-summary__meta">
            {{draft.settings.width}}×{{draft.settings.height}} · {{summary.colorCount}}色
          </view>
          <view class="work-summary__count">共 {{summary.beadCount}} 颗</view>
          <view class="work-summary__date">创建于 {{summary.createdText}}</view>
        </view>
        <view class="favorite {{isFavorite ? 'favorite--active' : ''}}" catchtap="toggleFavorite" aria-label="{{isFavorite ? '取消收藏' : '收藏作品'}}">
          <text class="favorite__heart">{{isFavorite ? '♥' : '♡'}}</text>
          <text>{{isFavorite ? '已收藏' : '收藏'}}</text>
        </view>
      </view>

      <view class="result-tabs" role="tablist">
        <view wx:for="{{tabs}}" wx:key="id" class="result-tabs__item {{activeTab === item.id ? 'result-tabs__item--active' : ''}}" data-tab="{{item.id}}" bindtap="changeTab" role="tab" aria-selected="{{activeTab === item.id}}">{{item.label}}</view>
      </view>

      <view wx:if="{{renderError}}" class="render-error">
        图像加载失败，请切换页签后重试。
      </view>

      <view wx:if="{{activeTab === 'preview'}}" class="result-panel">
        <view class="panel-heading">
          <view class="panel-heading__title">成品效果图</view>
          <view class="panel-heading__hint">高清展示拼豆成品效果，适合预览和分享</view>
        </view>
        <view class="preview-stage">
          <image class="preview-stage__image" src="{{previewSrc}}" mode="aspectFill"></image>
        </view>
        <view class="download-format">PNG 格式 · 高清图</view>
        <view class="download-action">
          <result-download-button text="下载成品图" fileType="preview" loading="{{downloadLoading && downloadingType === 'preview'}}" disabled="{{downloadLoading || !previewSrc}}" bind:download="handleRequestDownload" />
        </view>
      </view>

      <view wx:elif="{{activeTab === 'materials'}}" class="result-panel">
        <view class="panel-heading">
          <view class="panel-heading__title">材料清单</view>
          <view class="panel-heading__hint">按 {{draft.settings.brand}} 色号统计，备料时可直接核对</view>
        </view>
        <view class="material-summary">
          <view>
            <text class="material-summary__value">{{summary.beadCount}}</text>
            <text class="material-summary__unit">颗</text>
            <view class="material-summary__label">拼豆总量</view>
          </view>
          <view>
            <text class="material-summary__value">{{summary.colorCount}}</text>
            <text class="material-summary__unit">色</text>
            <view class="material-summary__label">实际用色</view>
          </view>
        </view>
        <view wx:if="{{materials.length}}" class="material-list">
          <view class="material-list__header">
            <view>颜色</view>
            <view class="material-list__header-number">数量</view>
            <view class="material-list__header-number">占比</view>
          </view>
          <view class="material-row" wx:for="{{visibleMaterials}}" wx:key="colorCode">
            <view class="material-row__color">
              <view class="material-row__swatch" style="background-color: {{item.color}};"></view>
              <view class="material-row__detail">
                <view class="material-row__code">{{item.colorCode}}</view>
                <view class="material-row__hex">{{item.color}}</view>
              </view>
            </view>
            <view class="material-row__count">{{item.count}}</view>
            <view class="material-row__percentage">{{item.percentage}}</view>
          </view>
        </view>
        <view wx:else class="panel-empty">这幅作品没有可统计的颜色。</view>
        <button wx:if="{{materials.length > 5}}" class="material-list__toggle" bindtap="toggleMaterialList" aria-expanded="{{materialListExpanded}}" aria-label="{{materialListExpanded ? '收起颜色列表' : '展开全部颜色'}}">
          <text wx:if="{{materialListExpanded}}">收起颜色列表</text>
          <text wx:else>展开全部 {{materials.length}} 种颜色</text>
          <text class="material-list__toggle-icon">{{materialListExpanded ? '↑' : '↓'}}</text>
        </button>
        <view wx:if="{{materials.length}}" class="download-action">
          <result-download-button text="下载材料清单" fileType="materials" loading="{{downloadLoading && downloadingType === 'materials'}}" disabled="{{downloadLoading}}" bind:download="handleRequestDownload" />
        </view>
      </view>

      <view wx:elif="{{activeTab === 'chart'}}" class="result-panel">
        <view class="panel-heading">
          <view class="panel-heading__title">编号施工图</view>
          <view class="panel-heading__hint">双向滑动查看完整图纸，格内编号对应材料色号</view>
        </view>
        <canvas id="chartRenderCanvas" class="chart-render-canvas" style="width: {{chartWidthRpx}}rpx; height: {{chartHeightRpx}}rpx;" type="2d"></canvas>
        <canvas id="chartHdRenderCanvas" class="chart-hd-render-canvas" type="2d"></canvas>
        <view wx:if="{{chartSrc}}" class="chart-stage chart-stage--clickable" bindtap="openChartPreview" aria-label="点击查看大图" role="button">
          <image class="chart-stage__image" src="{{chartSrc}}" mode="widthFix" aria-label="编号施工图，格内编号对应材料色号"></image>
          <view class="chart-zoom-icon" aria-hidden="true">
            <image class="chart-zoom-icon__img" src="/assets/icons/zoom-in.svg" mode="aspectFit" />
          </view>
        </view>
        <view wx:else class="chart-loading">施工图生成中...</view>
        <view wx:if="{{chartSrc}}" class="chart-tap-hint">点击图片查看大图</view>
        <view class="download-action">
          <result-download-button text="下载施工图" fileType="chart" loading="{{downloadLoading && downloadingType === 'chart'}}" disabled="{{downloadLoading || !chartSrc}}" bind:download="handleRequestDownload" />
        </view>
      </view>

      <view wx:else class="result-panel">
        <view class="panel-heading">
          <view class="panel-heading__title">色板参考</view>
          <view class="panel-heading__hint">本作品所用颜色及数量参考</view>
        </view>
        <block wx:if="{{materials.length}}">
          <block wx:if="{{!paletteExpanded}}">
            <view class="palette-preview">
              <view class="palette-preview__item" wx:for="{{palettePreviewMaterials}}" wx:key="colorCode" aria-label="{{item.colorCode}}，{{item.count}}颗，占比 {{item.percentage}}，颜色值 {{item.color}}">
                <view class="palette-preview__color" style="background-color: {{item.color}};"></view>
                <view class="palette-preview__code">{{item.colorCode}}</view>
                <view class="palette-preview__count">
                  <text>{{item.count}}</text>
                  <text class="palette-preview__percentage-inline">（{{item.percentage}}）</text>
                </view>
                <view class="palette-preview__percentage-stacked">{{item.percentage}}</view>
              </view>
              <view class="palette-preview__item palette-preview__more" hover-class="palette-preview__more--pressed" bindtap="togglePalette" role="button" aria-label="展开全部色板参考" aria-expanded="false">
                <view class="palette-preview__color palette-preview__color--more">
                  <image class="palette-preview__more-icon" src="/assets/icons/palette-grid.svg" mode="aspectFit" />
                </view>
                <view class="palette-preview__more-label">全部</view>
              </view>
            </view>
          </block>
          <block wx:else>
            <view class="palette-grid">
              <view class="palette-card" wx:for="{{materials}}" wx:key="colorCode" aria-label="{{item.colorCode}}，{{item.count}}颗，占比 {{item.percentage}}，颜色值 {{item.color}}">
                <view class="palette-card__color" style="background-color: {{item.color}};"></view>
                <view class="palette-card__code">{{item.colorCode}}</view>
                <view class="palette-card__count">{{item.count}}颗</view>
              </view>
            </view>
            <view class="palette-toggle palette-toggle--collapse" hover-class="palette-toggle--pressed" bindtap="togglePalette" role="button" aria-label="收起色板" aria-expanded="true">
              <text>收起色板</text>
              <text class="palette-toggle__arrow-up">↑</text>
            </view>
          </block>
        </block>
        <view wx:else class="panel-empty">当前没有可参考的颜色。</view>
        <view wx:if="{{materials.length}}" class="download-format">PNG 格式 · 高清图</view>
        <view wx:if="{{materials.length}}" class="download-action">
          <result-download-button text="下载色板参考" fileType="palette" loading="{{downloadLoading && downloadingType === 'palette'}}" disabled="{{downloadLoading}}" bind:download="handleRequestDownload" />
        </view>
      </view>

      <download-quota-bar quota="{{quota}}" tipsOpen="{{quotaTipsOpen}}" bind:toggletips="toggleQuotaTips" bind:closetips="closeQuotaTips" bind:openmembership="openMembership" />
    </view>

    <view wx:else class="result-empty">
      <view class="result-empty__mark">◇</view>
      <view class="result-empty__title">当前没有可查看的作品</view>
      <view class="result-empty__hint">先上传图片并保存作品，这里会生成完整的制作资料。</view>
      <button class="start-btn" bindtap="goCreate">开始制作</button>
    </view>

    <view class="result-scroll__spacer"></view>
  </scroll-view>

  <view wx:if="{{draft}}" class="result-nav">
    <view class="result-nav__item" data-path="/pages/home/index" bindtap="switchMainTab">
      <image class="result-nav__icon" src="/assets/icons/home.svg" mode="aspectFit" />
      <text>首页</text>
    </view>
    <view class="result-nav__item result-nav__item--active" data-path="/pages/projects/index" bindtap="switchMainTab">
      <image class="result-nav__icon" src="/assets/icons/projects-active.svg" mode="aspectFit" />
      <text>作品</text>
    </view>
    <view class="result-nav__item" data-path="/pages/profile/index" bindtap="switchMainTab">
      <image class="result-nav__icon" src="/assets/icons/profile.svg" mode="aspectFit" />
      <text>我的</text>
    </view>
  </view>

  <!-- 统一下载半屏交互组件 (4 个 Tab 共用) -->
  <download-bottom-sheet visible="{{downloadSheetVisible}}" state="{{downloadSheetState}}" config="{{currentDownloadConfig}}" quota="{{downloadSheetQuota}}" costText="1 次下载次数" bind:confirm="handleConfirmDownload" bind:cancel="handleCancelDownload" bind:close="handleCloseDownloadSheet" bind:preview="handlePreviewDownloadedFile" bind:complete="handleCompleteDownloadSheet" />
</view>