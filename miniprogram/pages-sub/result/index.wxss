.result-page {
  /* ── 结果页专属紫色主题，隔离于此选择器内，不影响全局绿色 ── */
  --color-primary: #6F5BFF;
  --color-primary-pressed: #5B48E0;
  --color-primary-soft: #f0eeff;
  --color-surface: #ffffff;
  --color-surface-muted: #fafafa;
  --color-text: #111111;
  --color-text-secondary: #666666;
  --color-text-tertiary: #888888;
  --color-border: #eeeeee;
  --color-brand: #6F5BFF;
  /* 下载按钮紫色渐变，供 result-download-button 组件继承 */
  --download-btn-bg: linear-gradient(90deg, #6A55F6, #8A63FF);
  --download-btn-bg-pressed: #5B48E0;
  height: 100vh;
  overflow: hidden;
  background: var(--background);
  color: var(--color-text);
}

@media (prefers-color-scheme: dark) {
  .result-page {
    --color-primary: #a99bff;
    --color-primary-pressed: #8d7dff;
    --color-primary-soft: #2d2554;
    --color-primary-surface: #30275a;
    --background: #101419;
    --surface: #1a1d26;
    --color-surface: #1a1d26;
    --color-surface-muted: #252a35;
    --color-text: #f5f3ff;
    --color-text-secondary: #c0c3d0;
    --color-text-tertiary: #9aa3b3;
    --color-border: #3a404d;
    --color-danger-soft: #3a2025;
    --color-danger: #ff8589;
    --color-brand: #a99bff;
    --download-btn-bg: linear-gradient(90deg, #7868ff, #9a87ff);
    --download-btn-bg-pressed: #8d7dff;
    --shadow-card: 0 8rpx 24rpx rgba(0, 0, 0, 0.14), 0 2rpx 4rpx rgba(0, 0, 0, 0.24);
    --shadow-ghost: inset 0 6rpx 12rpx rgba(255, 255, 255, 0.04), var(--shadow-card);
    --shadow-primary: 0 14rpx 32rpx rgba(169, 155, 255, 0.12);
    --shadow-sheet: 0 -8rpx 32rpx rgba(0, 0, 0, 0.24);
    --strong-overlay: rgba(169, 155, 255, 0.05);
  }
}

.result-header {
  position: fixed;
  z-index: 30;
  top: 0;
  right: 0;
  left: 0;
}

.result-scroll {
  width: 100%;
}

.result-scroll__spacer {
  height: calc(132rpx + env(safe-area-inset-bottom));
}

.result-content {
  padding: 16rpx 32rpx 48rpx;
}

.work-summary,
.result-panel {
  border: 0;
  border-radius: var(--radius-card-large);
  background: var(--color-surface);
  box-shadow: var(--shadow-card);
}

.work-summary {
  position: relative;
  display: flex;
  align-items: center;
  gap: var(--space-3);
  padding: var(--card-padding-compact);
}

.work-summary__thumb-canvas,
.preview-render-canvas,
.download-render-canvas,
.chart-render-canvas,
.chart-hd-render-canvas {
  position: absolute;
  top: 0;
  left: -9999px;
  pointer-events: none;
}

.work-summary__thumb-canvas {
  width: 176rpx;
  height: 176rpx;
}

.preview-render-canvas {
  width: calc(100vw - 120rpx);
  height: calc(100vw - 120rpx);
}

.work-summary__thumb {
  box-sizing: border-box;
  width: 176rpx;
  height: 176rpx;
  border: 1rpx solid var(--color-border);
  border-radius: 20rpx;
  background: var(--color-surface-muted);
  flex: 0 0 176rpx;
}

.work-summary__info {
  display: flex;
  min-width: 0;
  flex: 1;
  align-items: flex-start;
  flex-direction: column;
}

.work-summary__title-row {
  position: relative;
  display: flex;
  width: calc(100% - 120rpx);
  min-width: 0;
  align-items: center;
  justify-content: flex-start;
  gap: var(--space-1);
  color: var(--color-text);
  font-size: 32rpx;
  font-weight: 600;
  line-height: 44rpx;
}

.work-summary__title-row::before {
  position: absolute;
  top: -16rpx;
  right: -8rpx;
  bottom: -16rpx;
  left: -8rpx;
  content: "";
}

.work-summary__title-row--pressed,
.work-summary__title-row--disabled {
  opacity: 0.58;
}

.work-summary__title {
  min-width: 0;
  overflow: hidden;
  flex: 0 1 auto;
  text-align: left;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.work-summary__edit-icon {
  width: 28rpx;
  height: 28rpx;
  flex: 0 0 28rpx;
}

.work-summary__meta,
.work-summary__count {
  width: 100%;
  margin-top: 8rpx;
  color: var(--color-text);
  font-size: 28rpx;
  font-weight: 400;
  line-height: 44rpx;
}

.work-summary__meta {
  margin-top: 12rpx;
}

.work-summary__count {
  font-weight: 500;
}

.work-summary__date {
  width: 100%;
  overflow: hidden;
  margin-top: var(--space-1);
  color: var(--color-text-tertiary);
  font-size: 24rpx;
  font-weight: 400;
  line-height: 36rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.favorite {
  position: absolute;
  box-sizing: border-box;
  min-width: 0;
  top: var(--card-padding-compact);
  right: var(--card-padding-compact);
  display: flex;
  width: 112rpx;
  height: 88rpx;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 0;
  border: 0;
  border-radius: var(--radius-card-small);
  background: transparent;
  box-shadow: var(--shadow-ghost);
  color: var(--color-text-secondary);
  font-size: 22rpx;
  font-weight: 500;
  line-height: 1;
  transition: var(--transition-press);
}

.favorite--active {
  background: var(--color-primary-soft);
  box-shadow: 0 0 0 2rpx var(--color-primary), var(--shadow-ghost);
  color: var(--color-primary);
}

.favorite:active {
  background: var(--strong-overlay);
  transform: scale(0.97);
}

.favorite__heart {
  font-size: 28rpx;
}

.result-tabs {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  margin-top: 16rpx;
  border-bottom: 1rpx solid var(--color-border);
}

.result-tabs__item {
  position: relative;
  box-sizing: border-box;
  min-width: 0;
  height: 96rpx;
  padding: 0;
  background: transparent;
  color: var(--color-text-secondary);
  font-size: 30rpx;
  font-weight: 500;
  line-height: 96rpx;
  text-align: center;
}

.result-tabs__item--active {
  color: var(--color-primary);
  font-weight: 600;
}

.result-tabs__item--active::after {
  position: absolute;
  right: 24rpx;
  bottom: -1rpx;
  left: 24rpx;
  height: 6rpx;
  border-radius: 6rpx;
  background: var(--color-primary);
  content: "";
}

.render-error {
  margin-top: 24rpx;
  padding: 20rpx 24rpx;
  border: 1rpx solid var(--color-danger);
  border-radius: 16rpx;
  background: var(--color-danger-soft);
  color: var(--color-danger);
  font-size: 23rpx;
  line-height: 34rpx;
}

.result-panel {
  margin-top: 24rpx;
  padding: 28rpx;
}

.panel-heading {
  margin-bottom: 24rpx;
}

.panel-heading__title {
  color: var(--color-text);
  font-size: 32rpx;
  font-weight: 600;
  line-height: 48rpx;
}

.panel-heading__hint {
  margin-top: 8rpx;
  color: var(--color-text-secondary);
  font-size: 24rpx;
  font-weight: 400;
  line-height: 36rpx;
}

.preview-stage {
  box-sizing: border-box;
  width: 100%;
  overflow: hidden;
  border-radius: 16rpx;
  aspect-ratio: 1;
  background: var(--color-primary-soft);
}

.preview-stage__image {
  display: block;
  width: 100%;
  height: 100%;
}

.download-format {
  margin-top: var(--space-2);
  margin-bottom: 20rpx;
  color: var(--color-text-secondary);
  font-size: 22rpx;
  line-height: 32rpx;
}

.download-action,
.download-action result-download-button {
  display: flex;
  box-sizing: border-box;
  width: 100%;
  min-width: 0;
}

/* 空状态「开始制作」按钮 */
.start-btn {
  display: flex;
  box-sizing: border-box;
  width: 100%;
  height: 80rpx;
  align-items: center;
  justify-content: center;
  margin-top: 32rpx;
  padding: 0 24rpx;
  border: 0;
  border-radius: 12rpx;
  background: var(--color-primary);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 80rpx;
}
.start-btn::after {
  border: 0;
}
.start-btn:active {
  background: var(--color-primary-pressed);
  transform: scale(0.98);
}

.material-summary {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.material-summary > view {
  padding: 24rpx;
  border-radius: 16rpx;
  background: var(--color-surface-muted);
}

.material-summary__value {
  font-size: 38rpx;
  font-weight: 600;
}

.material-summary__unit {
  margin-left: 6rpx;
  color: var(--color-text-secondary);
  font-size: 22rpx;
}

.material-summary__label {
  margin-top: 6rpx;
  color: var(--color-text-secondary);
  font-size: 22rpx;
}

.material-list {
  border-top: 1rpx solid var(--color-border);
}

.material-list__header,
.material-row {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 104rpx 96rpx;
  column-gap: 16rpx;
  align-items: center;
  border-bottom: 1rpx solid var(--color-border);
}

.material-list__header {
  min-height: 56rpx;
  color: var(--color-text-tertiary);
  font-size: 22rpx;
}

.material-list__header-number {
  text-align: right;
}

.material-row {
  min-height: 88rpx;
}

.material-row__color {
  display: flex;
  min-width: 0;
  align-items: center;
}

.material-row__swatch {
  box-sizing: border-box;
  flex: 0 0 auto;
  width: 24rpx;
  height: 24rpx;
  border: 1rpx solid rgba(17, 17, 17, 0.1);
  border-radius: 50%;
}

.material-row__detail {
  min-width: 0;
  flex: 1;
  margin-left: 20rpx;
}

.material-row__code {
  font-size: 25rpx;
  font-weight: 600;
}

.material-row__hex {
  margin-top: 2rpx;
  color: var(--color-text-tertiary);
  font-size: 19rpx;
  text-transform: uppercase;
}

.material-row__count {
  color: var(--color-text-secondary);
  font-size: 23rpx;
  font-variant-numeric: tabular-nums;
  text-align: right;
}

.material-row__percentage {
  color: var(--color-text);
  font-size: 23rpx;
  font-variant-numeric: tabular-nums;
  font-weight: 500;
  text-align: right;
}

.material-list__toggle {
  box-sizing: border-box;
  display: flex;
  width: 100%;
  height: 96rpx;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  margin: 8rpx 0 0;
  padding: 0 24rpx;
  border-radius: 12rpx;
  background: transparent;
  color: var(--color-primary);
  font-size: 24rpx;
  font-weight: 500;
  line-height: 96rpx;
}

.material-list__toggle::after {
  border: 0;
}

.material-list__toggle:active {
  background: var(--color-primary-soft);
}

.material-list__toggle-icon {
  font-size: 26rpx;
}

.chart-stage {
  box-sizing: border-box;
  width: 100%;
  padding: 1rpx;
  border: 1rpx solid var(--color-border);
  border-radius: 16rpx;
  background: var(--color-surface-muted);
}

.chart-stage__image {
  display: block;
  width: 100%;
  height: auto;
  background: #ffffff;
}

.chart-loading {
  padding: 32rpx 0;
  color: var(--color-text-secondary);
  font-size: 24rpx;
  line-height: 36rpx;
  text-align: center;
}

/* 施工图可点击态 */
.chart-stage--clickable {
  position: relative;
  cursor: pointer;
}

.chart-stage--clickable:active {
  opacity: 0.88;
}

/* 右下角放大图标 */
.chart-zoom-icon {
  position: absolute;
  right: 16rpx;
  bottom: 16rpx;
  display: flex;
  width: 56rpx;
  height: 56rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--color-surface);
  box-shadow: var(--shadow-card);
}

.chart-zoom-icon__img {
  display: block;
  width: 32rpx;
  height: 32rpx;
  color: var(--color-text-secondary);
}

/* 图片下方弱提示文字 */
.chart-tap-hint {
  margin-top: 14rpx;
  color: var(--color-text-tertiary);
  font-size: 22rpx;
  line-height: 32rpx;
  text-align: center;
}

.palette-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  column-gap: 24rpx;
  row-gap: 40rpx;
}

.palette-preview {
  display: grid;
  grid-template-columns: repeat(6, minmax(0, 1fr));
  align-items: start;
  column-gap: 12rpx;
}

.palette-preview__item {
  min-width: 0;
  text-align: center;
}

.palette-preview__color {
  box-sizing: border-box;
  width: 100%;
  border: 1rpx solid rgba(17, 17, 17, 0.08);
  border-radius: 12rpx;
  aspect-ratio: 1;
}

.palette-preview__code,
.palette-preview__more-label {
  margin-top: 12rpx;
  color: var(--color-text);
  font-size: 21rpx;
  font-weight: 600;
  line-height: 30rpx;
  white-space: nowrap;
}

.palette-preview__count {
  margin-top: 2rpx;
  color: var(--color-text-tertiary);
  font-size: 16rpx;
  font-variant-numeric: tabular-nums;
  letter-spacing: -0.6rpx;
  line-height: 26rpx;
  white-space: nowrap;
}

.palette-preview__percentage-stacked {
  display: none;
}

.palette-preview__more {
  grid-column: 6;
  border-radius: 12rpx;
}

.palette-preview__more--pressed {
  opacity: 0.62;
}

.palette-preview__color--more {
  display: flex;
  align-items: center;
  justify-content: center;
  border-color: transparent;
  background: var(--color-surface-muted);
}

.palette-preview__more-icon {
  display: block;
  width: 40rpx;
  height: 40rpx;
}

.palette-preview__more-label {
  color: var(--color-text-secondary);
}

.palette-toggle {
  display: flex;
  min-height: 72rpx;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  border-radius: 12rpx;
  color: var(--color-primary);
  font-size: 24rpx;
  font-weight: 500;
  line-height: 36rpx;
}

.palette-toggle--collapse {
  margin: 20rpx -8rpx -12rpx;
}

.palette-toggle--pressed {
  background: var(--color-primary-soft);
}

.palette-toggle__arrow-up {
  font-size: 26rpx;
  line-height: 36rpx;
}

.palette-card {
  min-width: 0;
  text-align: center;
}

.palette-card__color {
  box-sizing: border-box;
  width: 100%;
  border: 1rpx solid rgba(17, 17, 17, 0.08);
  border-radius: 16rpx;
  aspect-ratio: 1;
}

.palette-card__code {
  overflow: hidden;
  margin-top: 16rpx;
  color: var(--color-text);
  font-size: 24rpx;
  font-weight: 600;
  line-height: 36rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.palette-card__count {
  overflow: hidden;
  margin-top: 2rpx;
  color: var(--color-text-tertiary);
  font-size: 21rpx;
  font-variant-numeric: tabular-nums;
  line-height: 32rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.panel-empty {
  padding: 64rpx 24rpx;
  color: var(--color-text-tertiary);
  font-size: 24rpx;
  text-align: center;
}

.result-empty {
  margin: 120rpx 32rpx 0;
  padding: 64rpx 40rpx;
  border: 0;
  border-radius: var(--radius-card-large);
  background: var(--color-surface);
  box-shadow: var(--shadow-card);
  text-align: center;
}

.result-empty__mark {
  color: var(--color-primary);
  font-size: 72rpx;
}

.result-empty__title {
  margin-top: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.result-empty__hint {
  margin-top: 12rpx;
  color: var(--color-text-secondary);
  font-size: 23rpx;
  line-height: 36rpx;
}

.result-nav {
  position: fixed;
  z-index: 20;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  box-sizing: content-box;
  height: 104rpx;
  padding-bottom: env(safe-area-inset-bottom);
  border-top: 1rpx solid var(--color-border);
  background: var(--color-surface);
}

.result-nav__item {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: var(--color-text-tertiary);
  font-size: 20rpx;
  line-height: 28rpx;
}

.result-nav__item--active {
  color: var(--color-primary);
  font-weight: 500;
}

.result-nav__icon {
  width: 40rpx;
  height: 40rpx;
  margin-bottom: 2rpx;
}

@media (max-width: 340px) {
  .result-content {
    padding-right: 24rpx;
    padding-left: 24rpx;
  }
  .work-summary {
    gap: var(--space-2);
  }
  .favorite {
    width: 100rpx;
  }
  .work-summary__title-row {
    width: calc(100% - 108rpx);
  }
  .result-tabs__item {
    font-size: 24rpx;
  }
  .result-panel {
    padding-right: 24rpx;
    padding-left: 24rpx;
  }
  .palette-preview {
    column-gap: 8rpx;
  }
  .palette-preview__code,
  .palette-preview__more-label {
    font-size: 19rpx;
  }
  .palette-preview__count {
    font-size: 16rpx;
  }
  .palette-preview__percentage-inline {
    display: none;
  }
  .palette-preview__percentage-stacked {
    display: block;
    color: var(--color-text-tertiary);
    font-size: 16rpx;
    font-variant-numeric: tabular-nums;
    line-height: 24rpx;
    white-space: nowrap;
  }
}
