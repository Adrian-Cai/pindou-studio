.result-panel {
  margin-top: 24rpx;
  padding: 28rpx;
  border: 0;
  border-radius: var(--radius-card-large);
  background: var(--color-surface);
  box-shadow: var(--shadow-card);
}

.panel-heading {
  margin-bottom: 24rpx;
}

.panel-heading__title {
  color: var(--color-text);
  font-size: 32rpx;
  font-weight: 600;
  line-height: 48rpx;
}

.panel-heading__hint {
  margin-top: 8rpx;
  color: var(--color-text-secondary);
  font-size: 24rpx;
  font-weight: 400;
  line-height: 36rpx;
}

.material-summary {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.material-summary > view {
  padding: 24rpx;
  border-radius: 16rpx;
  background: var(--color-surface-muted);
}

.material-summary__value {
  font-size: 38rpx;
  font-weight: 600;
}

.material-summary__unit {
  margin-left: 6rpx;
  color: var(--color-text-secondary);
  font-size: 22rpx;
}

.material-summary__label {
  margin-top: 6rpx;
  color: var(--color-text-secondary);
  font-size: 22rpx;
}

.material-list {
  border-top: 1rpx solid var(--color-border);
}

.material-list__header,
.material-row {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 104rpx 96rpx;
  column-gap: 16rpx;
  align-items: center;
  border-bottom: 1rpx solid var(--color-border);
}

.material-list__header {
  min-height: 56rpx;
  color: var(--color-text-tertiary);
  font-size: 22rpx;
}

.material-list__header-number {
  text-align: right;
}

.material-row {
  min-height: 88rpx;
}

.material-row__color {
  display: flex;
  min-width: 0;
  align-items: center;
}

.material-row__swatch {
  box-sizing: border-box;
  flex: 0 0 auto;
  width: 24rpx;
  height: 24rpx;
  border: 1rpx solid rgba(17, 17, 17, 0.1);
  border-radius: 50%;
}

.material-row__detail {
  min-width: 0;
  flex: 1;
  margin-left: 20rpx;
}

.material-row__code {
  font-size: 25rpx;
  font-weight: 600;
}

.material-row__hex {
  margin-top: 2rpx;
  color: var(--color-text-tertiary);
  font-size: 19rpx;
  text-transform: uppercase;
}

.material-row__count {
  color: var(--color-text-secondary);
  font-size: 23rpx;
  font-variant-numeric: tabular-nums;
  text-align: right;
}

.material-row__percentage {
  color: var(--color-text);
  font-size: 23rpx;
  font-variant-numeric: tabular-nums;
  font-weight: 500;
  text-align: right;
}

.material-list__toggle {
  box-sizing: border-box;
  display: flex;
  width: 100%;
  height: 96rpx;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  margin: 8rpx 0 0;
  padding: 0 24rpx;
  border-radius: 12rpx;
  background: transparent;
  color: var(--color-primary);
  font-size: 24rpx;
  font-weight: 500;
  line-height: 96rpx;
}

.material-list__toggle::after {
  border: 0;
}

.material-list__toggle:active {
  background: var(--color-primary-soft);
}

.material-list__toggle-icon {
  font-size: 26rpx;
}

.panel-empty {
  padding: 64rpx 24rpx;
  color: var(--color-text-tertiary);
  font-size: 24rpx;
  text-align: center;
}

.download-action,
.download-action result-download-button {
  display: flex;
  box-sizing: border-box;
  width: 100%;
  min-width: 0;
}

@media (max-width: 340px) {
  .result-panel {
    padding-right: 24rpx;
    padding-left: 24rpx;
  }
}
