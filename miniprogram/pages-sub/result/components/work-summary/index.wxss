.work-summary {
  position: relative;
  display: flex;
  align-items: flex-start;
  gap: var(--space-3);
  padding: var(--card-padding-compact);
  border: 0;
  border-radius: var(--radius-card-large);
  background: var(--color-surface);
  box-shadow: var(--shadow-card);
}

.work-summary__thumb {
  box-sizing: border-box;
  width: 176rpx;
  height: 176rpx;
  border: 1rpx solid var(--color-border);
  border-radius: 20rpx;
  background: var(--color-surface-muted);
  flex: 0 0 176rpx;
}

.work-summary__info {
  display: flex;
  min-width: 0;
  flex: 1;
  align-items: flex-start;
  flex-direction: column;
}

.work-summary__title-row {
  display: flex;
  box-sizing: border-box;
  max-width: calc(100% - 72rpx);
  min-width: 0;
  align-items: center;
  gap: 6px;
  color: var(--color-text);
  font-size: 32rpx;
  font-weight: 600;
  line-height: 44rpx;
  cursor: pointer;
}

.work-summary__title-row--disabled {
  opacity: 0.58;
  cursor: not-allowed;
}

.work-summary__title {
  min-width: 0;
  overflow: hidden;
  flex: 0 1 auto;
  text-align: left;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.work-summary__edit-btn {
  display: flex;
  box-sizing: border-box;
  width: 24px;
  height: 24px;
  flex: 0 0 24px;
  align-items: center;
  justify-content: center;
  padding: 0;
  border: 0;
  border-radius: 6px;
  background: transparent;
  transition: background-color 150ms ease;
}

.work-summary__edit-btn--hover,
.work-summary__edit-btn:hover,
.work-summary__edit-btn:active {
  background: rgba(0, 0, 0, 0.06);
}

.work-summary__edit-icon {
  width: 14px;
  height: 14px;
  flex: 0 0 14px;
}

.work-summary__meta,
.work-summary__count {
  width: 100%;
  margin-top: 8rpx;
  color: var(--color-text);
  font-size: 28rpx;
  font-weight: 400;
  line-height: 44rpx;
}

.work-summary__meta {
  margin-top: 12rpx;
}

.work-summary__count {
  font-weight: 500;
}

.work-summary__date {
  width: 100%;
  overflow: hidden;
  margin-top: var(--space-1);
  color: var(--color-text-tertiary);
  font-size: 24rpx;
  font-weight: 400;
  line-height: 36rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.favorite {
  position: absolute;
  box-sizing: border-box;
  min-width: 0;
  top: var(--card-padding-compact);
  right: var(--card-padding-compact);
  display: flex;
  width: 64rpx;
  height: 64rpx;
  align-items: center;
  justify-content: center;
  padding: 0;
  border: 0;
  border-radius: 50%;
  background: transparent;
  color: var(--color-text-secondary);
  line-height: 1;
  transition: transform 150ms ease, opacity 150ms ease, color 150ms ease;
}

.favorite--active {
  color: var(--color-primary);
}

.favorite--pressed,
.favorite:active {
  opacity: 0.62;
  transform: scale(0.97);
}

.favorite--updating {
  pointer-events: none;
}

.favorite__heart {
  font-size: 32rpx;
  line-height: 1;
}

@media (max-width: 340px) {
  .work-summary {
    gap: var(--space-2);
  }
}
