@import "../../styles/profile-pages.wxss";

.payment-success { box-sizing: border-box; max-width: 680rpx; min-height: 960rpx; margin: 0 auto; padding: 80rpx var(--page-padding) 40rpx; text-align: center; }
.success-mark { position: relative; display: flex; width: 184rpx; height: 184rpx; align-items: center; justify-content: center; margin: 0 auto; border: 18rpx solid var(--color-success-soft); border-radius: 50%; background: var(--color-primary-surface); box-shadow: var(--shadow-primary); }
.success-mark view { display: flex; width: 142rpx; height: 142rpx; align-items: center; justify-content: center; border-radius: 50%; background: linear-gradient(145deg, var(--color-primary-gradient-end), var(--color-primary)); color: #fff; font-size: 88rpx; font-weight: 300; }
.payment-success__title { margin-top: 54rpx; font-size: 36rpx; font-weight: 600; }
.payment-detail { margin-top: 64rpx; padding: 0 32rpx; text-align: left; }
.payment-detail > view { display: flex; height: 94rpx; align-items: center; justify-content: space-between; border-bottom: 1rpx solid var(--color-border); color: var(--color-text-secondary); font-size: 26rpx; }
.payment-detail > view:last-child { border-bottom: 0; }
.payment-detail > view > text:last-child { color: var(--color-text); font-size: 28rpx; font-weight: 600; }
.payment-detail > view > .payment-detail__green { color: var(--color-primary); }
.payment-detail > view > .payment-detail__quota { color: var(--color-primary); font-size: 42rpx; }
.payment-detail__quota text { font-size: 24rpx; }
.success-actions { display: grid; gap: 20rpx; margin: 84rpx 48rpx 0; }
.success-actions__secondary { display: flex; height: 88rpx; align-items: center; justify-content: center; border: 0; border-radius: var(--radius-card-small); background: transparent; box-shadow: var(--shadow-ghost); color: var(--color-primary); font-size: 28rpx; line-height: 1; transition: var(--transition-press); }
.success-actions__secondary:active { background: var(--strong-overlay); transform: scale(0.97); }
