<page-layout title="获取下载次数" back showMainNav selectedTab="2">
  <view class="subpage recharge-page">
    <view class="recharge-hero">
      <image src="/assets/icons/bead-stack.svg" mode="aspectFit" />
      <view class="recharge-hero__title">获取下载次数</view>
      <view class="recharge-hero__quota">今日剩余 <text>{{quota}}</text> 次</view>
    </view>

    <view class="recharge-options">
      <view class="recharge-option {{selected === index ? 'recharge-option--active' : ''}}" wx:for="{{packages}}" wx:key="id" data-index="{{index}}" bindtap="selectPackage">
        <image src="/assets/icons/bead-stack.svg" mode="aspectFit" />
        <view class="recharge-option__label">{{item.label}}</view>
        <view class="recharge-option__price">¥ {{item.price}}</view>
        <view class="recharge-option__check">{{selected === index ? '✓' : ''}}</view>
      </view>
    </view>

    <view class="payment-method ui-card"><text>支付方式</text><view><text>●</text> 微信支付　›</view></view>
    <button class="button-primary recharge-button" style="width: 100%;" bindtap="purchase">立即支付</button>
    <view class="recharge-notes"><view>支付即表示同意《付费服务协议》</view><view>支付能力接入前不会产生任何费用</view></view>
  </view>
</page-layout>
