@import "../../styles/profile-pages.wxss";

.privacy-document-page { padding-top: 24rpx; }
.privacy-document-state { padding: 160rpx 32rpx; color: var(--color-text-tertiary); font-size: 26rpx; line-height: 42rpx; text-align: center; }
.privacy-document-state--error { color: var(--color-danger); }
.privacy-document-retry { width: 180rpx; height: 68rpx; margin: 24rpx auto 0; border: 2rpx solid var(--color-primary); border-radius: var(--radius-control); color: var(--color-primary); line-height: 68rpx; transition: var(--transition-press); }
.privacy-document-retry:active { background: var(--strong-overlay); opacity: 0.72; transform: scale(0.97); }
.privacy-document-content {
  overflow: hidden;
  padding: 36rpx 32rpx 56rpx;
}

.privacy-document-meta {
  margin-bottom: 32rpx;
  color: var(--color-text-tertiary);
  font-size: 23rpx;
  line-height: 36rpx;
  letter-spacing: 0.3rpx;
}

/* rich-text 子节点不会自动继承页面的段落间距，需要在本页显式建立阅读节奏 */
.privacy-document-content rich-text {
  display: block;
  color: var(--color-text);
  font-size: 29rpx;
  line-height: 52rpx;
  letter-spacing: 0.3rpx;
}

.privacy-document-content rich-text p {
  margin: 0 0 24rpx;
  color: var(--color-text);
  font-size: 29rpx;
  line-height: 52rpx;
  letter-spacing: 0.3rpx;
}

.privacy-document-content rich-text p:first-child {
  margin-bottom: 12rpx;
}

.privacy-document-content rich-text p:first-child strong {
  color: var(--color-text);
  font-family: var(--font-heading);
  font-size: 36rpx;
  font-weight: 650;
  line-height: 48rpx;
  letter-spacing: 0.6rpx;
}

.privacy-document-content rich-text p:nth-child(2) {
  margin-bottom: 36rpx;
  padding: 20rpx 24rpx;
  border-radius: var(--radius-card-small);
  background: var(--color-surface-muted);
  color: var(--color-text-secondary);
  font-size: 25rpx;
  line-height: 40rpx;
  letter-spacing: 0.2rpx;
}

.privacy-document-content rich-text h2 {
  box-sizing: border-box;
  margin: 40rpx 0 16rpx;
  padding-left: 20rpx;
  border-left: 6rpx solid var(--color-primary);
  color: var(--color-text);
  font-family: var(--font-heading);
  font-size: 36rpx;
  font-weight: 650;
  line-height: 48rpx;
  letter-spacing: 0.6rpx;
}

.privacy-document-content rich-text p:last-child {
  margin-bottom: 0;
}
