@import "../../styles/profile-pages.wxss";

.account-page {
  padding-top: 20rpx;
  padding-bottom: calc(64rpx + env(safe-area-inset-bottom));
}

/* ── 账号信息卡 ── */
.account-card {
  position: relative;
  display: flex;
  align-items: center;
  box-sizing: border-box;
  padding: 28rpx;
  border-radius: var(--radius-card-large);
  background: var(--color-primary-soft);
  border: 1rpx solid #D5F3E4;
  box-shadow: 0 4rpx 16rpx rgba(18, 180, 102, 0.05);
  overflow: hidden;
}

.account-card__avatar {
  width: 116rpx;
  height: 116rpx;
  flex-shrink: 0;
  border-radius: 32rpx;
  background: #DFF8EB;
  border: 3rpx solid #FFFFFF;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.account-card__content {
  min-width: 0;
  flex: 1;
  margin-left: 24rpx;
}

.account-card__name-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.account-card__name {
  max-width: 280rpx;
  font-size: 34rpx;
  font-weight: 600;
  line-height: 46rpx;
  color: var(--color-text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.account-card__badge {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(18, 180, 102, 0.14);
  color: #0C8248;
  font-size: 22rpx;
  font-weight: 500;
  line-height: 32rpx;
  flex-shrink: 0;
}

.account-card__badge-check {
  font-size: 20rpx;
  font-weight: 700;
}

.account-card__desc {
  display: block;
  margin-top: 8rpx;
  font-size: 25rpx;
  line-height: 36rpx;
  color: var(--color-text-secondary);
}

/* 拼豆微型爱心装饰点阵 */
.account-card__bead-decor {
  position: absolute;
  right: 28rpx;
  top: 50%;
  transform: translateY(-50%);
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4rpx;
  opacity: 0.26;
  pointer-events: none;
}

.bead-row {
  display: flex;
  gap: 4rpx;
}

.bead-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 3rpx;
  background: var(--color-primary);
}

.bead-space {
  width: 10rpx;
  height: 10rpx;
}

/* ── 分组标题 ── */
.account-section-title {
  margin-top: 36rpx;
  margin-bottom: 14rpx;
  padding-left: 8rpx;
  font-size: 28rpx;
  font-weight: 500;
  color: #737785;
  line-height: 40rpx;
}

/* ── 列表卡片容器 ── */
.account-group {
  overflow: hidden;
  border-radius: var(--radius-card-large);
  background: var(--color-surface);
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.03);
}

.account-item {
  display: flex;
  height: 116rpx;
  align-items: center;
  padding: 0 32rpx;
  border-bottom: 1rpx solid #F0F1F5;
  transition: var(--transition-press);
}

.account-item--last {
  border-bottom: 0;
}

.account-item:active {
  background-color: #F8F9FA;
}

.account-item--disabled {
  opacity: 0.6;
  pointer-events: none;
}

.account-item__icon {
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
  margin-right: 22rpx;
}

.account-item__icon--avatar {
  border-radius: 10rpx;
}

.account-item__icon--spin {
  animation: spin 1s linear infinite;
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.account-item__title {
  flex: 1;
  font-size: 30rpx;
  color: var(--color-text);
}

.account-item__title--danger {
  color: var(--color-danger);
  font-weight: 500;
}

.account-item__arrow {
  color: #A5A9B4;
  font-size: 44rpx;
  font-weight: 300;
  line-height: 1;
}

.account-item__arrow--danger {
  color: rgba(229, 72, 77, 0.45);
}

.account-item--danger:active {
  background-color: #FFF5F5;
}
