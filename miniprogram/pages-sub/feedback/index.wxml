<page-layout title="意见反馈" back showMainNav selectedTab="2">
  <view class="subpage feedback-page">
    <view class="feedback-hero">
      <view class="feedback-hero__icon">◖</view>
      <view><view>感谢你的反馈</view><text>你可以提交产品建议或问题反馈，帮助我们做得更好。</text></view>
    </view>

    <view class="feedback-label">反馈类型</view>
    <view class="category-grid">
      <view
        class="category-item {{categoryIndex === index ? 'category-item--active' : ''}}"
        wx:for="{{categories}}"
        wx:key="id"
        data-index="{{index}}"
        bindtap="selectCategory"
      ><text>{{item.symbol}}</text>{{item.label}}</view>
    </view>

    <view class="feedback-field-head"><view class="feedback-label">问题描述</view><text>{{content.length}}/500</text></view>
    <textarea class="feedback-textarea" maxlength="500" placeholder="请详细描述你遇到的问题或建议" placeholder-class="feedback-placeholder" value="{{content}}" bindinput="changeContent" />

    <view class="feedback-field-head"><view class="feedback-label">上传截图 <text>（选填，最多 5 张）</text></view><text>{{images.length}}/5</text></view>
    <view class="image-list">
      <view class="image-item" wx:for="{{images}}" wx:key="*this">
        <image src="{{item}}" mode="aspectFill" data-src="{{item}}" bindtap="previewImage" />
        <view class="image-item__remove" data-index="{{index}}" catchtap="removeImage">×</view>
      </view>
      <view wx:if="{{images.length < 5}}" class="image-upload" bindtap="chooseImages"><view>＋</view><text>上传图片</text></view>
    </view>

    <view class="feedback-label contact-label">联系方式 <text>（选填）</text></view>
    <input class="feedback-input" placeholder="请输入手机号或邮箱，方便我们联系你" placeholder-class="feedback-placeholder" value="{{contact}}" bindinput="changeContact" />

    <button class="button-primary feedback-submit" style="width: 100%;" disabled="{{submitting}}" bindtap="submit">{{submitting ? '提交中…' : '提交反馈'}}</button>
    <view class="feedback-safe">♢　我们会尽快处理你的反馈</view>
  </view>
</page-layout>
