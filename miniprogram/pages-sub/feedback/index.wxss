@import "../../styles/profile-pages.wxss";

.feedback-hero { display: flex; align-items: center; padding: 28rpx 32rpx; border: 1rpx solid rgba(18, 180, 102, 0.18); border-radius: var(--radius-card); background: linear-gradient(135deg, #f2fff8, #fbfffd); }
.feedback-hero__icon { display: flex; width: 84rpx; height: 84rpx; flex-shrink: 0; align-items: center; justify-content: center; color: var(--color-primary); font-size: 64rpx; transform: rotate(-25deg); }
.feedback-hero > view:last-child { margin-left: 24rpx; }
.feedback-hero view view { font-size: 30rpx; font-weight: 600; }
.feedback-hero text { display: block; margin-top: 8rpx; color: var(--color-text-secondary); font-size: 24rpx; line-height: 36rpx; }

.feedback-label { margin: 36rpx 0 16rpx; font-size: 29rpx; font-weight: 600; }
.feedback-label text { color: var(--color-text-secondary); font-size: 23rpx; font-weight: 400; }
.category-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16rpx; }
.category-item { display: flex; min-width: 0; height: 76rpx; align-items: center; justify-content: center; gap: 10rpx; border: 1rpx solid var(--color-border); border-radius: var(--radius-control); background: #fff; color: var(--color-text-secondary); font-size: 24rpx; white-space: nowrap; }
.category-item text { font-size: 28rpx; }
.category-item--active { border: 2rpx solid var(--color-primary); color: var(--color-primary); font-weight: 600; }

.feedback-field-head { display: flex; align-items: center; justify-content: space-between; }
.feedback-field-head > text { margin-top: 20rpx; color: var(--color-text-secondary); font-size: 23rpx; }
.feedback-textarea, .feedback-input { box-sizing: border-box; width: 100%; border: 1rpx solid var(--color-border); border-radius: var(--radius-control); background: #fff; font-size: 26rpx; }
.feedback-textarea { height: 260rpx; padding: 24rpx; line-height: 40rpx; }
.feedback-input { height: 88rpx; padding: 0 24rpx; }
.feedback-placeholder { color: var(--color-text-tertiary); }

.image-list { display: flex; flex-wrap: wrap; gap: 20rpx; }
.image-item, .image-upload { position: relative; box-sizing: border-box; width: 148rpx; height: 148rpx; border-radius: var(--radius-media); }
.image-item image { width: 100%; height: 100%; border-radius: var(--radius-media); }
.image-item__remove { position: absolute; top: -12rpx; right: -12rpx; display: flex; width: 36rpx; height: 36rpx; align-items: center; justify-content: center; border: 4rpx solid #fff; border-radius: 50%; background: var(--color-text-secondary); color: #fff; font-size: 28rpx; line-height: 1; }
.image-upload { display: flex; flex-direction: column; align-items: center; justify-content: center; border: 2rpx dashed var(--color-disabled); color: var(--color-text-secondary); }
.image-upload view { font-size: 48rpx; font-weight: 300; }
.image-upload text { margin-top: 6rpx; font-size: 22rpx; }
.contact-label { margin-top: 36rpx; }
.feedback-submit { width: calc(100vw - 80rpx); margin-top: 32rpx; }
.feedback-safe { padding: 24rpx 0 8rpx; color: var(--color-text-tertiary); font-size: 22rpx; text-align: center; }

@media (max-width: 380px) {
  .category-grid { grid-template-columns: repeat(2, 1fr); }
}
