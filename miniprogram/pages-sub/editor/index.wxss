page {
  --color-primary: #12b466;
  --color-primary-pressed: #0f9f5b;
  --color-primary-soft: #ecfaf3;
  --color-bg: #ffffff;
  --color-surface: #ffffff;
  --color-surface-muted: #fafafa;
  --color-text: #111111;
  --color-text-secondary: #666666;
  --color-text-tertiary: #999999;
  --color-border: #eeeeee;
  /* 工具选中态 */
  --tool-active-bg: #F1ECFF;
  --tool-active-accent: #6F5BFF;
  --tool-active-border: #7C5CFF;
  overflow: hidden;
  background: var(--color-bg);
}

@media (prefers-color-scheme: dark) {
  page {
    --color-primary: #39d98a;
    --color-primary-pressed: #25bc73;
    --color-primary-soft: #153827;
    --color-bg: #101419;
    --color-surface: #1a2028;
    --color-surface-muted: #232b35;
    --color-text: #f3f6fa;
    --color-text-secondary: #b4bfcc;
    --color-text-tertiary: #91a0ae;
    --color-border: #35414d;
    --tool-active-bg: #2d2450;
    --tool-active-accent: #b09cff;
    --tool-active-border: #927cff;
  }
}

.editor {
  display: flex;
  height: 100vh;
  flex-direction: column;
  background: var(--color-bg);
  color: var(--color-text);
}

.editor__body {
  min-height: 0;
  flex: 1;
  overflow: hidden;
}

.editor__content {
  display: flex;
  box-sizing: border-box;
  height: 100%;
  min-height: 0;
  flex-direction: column;
  padding: 16rpx 16rpx calc(40rpx + env(safe-area-inset-bottom));
}


/* ─── 工作区（画布容器）────────────────────────────────────────── */

.workspace {
  flex: 1 1 0;
  min-height: 0;
  position: relative;
  overflow: hidden;
  border: 1rpx solid var(--color-border);
  border-radius: 12rpx;
  background: #f7f7f7;
}

.canvas-stage {
  position: absolute;
  inset: 0;
  overflow: hidden;
}

.pattern-canvas {
  display: block;
  width: 100%;
  height: 100%;
  background: #f7f7f7;
}

/* ─── 缩放控制 ───────────────────────────────────────────────── */

.zoom-control {
  display: flex;
  flex-shrink: 0;
  height: 60rpx;
  align-items: center;
  justify-content: center;
  gap: 48rpx;
  margin-top: 24rpx;
}

.zoom-control__button {
  display: flex;
  box-sizing: border-box;
  width: 60rpx;
  min-width: 60rpx;
  max-width: 60rpx;
  height: 60rpx;
  flex: 0 0 60rpx;
  align-items: center;
  justify-content: center;
  padding: 0;
  border: 0;
  border-radius: var(--radius-card-small);
  background: transparent;
  color: var(--color-text);
  font-size: 36rpx;
  font-weight: 300;
  line-height: 1;
  box-shadow: var(--shadow-ghost);
  transition: var(--transition-press);
}

.zoom-control__button[disabled] {
  opacity: 0.32;
}

.zoom-control__button:active {
  background: var(--strong-overlay);
  transform: scale(0.97);
}

.zoom-control__value {
  min-width: 88rpx;
  color: var(--color-text);
  font-size: 28rpx;
  font-weight: 400;
  line-height: 44rpx;
  text-align: center;
}

/* ─── 信息卡 ─────────────────────────────────────────────────── */

.info-card {
  display: flex;
  flex-shrink: 0;
  box-sizing: border-box;
  min-height: 136rpx;
  flex-direction: column;
  justify-content: center;
  margin-top: 24rpx;
  padding: 20rpx 28rpx;
  border: 0;
  border-radius: var(--radius-card-small);
  background: var(--color-surface-muted);
  color: var(--color-text);
  font-size: 28rpx;
  line-height: 44rpx;
  box-shadow: var(--shadow-card);
}

.info-card__row {
  display: flex;
  gap: 48rpx;
}

.info-card__count {
  margin-top: 4rpx;
}


/* ─── 工具栏 ─────────────────────────────────────────────────── */

.tools {
  display: flex;
  flex-shrink: 0;
  height: 96rpx;
  margin: 32rpx 16rpx 0;
  gap: 8rpx;
}

.tool {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: var(--color-text);
  border-radius: 14rpx;
  border: 1.5rpx solid transparent;
  transition: background 0.15s ease, border-color 0.15s ease;
}

.tool--disabled {
  opacity: 0.34;
}

.tool__icon {
  width: 40rpx;
  height: 40rpx;
}

.tool__label {
  margin-top: 4rpx;
  font-size: 24rpx;
  font-weight: 500;
  line-height: 36rpx;
  color: var(--color-text-secondary);
}

/* ── 选中态 ── */
.tool--active {
  background: var(--tool-active-bg);
  border-color: var(--tool-active-border);
}

.tool--active .tool__label {
  color: var(--tool-active-accent);
  font-weight: 600;
}


/* ─── 调色板 ─────────────────────────────────────────────────── */

.palette {
  display: flex;
  flex-shrink: 0;
  flex-wrap: wrap;
  row-gap: 16rpx;
  margin: 24rpx 16rpx 0;
}

.palette__slot {
  display: flex;
  width: 12.5%;
  height: 44rpx;
  align-items: center;
  justify-content: center;
}

.palette__color {
  position: relative;
  display: flex;
  box-sizing: border-box;
  width: 44rpx;
  min-width: 44rpx;
  max-width: 44rpx;
  height: 44rpx;
  flex: 0 0 44rpx;
  align-items: center;
  justify-content: center;
  padding: 0;
  border: 1rpx solid rgba(17, 17, 17, 0.08);
  border-radius: 999rpx;
  overflow: hidden;
  line-height: 44rpx;
}

.palette__color--selected {
  border: 2rpx solid var(--color-primary);
  box-shadow: 0 0 0 2rpx #ffffff inset;
}

.palette__check {
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1;
  text-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.28);
}


/* ─── 底部操作 ───────────────────────────────────────────────── */

.editor-actions {
  display: flex;
  flex-shrink: 0;
  gap: 24rpx;
  margin: 32rpx 16rpx 0;
}

.editor-actions__button {
  box-sizing: border-box;
  height: 80rpx;
  min-width: 0;
  flex: 1;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 40rpx;
}

.editor-actions .button-secondary {
  border: 0;
  background: transparent;
  color: var(--color-primary);
  box-shadow: var(--shadow-ghost);
}

.editor-actions .button-primary {
  border: 0;
  background: var(--color-primary);
  color: #ffffff;
  box-shadow: var(--shadow-primary);
}

.editor-actions .button-secondary:active {
  background: var(--color-primary-soft);
}

.editor-actions .button-primary:active {
  background: var(--color-primary-pressed);
  transform: scale(0.97);
}


.export-pattern-canvas {
  position: fixed;
  top: 0;
  left: -10000px;
  pointer-events: none;
}


/* ─── 取色 Toast ──────────────────────────────────────────────── */

.editor-toast {
  position: fixed;
  bottom: calc(180rpx + env(safe-area-inset-bottom));
  left: 50%;
  transform: translateX(-50%) translateY(16rpx);
  z-index: 1000;
  padding: 12rpx 32rpx;
  border-radius: 999rpx;
  background: rgba(30, 30, 30, 0.82);
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 500;
  line-height: 40rpx;
  white-space: nowrap;
  opacity: 0;
  pointer-events: none;
  transition:
    opacity 0.22s ease,
    transform 0.22s ease;
}

.editor-toast--visible {
  opacity: 1;
  transform: translateX(-50%) translateY(0);
}
