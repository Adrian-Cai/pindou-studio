:host {
  display: block;
  width: 100%;
}

.quota-strip {
  position: relative;
  display: flex;
  box-sizing: border-box;
  width: 100%;
  min-width: 0;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 24rpx;
  padding: 24rpx 28rpx;
  border: 0;
  border-radius: var(--radius-card-large);
  background: var(--color-surface);
  box-shadow: var(--shadow-card);
  color: var(--color-text-secondary);
  font-size: 22rpx;
}

.quota-strip__remaining,
.quota-strip__link {
  display: flex;
  min-width: 0;
  align-items: center;
  white-space: nowrap;
}

.quota-strip__remaining {
  flex: 1 1 auto;
  gap: 8rpx;
}

.quota-strip__label {
  min-width: 0;
}

.quota-strip__value,
.quota-strip__link {
  color: var(--color-primary);
  font-weight: 500;
}

.quota-strip__help {
  display: flex;
  box-sizing: border-box;
  width: 36rpx;
  height: 36rpx;
  flex: 0 0 36rpx;
  align-items: center;
  justify-content: center;
  border: 2rpx solid var(--color-text-tertiary);
  border-radius: 50%;
  color: var(--color-text-secondary);
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1;
}

.quota-strip__link {
  flex: 0 0 auto;
  gap: 6rpx;
}

.quota-strip__arrow {
  font-size: 30rpx;
  line-height: 1;
}

.quota-tips {
  position: absolute;
  z-index: 30;
  bottom: calc(100% + 18rpx);
  left: 16rpx;
  box-sizing: border-box;
  width: calc(100% - 32rpx);
  max-width: 600rpx;
  padding: 30rpx 32rpx 24rpx;
  border: 0;
  border-radius: var(--radius-card-small);
  background: var(--surface);
  box-shadow: var(--shadow-card);
  color: var(--color-text-secondary);
}

.quota-tips__arrow {
  position: absolute;
  bottom: -11rpx;
  left: 252rpx;
  width: 20rpx;
  height: 20rpx;
  border-right: 1rpx solid var(--color-border);
  border-bottom: 1rpx solid var(--color-border);
  background: var(--color-surface);
  transform: rotate(45deg);
}

.quota-tips__title {
  color: var(--color-text);
  font-size: 28rpx;
  font-weight: 600;
  line-height: 40rpx;
}

.quota-tips__list {
  display: grid;
  gap: 10rpx;
  margin-top: 18rpx;
  font-size: 23rpx;
  line-height: 34rpx;
}

.quota-tips__emphasis {
  margin-top: 18rpx;
  padding: 14rpx 16rpx;
  border-radius: 12rpx;
  background: var(--color-primary-soft);
  color: var(--color-text);
  font-size: 22rpx;
  line-height: 34rpx;
}

.quota-tips__close {
  margin-top: 18rpx;
  color: var(--color-primary);
  font-size: 25rpx;
  font-weight: 600;
  line-height: 40rpx;
  text-align: right;
}

@media (max-width: 340px) {
  .quota-strip {
    gap: 8rpx;
    padding-right: 18rpx;
    padding-left: 18rpx;
    font-size: 20rpx;
  }

  .quota-strip__remaining {
    gap: 5rpx;
  }

  .quota-strip__help {
    width: 32rpx;
    height: 32rpx;
    flex-basis: 32rpx;
    font-size: 19rpx;
  }

  .quota-strip__link {
    gap: 2rpx;
    font-size: 20rpx;
  }

  .quota-tips {
    left: 10rpx;
    width: calc(100% - 20rpx);
    padding-right: 26rpx;
    padding-left: 26rpx;
  }

  .quota-tips__arrow {
    left: 240rpx;
  }
}
