APP_ENV=development
HOST=127.0.0.1
PORT=4000

# PostgreSQL 连接配置不要把真实用户名或密码提交到仓库
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=pindou
DB_USER=replace_me
DB_PASSWORD=replace_me
DB_SCHEMA=public
DB_SSL_MODE=disable
DB_CONNECT_TIMEOUT_MS=10000
DB_POOL_MAX=5

# 微信小程序登录配置AppSecret 只能保存在服务端环境变量中
WECHAT_APP_ID=wx78d89d6e64966b18
WECHAT_APP_SECRET=replace_me
WECHAT_API_TIMEOUT_MS=8000

# 微信支付 v3 配置全部保持注释时支付接口安全禁用；启用时必须全部配置
# WECHAT_PAY_MERCHANT_ID=replace_me
# WECHAT_PAY_MERCHANT_SERIAL_NUMBER=replace_me
# WECHAT_PAY_MERCHANT_PRIVATE_KEY_PATH=./secrets/apiclient_key.pem
# WECHAT_PAY_API_V3_KEY=replace_with_exactly_32_bytes
# WECHAT_PAY_PLATFORM_SERIAL_NUMBER=replace_me
# WECHAT_PAY_PLATFORM_PUBLIC_KEY_PATH=./secrets/wechatpay_public_key.pem
# WECHAT_PAY_NOTIFY_URL=https://api.example.com/api/payments/notify
# WECHAT_PAY_TIMEOUT_MS=8000
# WECHAT_PAY_CALLBACK_TOLERANCE_SECONDS=300

# 使用至少 32 个随机字符，例如：openssl rand -base64 48
OPENID_HASH_SECRET=replace_with_a_random_secret_at_least_32_chars
AUTH_TOKEN_TTL_DAYS=30
STANDARD_DOWNLOAD_DAILY_FREE=9
AI_GENERATION_DAILY_FREE=3

# 用户头像本地存储生产环境应挂载持久化磁盘，或替换为对象存储实现
AVATAR_STORAGE_DIR=./data/avatars
AVATAR_MAX_BYTES=2097152

# 作品封面本地存储开发替身
COVER_STORAGE_DIR=./data/covers
COVER_PUBLIC_BASE_URL=http://127.0.0.1:4000/api/media/covers
COVER_MAX_BYTES=10485760

# AI 输入/输出图片本地存储开发替身
AI_FILE_STORAGE_DIR=./data/ai
AI_FILE_PUBLIC_BASE_URL=http://127.0.0.1:4000/api/media/ai
AI_FILE_MAX_BYTES=10485760
AI_IMAGE_MAX_WIDTH=4096
AI_IMAGE_MAX_HEIGHT=4096
AI_IMAGE_MAX_PIXELS=16777216
# AI 输入和输出文件保留时间；到期后服务端软删资产并删除物理文件
AI_FILE_RETENTION_HOURS=24
AI_RATE_LIMIT_MAX_REQUESTS=5
AI_RATE_LIMIT_WINDOW_MS=600000
AI_QUEUE_MAX_CONCURRENT=5
AI_QUEUE_MAX_QUEUED=50
AI_PROVIDER_RPM=20

# 仅在头像、封面和 AI 文件目录都已挂载到生产持久卷并完成恢复演练后设为 true
PERSISTENT_STORAGE_MOUNTED=false

# 仅在 /health 探测、支付失败和 AI 失败告警都已接入并完成一次告警演练后设为 true
MONITORING_ALERTS_CONFIGURED=false

# 千问图像 3.0两项都不配置时安全禁用；生产环境填写同地域业务空间域名和 API Key
# QWEN_IMAGE_API_KEY=replace_me
# QWEN_IMAGE_BASE_URL=https://<workspace-id>.cn-beijing.maas.aliyuncs.com
# QWEN_IMAGE_MODEL=qwen-image-3.0
# QWEN_IMAGE_TIMEOUT_MS=30000
# QWEN_IMAGE_MAX_OUTPUT_BYTES=10485760

# 微信内容安全生产环境必须配置消息推送校验 Token 和可被微信下载的 HTTPS 图片地址
WECHAT_CONTENT_SECURITY_TOKEN=replace_me
CONTENT_SECURITY_MEDIA_STORAGE_DIR=./data/content-security
CONTENT_SECURITY_MEDIA_PUBLIC_BASE_URL=http://127.0.0.1:4000/api/content-security/media
CONTENT_SECURITY_MEDIA_MAX_BYTES=10485760
CONTENT_SECURITY_ASYNC_MEDIA_CHECK_ENABLED=false
