{
  "name": "@pindou-studio/server",
  "version": "0.15.0",
  "private": true,
  "description": "拼豆工作室后端服务",
  "main": "dist/index.js",
  "type": "commonjs",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
